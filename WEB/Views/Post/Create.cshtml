<!-- Thêm Flatpickr cho calendar -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<script>
    // ========== IMAGE UPLOAD ==========
    const imageUploadArea = document.getElementById('imageUploadArea');
    const imageUpload = document.getElementById('imageUpload');
    const imagePreviewGrid = document.getElementById('imagePreviewGrid');
    const uploadPlaceholder = document.getElementById('uploadPlaceholder');
    const imageUrlInput = document.getElementById('imageUrlInput');
    let uploadedImages = [];

    // Click to upload
    imageUploadArea.addEventListener('click', () => {
        imageUpload.click();
    });

    // Drag and drop
    imageUploadArea.addEventListener('dragover', (e) => {
        e.preventDefault();
        imageUploadArea.classList.add('dragover');
    });

    imageUploadArea.addEventListener('dragleave', () => {
        imageUploadArea.classList.remove('dragover');
    });

    imageUploadArea.addEventListener('drop', (e) => {
        e.preventDefault();
        imageUploadArea.classList.remove('dragover');
        const files = e.dataTransfer.files;
        handleFiles(files);
    });

    // File input change
    imageUpload.addEventListener('change', (e) => {
        handleFiles(e.target.files);
    });

    function handleFiles(files) {
        if (uploadedImages.length + files.length > 5) {
            alert('Bạn chỉ có thể upload tối đa 5 ảnh!');
            return;
        }

        Array.from(files).forEach(file => {
            if (!file.type.startsWith('image/')) {
                alert('Chỉ chấp nhận file ảnh!');
                return;
            }

            if (file.size > 5 * 1024 * 1024) {
                alert('Kích thước ảnh không được vượt quá 5MB!');
                return;
            }

            const reader = new FileReader();
            reader.onload = (e) => {
                const imageData = e.target.result;
                uploadedImages.push(imageData);
                renderImagePreviews();
                
                // Lưu ảnh đầu tiên vào ImageUrl (tạm thời dùng base64)
                if (uploadedImages.length === 1) {
                    imageUrlInput.value = imageData;
                }
                document.getElementById('productImagesInput').value = JSON.stringify(uploadedImages);
            };
            reader.readAsDataURL(file);
        });
    }

    function renderImagePreviews() {
        imagePreviewGrid.innerHTML = '';
        
        uploadedImages.forEach((imageData, index) => {
            const previewItem = document.createElement('div');
            previewItem.className = 'image-preview-item';
            previewItem.innerHTML = `
                <img src="${imageData}" alt="Preview ${index + 1}" />
                <button type="button" class="image-remove-btn" onclick="removeImage(${index})">
                    <i class="fas fa-times"></i>
                </button>
            `;
            imagePreviewGrid.appendChild(previewItem);
        });

        // Ẩn/hiện placeholder
        if (uploadedImages.length > 0) {
            uploadPlaceholder.style.display = 'none';
        } else {
            uploadPlaceholder.style.display = 'block';
        }
    }

    function removeImage(index) {
        uploadedImages.splice(index, 1);
        renderImagePreviews();
        
        // Cập nhật ImageUrl
        if (uploadedImages.length > 0) {
            imageUrlInput.value = uploadedImages[0];
        } else {
            imageUrlInput.value = '';
        }
        document.getElementById('productImagesInput').value = JSON.stringify(uploadedImages);
    }

    // ========== CALENDAR FOR UNAVAILABLE DATES ==========
    let selectedDates = [];
    
    const calendar = flatpickr("#calendar", {
        inline: true,
        mode: "multiple",
        dateFormat: "Y-m-d",
        minDate: "today",
        onChange: function(selectedDatesArray, dateStr, instance) {
            selectedDates = selectedDatesArray.map(date => {
                const year = date.getFullYear();
                const month = String(date.getMonth() + 1).padStart(2, '0');
                const day = String(date.getDate()).padStart(2, '0');
                return `${year}-${month}-${day}`;
            });
            
            updateSelectedDatesList();
            updateUnavailableDatesInput();
        }
    });

    function updateSelectedDatesList() {
        const listContainer = document.getElementById('selectedDatesList');
        
        if (selectedDates.length === 0) {
            listContainer.innerHTML = '<p style="color: #94a3b8; font-size: 0.875rem;">Chưa chọn ngày nào</p>';
            return;
        }

        listContainer.innerHTML = selectedDates.map(date => `
            <div class="selected-date-tag">
                <i class="fas fa-calendar-times"></i>
                ${formatDate(date)}
                <button type="button" onclick="removeDate('${date}')">×</button>
            </div>
        `).join('');
    }

    function removeDate(dateStr) {
        selectedDates = selectedDates.filter(d => d !== dateStr);
        
        // Cập nhật calendar
        const dateObj = new Date(dateStr);
        calendar.setDate(selectedDates.map(d => new Date(d)), false);
        
        updateSelectedDatesList();
        updateUnavailableDatesInput();
    }

    function updateUnavailableDatesInput() {
        document.getElementById('unavailableDatesInput').value = JSON.stringify(selectedDates);
    }

    function formatDate(dateStr) {
        const date = new Date(dateStr);
        const day = String(date.getDate()).padStart(2, '0');
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const year = date.getFullYear();
        return `${day}/${month}/${year}`;
    }

    // Initialize
    updateSelectedDatesList();
</script>

@{
    ViewData["Title"] = "Đăng Tin Cho Thuê";
    var categories = ViewBag.Categories as List<WEB.Models.CategoryViewModel> ?? new List<WEB.Models.CategoryViewModel>();
}

<div class="post-create-container">
    <div class="post-sidebar">
        <div class="sidebar-header">
            <h3>Lender Portal</h3>
            <p>Quản lý cửa hàng của bạn</p>
        </div>
        
        <nav class="sidebar-nav">
            <a href="/?mode=owner" class="sidebar-nav-item">
                <i class="fas fa-th-large"></i>
                <span>Tổng quan</span>
            </a>
            <a href="/Post/Create" class="sidebar-nav-item active">
                <i class="fas fa-plus-circle"></i>
                <span>Đăng bài</span>
            </a>
            <a href="/?mode=owner" class="sidebar-nav-item">
                <i class="fas fa-wrench"></i>
                <span>Thiết bị của tôi</span>
            </a>
            <a href="#" class="sidebar-nav-item">
                <i class="fas fa-envelope"></i>
                <span>Tin nhắn</span>
            </a>
        </nav>

        <div class="sidebar-user">
            <img src="https://ui-avatars.com/api/?name=@(ViewBag.UserName ?? "User")&background=2563eb&color=fff" alt="User" class="sidebar-user-avatar" />
            <div class="sidebar-user-info">
                <div class="sidebar-user-name">@(ViewBag.UserName ?? "User")</div>
                <div class="sidebar-user-role">UTE Student</div>
            </div>
        </div>
    </div>

    <div class="post-main">
        <div class="post-header">
            <a href="/?mode=owner" class="back-link">
                <i class="fas fa-arrow-left"></i>
                Quay lại Bảng điều khiển
            </a>
            <h1>Đăng Tin Cho Thuê</h1>
            <p>Chia sẻ thiết bị của bạn với cộng đồng sinh viên UTE.</p>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                ❌ Có lỗi xảy ra khi đăng tin
            </div>
        }

        <form asp-action="Create" method="post" class="post-form" id="postForm">
            @Html.AntiForgeryToken()
            
            <div class="form-section">
                <div class="form-section-left">
                    <div class="form-group">
                        <label class="form-label">TÊN SẢN PHẨM *</label>
                        <input type="text" name="ProductName" class="form-control" placeholder="Ví dụ: Máy ảnh Sony A7III, Laptop Dell XPS..." required />
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">DANH MỤC *</label>
                            <select name="CategoryId" class="form-control" required>
                                <option value="">-- Chọn danh mục --</option>
                                @foreach (var category in categories)
                                {
                                    <option value="@category.CategoryId">@category.CategoryName</option>
                                }
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="form-label">SỐ LƯỢNG *</label>
                            <input type="number" name="Quantity" class="form-control" value="1" min="1" required />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">GIÁ THUÊ THEO GIỜ (VNĐ)</label>
                            <div class="input-with-suffix">
                                <input type="number" name="PricePerHour" class="form-control" placeholder="20000" min="0" step="1000" />
                                <span class="input-suffix">VNĐ</span>
                            </div>
                            <small class="form-text">Để trống nếu không cho thuê theo giờ</small>
                        </div>

                        <div class="form-group">
                            <label class="form-label">GIÁ THUÊ (VNĐ/NGÀY) *</label>
                            <div class="input-with-suffix">
                                <input type="number" name="PricePerDay" class="form-control" placeholder="50000" min="1000" step="1000" required />
                                <span class="input-suffix">VNĐ</span>
                            </div>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">GIÁ THUÊ THEO TUẦN (VNĐ)</label>
                            <div class="input-with-suffix">
                                <input type="number" name="PricePerWeek" class="form-control" placeholder="300000" min="0" step="10000" />
                                <span class="input-suffix">VNĐ</span>
                            </div>
                            <small class="form-text">Để trống nếu không cho thuê theo tuần</small>
                        </div>

                        <div class="form-group">
                            <label class="form-label">GIÁ THUÊ THEO THÁNG (VNĐ)</label>
                            <div class="input-with-suffix">
                                <input type="number" name="PricePerMonth" class="form-control" placeholder="1000000" min="0" step="10000" />
                                <span class="input-suffix">VNĐ</span>
                            </div>
                            <small class="form-text">Để trống nếu không cho thuê theo tháng</small>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">TIỀN CỌC (VNĐ) *</label>
                            <div class="input-with-suffix">
                                <input type="number" name="Deposit" class="form-control" placeholder="500000" min="0" step="10000" required />
                                <span class="input-suffix">VNĐ</span>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">ĐỊA ĐIỂM</label>
                            <input type="text" name="Location" class="form-control" placeholder="Ví dụ: Ký túc xá A, Khu A UTE..." />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">MÔ TẢ SẢN PHẨM *</label>
                        <textarea name="Description" class="form-control" rows="6" placeholder="Mô tả chi tiết tình trạng máy, các phụ kiện đi kèm..." required></textarea>
                    </div>

                    <div class="form-group">
                        <label class="form-label">LỊCH KHÔNG CHO THUÊ</label>
                        <div class="calendar-container">
                            <input type="text" id="unavailableDatesInput" name="UnavailableDates" hidden />
                            <div id="calendar"></div>
                            <div class="selected-dates-display">
                                <p class="calendar-note">
                                    <i class="fas fa-info-circle"></i>
                                    Click vào các ngày bạn không muốn cho thuê (ví dụ: ngày bạn cần dùng đồ)
                                </p>
                                <div id="selectedDatesList"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-section-right">
                    <div class="image-upload-section">
                        <h3>HÌNH ẢNH SẢN PHẨM</h3>
                        <div class="image-upload-area" id="imageUploadArea">
                            <div class="image-upload-placeholder" id="uploadPlaceholder">
                                <i class="fas fa-cloud-upload-alt"></i>
                                <p>Kéo thả ảnh vào đây</p>
                                <p class="small">hoặc nhấn để chọn từ thiết bị</p>
                                <p class="small">TỐI ĐA 5 ẢNH (JPG, PNG, tối đa 5MB/ảnh)</p>
                            </div>
                            <input type="file" id="imageUpload" name="images" multiple accept="image/*" style="display: none;" />
                            <input type="hidden" id="imageUrlInput" name="ImageUrl" />
                            <input type="hidden" id="productImagesInput" name="ProductImagesJson" />
                        </div>

                        <div class="image-preview-grid" id="imagePreviewGrid">
                            <!-- Images will be added here dynamically -->
                        </div>
                    </div>

                    <button type="submit" class="btn-submit">
                        <i class="fas fa-paper-plane"></i>
                        ĐĂNG TIN NGAY
                    </button>

                    <div class="form-note">
                        <h4>📝 LƯU Ý</h4>
                        <p>Bằng việc nhấn "ĐĂNG TIN NGAY", bạn đồng ý với <a href="/Home/Privacy">Điều khoản sử dụng</a> của UTE Rent.</p>
                    </div>

                    <div class="promo-box">
                        <i class="fas fa-lightbulb"></i>
                        <h4>MẸO ĐĂNG TIN HIỆU QUẢ</h4>
                        <p>Sử dụng hình ảnh rõ nét và mô tả chi tiết để tăng khả năng cho thuê nhanh hơn 200%.</p>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>


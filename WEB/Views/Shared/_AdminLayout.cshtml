<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — UTE Rent Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        :root {
            --brown: #3d2b1f;
            --brown2: #5c3d2e;
            --brown3: #7a5544;
            --green: #4a7c59;
            --green2: #6aab7e;
            --green3: #d4edda;
            --yellow: #f5c842;
            --yellow2: #fde68a;
            --yellow3: #fffbeb;
            --cream: #fdf6ec;
            --cream2: #f7ede0;
            --cream3: #e8d5c0;
            --white: #ffffff;
            --sidebar-w: 220px;
            --topbar-h: 60px;
            --radius: 12px;
            --shadow: 0 4px 16px rgba(61,43,31,.1);
            --shadow-sm: 0 2px 8px rgba(61,43,31,.07);
        }

        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--cream);
            color: var(--brown);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ══════════════════════════════════════
               SIDEBAR — cố định, không overlay
            ══════════════════════════════════════ */
        .adm-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: var(--sidebar-w);
            background: var(--brown);
            display: flex;
            flex-direction: column;
            z-index: 300;
            /* KHÔNG có transition width, KHÔNG hover expand */
        }

        /* Logo */
        .adm-logo {
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: 1rem 1.25rem;
            border-bottom: 1px solid rgba(255,255,255,.08);
            min-height: var(--topbar-h);
            flex-shrink: 0;
        }

        .adm-logo-mark {
            width: 36px;
            height: 36px;
            flex-shrink: 0;
            background: var(--yellow);
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            color: var(--brown);
            font-weight: 900;
        }

        .adm-logo-name {
            font-size: .9rem;
            font-weight: 800;
            color: var(--white);
            display: block;
            line-height: 1.2;
        }

        .adm-logo-sub {
            font-size: .62rem;
            color: rgba(255,255,255,.4);
            text-transform: uppercase;
            letter-spacing: .7px;
        }

        /* Nav */
        .adm-nav {
            flex: 1;
            padding: .5rem 0;
            overflow-y: auto;
        }

            .adm-nav::-webkit-scrollbar {
                width: 3px;
            }

            .adm-nav::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,.12);
                border-radius: 3px;
            }

        .adm-nav-section {
            font-size: .6rem;
            font-weight: 700;
            color: rgba(255,255,255,.3);
            text-transform: uppercase;
            letter-spacing: .9px;
            padding: .875rem 1.25rem .3rem;
        }

        .adm-nav-item {
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: .6rem 1rem .6rem 1.25rem;
            color: rgba(255,255,255,.55);
            text-decoration: none;
            font-size: .875rem;
            font-weight: 500;
            transition: all .15s;
            position: relative;
            margin: .1rem .5rem;
            border-radius: 9px;
        }

            .adm-nav-item .nav-icon {
                width: 32px;
                height: 32px;
                flex-shrink: 0;
                border-radius: 8px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: .875rem;
                background: rgba(255,255,255,.06);
                transition: all .15s;
            }

            .adm-nav-item:hover {
                color: var(--white);
                background: rgba(255,255,255,.07);
            }

                .adm-nav-item:hover .nav-icon {
                    background: rgba(255,255,255,.12);
                }

            .adm-nav-item.active {
                color: var(--brown);
                background: var(--yellow);
            }

                .adm-nav-item.active .nav-icon {
                    background: rgba(61,43,31,.15);
                    color: var(--brown);
                }

        /* Footer */
        .adm-sidebar-footer {
            border-top: 1px solid rgba(255,255,255,.08);
            padding: .5rem;
            flex-shrink: 0;
        }

        .adm-nav-item.logout:hover {
            color: #fca5a5;
            background: rgba(252,165,165,.1);
        }

            .adm-nav-item.logout:hover .nav-icon {
                background: rgba(252,165,165,.15);
                color: #fca5a5;
            }

        /* ══════════════════════════════════════
               TOPBAR
            ══════════════════════════════════════ */
        .adm-topbar {
            position: fixed;
            top: 0;
            left: var(--sidebar-w);
            right: 0;
            height: var(--topbar-h);
            background: var(--white);
            border-bottom: 1.5px solid var(--cream3);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 1.5rem;
            z-index: 200;
        }

        .adm-topbar-left {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .adm-page-title {
            font-size: .95rem;
            font-weight: 700;
            color: var(--brown);
        }

        .adm-breadcrumb {
            font-size: .72rem;
            color: var(--brown3);
            display: flex;
            align-items: center;
            gap: .3rem;
        }

            .adm-breadcrumb .sep {
                color: var(--cream3);
            }

        .adm-search {
            position: relative;
        }

            .adm-search i {
                position: absolute;
                left: .8rem;
                top: 50%;
                transform: translateY(-50%);
                color: var(--brown3);
                font-size: .78rem;
            }

            .adm-search input {
                padding: .5rem 1rem .5rem 2.1rem;
                border: 1.5px solid var(--cream3);
                border-radius: 20px;
                width: 210px;
                font-size: .82rem;
                font-family: inherit;
                background: var(--cream);
                color: var(--brown);
                transition: all .2s;
            }

                .adm-search input:focus {
                    outline: none;
                    border-color: var(--green);
                    background: var(--white);
                    width: 250px;
                    box-shadow: 0 0 0 3px rgba(74,124,89,.1);
                }

                .adm-search input::placeholder {
                    color: var(--brown3);
                }

        .adm-topbar-right {
            display: flex;
            align-items: center;
            gap: .5rem;
        }

        .adm-icon-btn {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: var(--cream);
            border: 1.5px solid var(--cream3);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--brown2);
            font-size: .85rem;
            cursor: pointer;
            transition: all .15s;
            position: relative;
        }

            .adm-icon-btn:hover {
                background: var(--green3);
                border-color: var(--green2);
                color: var(--green);
            }

            .adm-icon-btn .dot {
                position: absolute;
                top: 5px;
                right: 5px;
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: var(--yellow);
                border: 1.5px solid var(--white);
            }

        .adm-user-pill {
            display: flex;
            align-items: center;
            gap: .5rem;
            padding: .3rem .7rem .3rem .3rem;
            background: var(--cream2);
            border: 1.5px solid var(--cream3);
            border-radius: 20px;
            cursor: pointer;
            transition: all .15s;
        }

            .adm-user-pill:hover {
                border-color: var(--green2);
                background: var(--green3);
            }

        .adm-avatar {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--green), var(--brown2));
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--white);
            font-size: .75rem;
            font-weight: 700;
        }

        .adm-user-info-name {
            font-size: .8rem;
            font-weight: 700;
            color: var(--brown);
        }

        .adm-user-info-role {
            font-size: .62rem;
            color: var(--brown3);
        }

        .adm-user-pill .fa-chevron-down {
            font-size: .58rem;
            color: var(--brown3);
        }

        .adm-user-menu {
            position: relative;
        }

        .adm-user-dropdown {
            position: absolute;
            top: calc(100% + .5rem);
            right: 0;
            background: var(--white);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            min-width: 190px;
            border: 1.5px solid var(--cream3);
            opacity: 0;
            visibility: hidden;
            transform: translateY(-6px);
            transition: all .18s;
            z-index: 400;
        }

            .adm-user-dropdown.open {
                opacity: 1;
                visibility: visible;
                transform: translateY(0);
            }

            .adm-user-dropdown a {
                display: flex;
                align-items: center;
                gap: .7rem;
                padding: .7rem 1rem;
                color: var(--brown2);
                font-size: .875rem;
                text-decoration: none;
                transition: background .12s;
            }

                .adm-user-dropdown a:first-child {
                    border-radius: var(--radius) var(--radius) 0 0;
                }

                .adm-user-dropdown a:last-child {
                    border-radius: 0 0 var(--radius) var(--radius);
                    color: #dc2626;
                }

                .adm-user-dropdown a:hover {
                    background: var(--cream2);
                }

                .adm-user-dropdown a:last-child:hover {
                    background: #fef2f2;
                }

                .adm-user-dropdown a i {
                    width: 15px;
                    font-size: .85rem;
                }

        /* ══════════════════════════════════════
               MAIN — margin-left = sidebar width cố định
            ══════════════════════════════════════ */
        .adm-main {
            margin-left: var(--sidebar-w);
            padding-top: var(--topbar-h);
            min-height: 100vh;
        }

        .adm-content {
            padding: 1.5rem 1.75rem;
        }

        /* Alerts */
        .adm-alert {
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: .875rem 1.1rem;
            border-radius: var(--radius);
            margin-bottom: 1.25rem;
            font-size: .875rem;
        }

        .adm-alert-success {
            background: var(--green3);
            color: #166534;
            border: 1px solid #86efac;
        }

        .adm-alert-danger {
            background: #fee2e2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }

        .adm-alert-close {
            margin-left: auto;
            background: none;
            border: none;
            cursor: pointer;
            color: inherit;
            opacity: .6;
            font-size: 1.1rem;
        }

            .adm-alert-close:hover {
                opacity: 1;
            }

        /* Mobile */
        @@media (max-width: 768px) {
            .adm-sidebar {
                transform: translateX(-100%);
                transition: transform .25s;
            }

                .adm-sidebar.mobile-open {
                    transform: translateX(0);
                }

            .adm-topbar {
                left: 0;
            }

            .adm-main {
                margin-left: 0;
            }

            .adm-search {
                display: none;
            }
        }
    </style>
</head>
<body>
    @{
        var userName = Context.Session.GetString("UserName") ?? "Admin";
        var firstLetter = userName.Length > 0 ? userName[0].ToString().ToUpper() : "A";
        var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    }

    <!-- Sidebar cố định -->
    <aside class="adm-sidebar" id="admSidebar">
        <div class="adm-logo">
            <div class="adm-logo-mark">U</div>
            <div>
                <span class="adm-logo-name">UTE Rent</span>
                <span class="adm-logo-sub">Admin Terminal</span>
            </div>
        </div>

        <nav class="adm-nav">
            <div class="adm-nav-section">Tổng quan</div>
            <a href="@Url.Action("Dashboard", "Admin")" class="adm-nav-item @(action == "Dashboard" ? "active" : "")">
                <span class="nav-icon"><i class="fas fa-th-large"></i></span>
                Dashboard
            </a>

            <div class="adm-nav-section">Quản lý</div>
            <a href="@Url.Action("Users", "Admin")" class="adm-nav-item @(action == "Users" ? "active" : "")">
                <span class="nav-icon"><i class="fas fa-users"></i></span>
                Người dùng
            </a>
            <a href="@Url.Action("Products", "Admin")" class="adm-nav-item @(action == "Products" ? "active" : "")">
                <span class="nav-icon"><i class="fas fa-box"></i></span>
                Sản phẩm
                @{
                    var pendingCount = ViewBag.PendingProductsCount as int? ?? 0;
                    if (pendingCount > 0)
                    {
                        <span style="position:absolute;right:.75rem;top:50%;transform:translateY(-50%);background:#fbbf24;color:#78350f;font-size:.65rem;font-weight:800;padding:.2rem .5rem;border-radius:10px;min-width:20px;text-align:center;">@pendingCount</span>
                    }
                }
            </a>
            <a href="@Url.Action("Rentals", "Admin")" class="adm-nav-item @(action == "Rentals" ? "active" : "")">
                <span class="nav-icon"><i class="fas fa-handshake"></i></span>
                Đơn thuê
            </a>

            <div class="adm-nav-section">Tài chính</div>
            <a href="@Url.Action("Commissions", "Admin")" class="adm-nav-item @(action == "Commissions" ? "active" : "")">
                <span class="nav-icon"><i class="fas fa-coins"></i></span>
                Hoa hồng
            </a>
            <a href="@Url.Action("Complaints", "Admin")" class="adm-nav-item @(action == "Complaints" ? "active" : "")">
                <span class="nav-icon"><i class="fas fa-exclamation-circle"></i></span>
                Khiếu nại
            </a>

            <div class="adm-nav-section">Hỗ trợ</div>
            <a href="/Message" class="adm-nav-item @(controller == "Message" ? "active" : "")">
                <span class="nav-icon"><i class="fas fa-comments"></i></span>
                Tin nhắn hỗ trợ
            </a>
        </nav>

        <div class="adm-sidebar-footer">
            <a href="@Url.Action("Logout", "Account")" class="adm-nav-item logout">
                <span class="nav-icon"><i class="fas fa-sign-out-alt"></i></span>
                Đăng xuất
            </a>
        </div>
    </aside>

    <!-- Topbar -->
    <header class="adm-topbar">
        <div class="adm-topbar-left">
            <div>
                <div class="adm-page-title">@(ViewData["Title"] ?? "Dashboard")</div>
                <div class="adm-breadcrumb">
                    <span>UTE Rent</span>
                    <span class="sep">/</span>
                    <span>@(ViewData["Title"] ?? "Dashboard")</span>
                </div>
            </div>
            <div class="adm-search">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="Tìm kiếm tài nguyên..." />
            </div>
        </div>

        <div class="adm-topbar-right">
            <button class="adm-icon-btn" title="Thông báo">
                <i class="fas fa-bell"></i>
                <span class="dot"></span>
            </button>
            <button class="adm-icon-btn" title="Trợ giúp">
                <i class="fas fa-question-circle"></i>
            </button>
            <div class="adm-user-menu">
                <div class="adm-user-pill" onclick="toggleUserMenu()">
                    <div class="adm-avatar">@firstLetter</div>
                    <div>
                        <div class="adm-user-info-name">@userName</div>
                        <div class="adm-user-info-role">Quản trị viên</div>
                    </div>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="adm-user-dropdown" id="admDropdown">
                    <a href="#"><i class="fas fa-user"></i> Tài khoản</a>
                    <a href="#"><i class="fas fa-cog"></i> Cài đặt</a>
                    <a href="@Url.Action("Logout", "Account")"><i class="fas fa-sign-out-alt"></i> Đăng xuất</a>
                </div>
            </div>
        </div>
    </header>

    <!-- Main content — luôn bắt đầu sau sidebar cố định -->
    <main class="adm-main">
        <div class="adm-content">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="adm-alert adm-alert-success">
                    <i class="fas fa-check-circle"></i>
                    <span>@TempData["SuccessMessage"]</span>
                    <button class="adm-alert-close" onclick="this.parentElement.remove()">×</button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="adm-alert adm-alert-danger">
                    <i class="fas fa-exclamation-circle"></i>
                    <span>@TempData["ErrorMessage"]</span>
                    <button class="adm-alert-close" onclick="this.parentElement.remove()">×</button>
                </div>
            }
            @RenderBody()
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        function toggleUserMenu() {
            document.getElementById('admDropdown').classList.toggle('open');
        }
        document.addEventListener('click', e => {
            const menu = document.querySelector('.adm-user-menu');
            if (!menu?.contains(e.target))
                document.getElementById('admDropdown')?.classList.remove('open');
        });
    </script>
</body>
</html>

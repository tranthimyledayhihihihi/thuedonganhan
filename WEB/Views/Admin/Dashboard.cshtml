@model WEB.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var userName = Context.Session.GetString("UserName") ?? "Admin";
    var hour     = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Chào buổi sáng" : hour < 18 ? "Chào buổi chiều" : "Chào buổi tối";
}

<style>
/* ── Greeting ────────────────────────────────────────── */
.dg-greeting {
    background: var(--brown);
    border-radius: 16px;
    padding: 1.5rem 2rem;
    margin-bottom: 1.5rem;
    display: flex; align-items: center; justify-content: space-between;
    position: relative; overflow: hidden;
}
.dg-greeting::before {
    content: '';
    position: absolute; right: -40px; top: -40px;
    width: 180px; height: 180px; border-radius: 50%;
    background: rgba(255,255,255,.04);
}
.dg-greeting::after {
    content: '';
    position: absolute; right: 60px; bottom: -50px;
    width: 120px; height: 120px; border-radius: 50%;
    background: rgba(245,200,66,.06);
}
.dg-greeting-text h2 {
    font-size: 1.4rem; font-weight: 800; color: var(--white);
    margin-bottom: .25rem;
}
.dg-greeting-text p { font-size: .875rem; color: rgba(255,255,255,.6); }
.dg-greeting-tag {
    display: inline-flex; align-items: center; gap: .35rem;
    background: var(--yellow); color: var(--brown);
    padding: .25rem .75rem; border-radius: 20px;
    font-size: .7rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: .5px;
    margin-bottom: .6rem;
}
.dg-greeting-actions { display: flex; gap: .6rem; position: relative; z-index: 1; }
.dg-btn {
    display: inline-flex; align-items: center; gap: .4rem;
    padding: .55rem 1.1rem; border-radius: 20px;
    font-size: .82rem; font-weight: 700; text-decoration: none;
    transition: all .15s; border: none; cursor: pointer; font-family: inherit;
}
.dg-btn-yellow { background: var(--yellow); color: var(--brown); }
.dg-btn-yellow:hover { background: var(--yellow2); color: var(--brown); }
.dg-btn-ghost  { background: rgba(255,255,255,.1); color: var(--white); border: 1.5px solid rgba(255,255,255,.2); }
.dg-btn-ghost:hover { background: rgba(255,255,255,.18); color: var(--white); }

/* ── Stat grid ───────────────────────────────────────── */
.dg-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
}
.dg-stat {
    background: var(--white);
    border-radius: 14px;
    padding: 1.25rem 1.4rem;
    border: 1.5px solid var(--cream3);
    box-shadow: var(--shadow-sm);
    transition: transform .15s, box-shadow .15s;
}
.dg-stat:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
.dg-stat-top {
    display: flex; align-items: center;
    justify-content: space-between; margin-bottom: .875rem;
}
.dg-stat-icon {
    width: 42px; height: 42px; border-radius: 11px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1rem;
}
.dg-stat-badge {
    font-size: .68rem; font-weight: 700;
    padding: .18rem .5rem; border-radius: 20px;
}
.badge-up   { background: var(--green3); color: var(--green); }
.badge-warn { background: var(--yellow3); color: #d97706; }
.badge-red  { background: #fee2e2; color: #dc2626; }
.dg-stat-label { font-size: .72rem; font-weight: 600; color: var(--brown3); margin-bottom: .2rem; }
.dg-stat-value { font-size: 1.9rem; font-weight: 900; color: var(--brown); line-height: 1; }

/* Accent bottom bar */
.dg-stat::after {
    content: ''; display: block;
    height: 3px; border-radius: 0 0 14px 14px;
    margin: .875rem -1.4rem -1.25rem;
}
.dg-stat.s1::after { background: #6366f1; }
.dg-stat.s2::after { background: var(--yellow); }
.dg-stat.s3::after { background: var(--green); }
.dg-stat.s4::after { background: #ef4444; }

/* ── Revenue row ─────────────────────────────────────── */
.dg-rev-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
}
.dg-rev-card {
    border-radius: 14px;
    padding: 1.25rem 1.4rem;
    border: 1.5px solid var(--cream3);
    background: var(--white);
    box-shadow: var(--shadow-sm);
}
.dg-rev-label {
    font-size: .7rem; font-weight: 700; color: var(--brown3);
    text-transform: uppercase; letter-spacing: .5px;
    display: flex; align-items: center; gap: .35rem;
    margin-bottom: .5rem;
}
.dg-rev-label i { font-size: .8rem; }
.dg-rev-value { font-size: 1.5rem; font-weight: 900; color: var(--brown); margin-bottom: .25rem; }
.dg-rev-note  { font-size: .75rem; color: var(--brown3); }
.dg-rev-bar   { height: 5px; background: var(--cream3); border-radius: 3px; margin-top: .875rem; overflow: hidden; }
.dg-rev-fill  { height: 100%; border-radius: 3px; }

/* ── Two-col layout ──────────────────────────────────── */
.dg-two-col {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 1rem;
}

/* ── Panel ───────────────────────────────────────────── */
.dg-panel {
    background: var(--white);
    border-radius: 14px;
    border: 1.5px solid var(--cream3);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
}
.dg-panel-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--cream3);
}
.dg-panel-title {
    font-size: .875rem; font-weight: 700; color: var(--brown);
    display: flex; align-items: center; gap: .4rem;
}
.dg-panel-title i { color: var(--green); }
.dg-panel-link {
    font-size: .75rem; font-weight: 700; color: var(--green);
    text-decoration: none;
}
.dg-panel-link:hover { text-decoration: underline; }

/* Commission table */
.dg-table { width: 100%; border-collapse: collapse; }
.dg-table th {
    font-size: .65rem; font-weight: 700; color: var(--brown3);
    text-transform: uppercase; letter-spacing: .5px;
    padding: .6rem 1.25rem; text-align: left;
    border-bottom: 1px solid var(--cream3);
    background: var(--cream2); white-space: nowrap;
}
.dg-table td {
    padding: .75rem 1.25rem; border-bottom: 1px solid var(--cream3);
    font-size: .82rem; color: var(--brown2); vertical-align: middle;
}
.dg-table tr:last-child td { border-bottom: none; }
.dg-table tr:hover td { background: var(--cream2); }
.dg-badge {
    display: inline-block; padding: .18rem .55rem;
    border-radius: 20px; font-size: .68rem; font-weight: 700;
}
.dg-badge-green  { background: var(--green3); color: var(--green); }
.dg-badge-cream  { background: var(--cream2); color: var(--brown2); }

/* Users panel */
.dg-user-list { padding: .5rem 0; }
.dg-user-row {
    display: flex; align-items: center; gap: .75rem;
    padding: .65rem 1.25rem;
    transition: background .12s;
}
.dg-user-row:hover { background: var(--cream2); }
.dg-user-av {
    width: 34px; height: 34px; border-radius: 50%;
    background: linear-gradient(135deg, var(--green), var(--brown2));
    display: flex; align-items: center; justify-content: center;
    color: var(--white); font-size: .78rem; font-weight: 700;
    flex-shrink: 0;
}
.dg-user-name { font-size: .875rem; font-weight: 600; color: var(--brown); }
.dg-user-role { font-size: .72rem; color: var(--brown3); }
.dg-lock-btn {
    margin-left: auto;
    padding: .2rem .6rem;
    background: #fee2e2; color: #dc2626;
    border: 1px solid #fecaca;
    border-radius: 6px; font-size: .68rem; font-weight: 700;
    cursor: pointer; text-transform: uppercase;
    transition: all .15s;
}
.dg-lock-btn:hover { background: #dc2626; color: var(--white); }
.dg-panel-footer {
    padding: .75rem 1.25rem;
    border-top: 1px solid var(--cream3);
    text-align: center;
}
.dg-panel-footer a { font-size: .78rem; color: var(--brown3); font-weight: 500; }
.dg-panel-footer a:hover { color: var(--green); }

/* Empty */
.dg-empty { text-align: center; padding: 2.5rem 1rem; color: var(--brown3); }
.dg-empty i { font-size: 2rem; margin-bottom: .75rem; display: block; }

/* Responsive */
@@media (max-width: 1100px) {
    .dg-stats { grid-template-columns: repeat(2, 1fr); }
    .dg-rev-row { grid-template-columns: 1fr 1fr; }
    .dg-two-col { grid-template-columns: 1fr; }
}
@@media (max-width: 640px) {
    .dg-stats { grid-template-columns: 1fr 1fr; }
    .dg-rev-row { grid-template-columns: 1fr; }
    .dg-greeting { flex-direction: column; gap: 1rem; align-items: flex-start; }
}
</style>

<!-- Greeting -->
<div class="dg-greeting">
    <div class="dg-greeting-text" style="position:relative;z-index:1;">
        <div class="dg-greeting-tag">
            <i class="fas fa-calendar-day"></i>
            @DateTime.Now.ToString("dd/MM/yyyy")
        </div>
        <h2>@greeting, @userName!</h2>
        <p>Hệ thống UTE Rent đang hoạt động ổn định.</p>
    </div>
    <div class="dg-greeting-actions">
        <a href="@Url.Action("Products","Admin")" class="dg-btn dg-btn-yellow">
            <i class="fas fa-box"></i> Sản phẩm
        </a>
        <a href="@Url.Action("Rentals","Admin")" class="dg-btn dg-btn-ghost">
            <i class="fas fa-handshake"></i> Đơn thuê
        </a>
    </div>
</div>

<!-- Stat cards -->
<div class="dg-stats">
    <div class="dg-stat s1">
        <div class="dg-stat-top">
            <div class="dg-stat-icon" style="background:#eef2ff;color:#6366f1;"><i class="fas fa-users"></i></div>
            <span class="dg-stat-badge badge-up">+12%</span>
        </div>
        <div class="dg-stat-label">Tổng người dùng</div>
        <div class="dg-stat-value">@Model.Stats.TotalUsers.ToString("N0")</div>
    </div>
    <div class="dg-stat s2">
        <div class="dg-stat-top">
            <div class="dg-stat-icon" style="background:var(--yellow3);color:#d97706;"><i class="fas fa-box"></i></div>
            <span class="dg-stat-badge badge-warn">Kho</span>
        </div>
        <div class="dg-stat-label">Tổng sản phẩm</div>
        <div class="dg-stat-value">@Model.Stats.TotalProducts.ToString("N0")</div>
    </div>
    <div class="dg-stat s3">
        <div class="dg-stat-top">
            <div class="dg-stat-icon" style="background:var(--green3);color:var(--green);"><i class="fas fa-handshake"></i></div>
            <span class="dg-stat-badge badge-up">Active</span>
        </div>
        <div class="dg-stat-label">Đang cho thuê</div>
        <div class="dg-stat-value">@Model.Stats.ActiveRentals</div>
    </div>
    <div class="dg-stat s4">
        <div class="dg-stat-top">
            <div class="dg-stat-icon" style="background:#fee2e2;color:#ef4444;"><i class="fas fa-clock"></i></div>
            <span class="dg-stat-badge badge-red">Cần xử lý</span>
        </div>
        <div class="dg-stat-label">Chờ xác nhận</div>
        <div class="dg-stat-value">@Model.Stats.PendingRentals</div>
    </div>
</div>

<!-- Revenue row -->
<div class="dg-rev-row">
    <div class="dg-rev-card">
        <div class="dg-rev-label"><i class="fas fa-chart-line" style="color:var(--green);"></i>Tổng doanh thu</div>
        <div class="dg-rev-value">@Model.Stats.TotalRevenue.ToString("N0")đ</div>
        <div class="dg-rev-note"><i class="fas fa-check-circle" style="color:var(--green);margin-right:.3rem;"></i>@Model.Stats.CompletedRentals đơn hoàn thành</div>
        <div class="dg-rev-bar"><div class="dg-rev-fill" style="width:72%;background:var(--green);"></div></div>
    </div>
    <div class="dg-rev-card">
        <div class="dg-rev-label"><i class="fas fa-percentage" style="color:#be185d;"></i>Hoa hồng (5%)</div>
        <div class="dg-rev-value">@Model.Stats.TotalCommission.ToString("N0")đ</div>
        <div class="dg-rev-note"><i class="fas fa-coins" style="color:#be185d;margin-right:.3rem;"></i>Từ các đơn thuê</div>
        <div class="dg-rev-bar"><div class="dg-rev-fill" style="width:55%;background:#ec4899;"></div></div>
    </div>
    <div class="dg-rev-card" style="background:var(--brown);border-color:var(--brown);">
        <div class="dg-rev-label" style="color:rgba(255,255,255,.55);"><i class="fas fa-wallet" style="color:var(--yellow);"></i>Số dư ví Admin</div>
        <div class="dg-rev-value" style="color:var(--white);">@Model.Stats.AdminBalance.ToString("N0")đ</div>
        <div class="dg-rev-note" style="color:rgba(255,255,255,.5);"><i class="fas fa-arrow-up" style="margin-right:.3rem;color:var(--yellow);"></i>Số dư hiện tại</div>
        <div class="dg-rev-bar" style="background:rgba(255,255,255,.1);"><div class="dg-rev-fill" style="width:88%;background:var(--yellow);"></div></div>
    </div>
</div>

<!-- Commission table + Users panel -->
<div class="dg-two-col">

    <!-- Commission table -->
    <div class="dg-panel">
        <div class="dg-panel-header">
            <span class="dg-panel-title"><i class="fas fa-history"></i>Hoa hồng gần đây</span>
            <a href="@Url.Action("Commissions","Admin")" class="dg-panel-link">Xem tất cả →</a>
        </div>
        @if (Model.RecentCommissions.Any())
        {
            <table class="dg-table">
                <thead>
                    <tr>
                        <th>Mã GD</th>
                        <th>Mô tả</th>
                        <th>Số tiền</th>
                        <th>Đơn thuê</th>
                        <th>Thời gian</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.RecentCommissions.Take(6))
                    {
                        <tr>
                            <td><span class="dg-badge dg-badge-cream">#@c.TransactionId</span></td>
                            <td style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@c.Description</td>
                            <td style="font-weight:700;color:var(--green);">+@c.Amount.ToString("N0")đ</td>
                            <td>
                                @if (c.ReferenceId.HasValue)
                                { <span class="dg-badge dg-badge-green">#@c.ReferenceId</span> }
                                else { <span style="color:var(--cream3);">—</span> }
                            </td>
                            <td style="color:var(--brown3);font-size:.75rem;">@c.CreatedAt.ToString("dd/MM HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="dg-empty">
                <i class="fas fa-inbox"></i>
                <p>Chưa có giao dịch hoa hồng</p>
            </div>
        }
    </div>

    <!-- New users -->
    <div class="dg-panel">
        <div class="dg-panel-header">
            <span class="dg-panel-title"><i class="fas fa-user-plus"></i>Người dùng mới</span>
        </div>
        <div class="dg-user-list">
            @{
                var sampleUsers = new[] {
                    new { Name="Hoàng Nam",     Role="Student",  Init="HN" },
                    new { Name="Nguyễn Thu Hà", Role="Landlord", Init="NH" },
                    new { Name="Đặng Mỹ Linh",  Role="Student",  Init="DL" },
                    new { Name="Trần Văn B",    Role="Student",  Init="TB" },
                };
            }
            @foreach (var u in sampleUsers)
            {
                <div class="dg-user-row">
                    <div class="dg-user-av">@u.Init</div>
                    <div>
                        <div class="dg-user-name">@u.Name</div>
                        <div class="dg-user-role">@u.Role</div>
                    </div>
                    <button class="dg-lock-btn">Khoá</button>
                </div>
            }
        </div>
        <div class="dg-panel-footer">
            <a href="@Url.Action("Users","Admin")">Quản lý tất cả người dùng →</a>
        </div>
    </div>

</div>

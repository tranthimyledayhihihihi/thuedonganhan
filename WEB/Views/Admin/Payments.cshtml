@model AdminPagedResult<AdminPaymentViewModel>
@{
    ViewData["Title"] = "Quản lý Thanh toán";
    var paymentType = ViewBag.PaymentType as string;
    var paymentStatus = ViewBag.PaymentStatus as string;
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header pb-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Danh sách Thanh toán</h5>
                        <span class="badge bg-primary">Tổng: @Model.Pagination.TotalItems giao dịch</span>
                    </div>
                </div>

                <div class="card-body px-0 pt-0 pb-2">
                    <!-- Filter -->
                    <div class="px-4 py-3">
                        <form method="get" class="row g-3">
                            <div class="col-md-3">
                                <select name="paymentType" class="form-select">
                                    <option value="">-- Loại thanh toán --</option>
                                    <option value="RentalFee" selected="@(paymentType == "RentalFee")">Rental Fee</option>
                                    <option value="Deposit" selected="@(paymentType == "Deposit")">Deposit</option>
                                    <option value="LateFee" selected="@(paymentType == "LateFee")">Late Fee</option>
                                    <option value="DamageFee" selected="@(paymentType == "DamageFee")">Damage Fee</option>
                                    <option value="DepositRefund" selected="@(paymentType == "DepositRefund")">Deposit Refund</option>
                                    <option value="SalePayment" selected="@(paymentType == "SalePayment")">Sale Payment</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <select name="paymentStatus" class="form-select">
                                    <option value="">-- Trạng thái --</option>
                                    <option value="Pending" selected="@(paymentStatus == "Pending")">Pending</option>
                                    <option value="Completed" selected="@(paymentStatus == "Completed")">Completed</option>
                                    <option value="Failed" selected="@(paymentStatus == "Failed")">Failed</option>
                                    <option value="Refunded" selected="@(paymentStatus == "Refunded")">Refunded</option>
                                    <option value="Cancelled" selected="@(paymentStatus == "Cancelled")">Cancelled</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="fas fa-filter"></i> Lọc
                                </button>
                            </div>
                            <div class="col-md-2">
                                <a asp-action="Payments" class="btn btn-secondary w-100">
                                    <i class="fas fa-redo"></i> Reset
                                </a>
                            </div>
                        </form>
                    </div>

                    @if (Model.Items.Any())
                    {
                        <div class="table-responsive p-0">
                            <table class="table align-items-center mb-0">
                                <thead>
                                    <tr>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">ID</th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Người thanh toán</th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Loại</th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-end">Số tiền</th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Phương thức</th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">Trạng thái</th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Ngày</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var payment in Model.Items)
                                    {
                                        <tr>
                                            <td>
                                                <p class="text-xs font-weight-bold mb-0">#@payment.PaymentId</p>
                                            </td>
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <h6 class="mb-0 text-sm">@payment.PayerName</h6>
                                                    <p class="text-xs text-secondary mb-0">@payment.PayerEmail</p>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge badge-sm bg-info">@payment.PaymentType</span>
                                            </td>
                                            <td class="text-end">
                                                <p class="text-xs font-weight-bold mb-0">@payment.Amount.ToString("N0") đ</p>
                                            </td>
                                            <td>
                                                <p class="text-xs mb-0">@payment.PaymentMethod</p>
                                            </td>
                                            <td class="text-center">
                                                @if (payment.PaymentStatus == "Completed")
                                                {
                                                    <span class="badge badge-sm bg-success">Completed</span>
                                                }
                                                else if (payment.PaymentStatus == "Pending")
                                                {
                                                    <span class="badge badge-sm bg-warning">Pending</span>
                                                }
                                                else if (payment.PaymentStatus == "Failed")
                                                {
                                                    <span class="badge badge-sm bg-danger">Failed</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-sm bg-secondary">@payment.PaymentStatus</span>
                                                }
                                            </td>
                                            <td>
                                                <p class="text-xs mb-0">@payment.PaymentDate.ToString("dd/MM/yyyy HH:mm")</p>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        @if (Model.Pagination.TotalPages > 1)
                        {
                            <div class="px-4 py-3">
                                <nav>
                                    <ul class="pagination justify-content-center">
                                        <li class="page-item @(!Model.Pagination.HasPreviousPage ? "disabled" : "")">
                                            <a class="page-link" asp-action="Payments" 
                                               asp-route-page="@(Model.Pagination.CurrentPage - 1)"
                                               asp-route-paymentType="@paymentType"
                                               asp-route-paymentStatus="@paymentStatus">Trước</a>
                                        </li>

                                        @for (int i = 1; i <= Model.Pagination.TotalPages; i++)
                                        {
                                            <li class="page-item @(i == Model.Pagination.CurrentPage ? "active" : "")">
                                                <a class="page-link" asp-action="Payments" 
                                                   asp-route-page="@i"
                                                   asp-route-paymentType="@paymentType"
                                                   asp-route-paymentStatus="@paymentStatus">@i</a>
                                            </li>
                                        }

                                        <li class="page-item @(!Model.Pagination.HasNextPage ? "disabled" : "")">
                                            <a class="page-link" asp-action="Payments" 
                                               asp-route-page="@(Model.Pagination.CurrentPage + 1)"
                                               asp-route-paymentType="@paymentType"
                                               asp-route-paymentStatus="@paymentStatus">Sau</a>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-credit-card fa-3x text-secondary mb-3"></i>
                            <p class="text-secondary">Không có thanh toán nào</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

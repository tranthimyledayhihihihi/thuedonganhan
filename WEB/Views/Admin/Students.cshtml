@model AdminPagedResult<AdminStudentViewModel>
@{
    ViewData["Title"] = "Quản lý Sinh viên";
    var search = ViewBag.Search as string;
    var status = ViewBag.Status as string;
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header pb-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Danh sách Sinh viên</h5>
                        <span class="badge bg-primary">Tổng: @Model.Pagination.TotalItems sinh viên</span>
                    </div>
                </div>

                <div class="card-body px-0 pt-0 pb-2">
                    <!-- Filter & Search -->
                    <div class="px-4 py-3">
                        <form method="get" class="row g-3">
                            <div class="col-md-4">
                                <input type="text" name="search" class="form-control" 
                                       placeholder="Tìm theo MSSV, tên, email..." value="@search">
                            </div>
                            <div class="col-md-3">
                                <select name="status" class="form-select">
                                    <option value="">-- Tất cả trạng thái --</option>
                                    <option value="Active" selected="@(status == "Active")">Active</option>
                                    <option value="Graduated" selected="@(status == "Graduated")">Graduated</option>
                                    <option value="Suspended" selected="@(status == "Suspended")">Suspended</option>
                                    <option value="LeaveOfAbsence" selected="@(status == "LeaveOfAbsence")">Leave Of Absence</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="fas fa-search"></i> Tìm kiếm
                                </button>
                            </div>
                            <div class="col-md-2">
                                <a asp-action="Students" class="btn btn-secondary w-100">
                                    <i class="fas fa-redo"></i> Reset
                                </a>
                            </div>
                        </form>
                    </div>

                    @if (Model.Items.Any())
                    {
                        <div class="table-responsive p-0">
                            <table class="table align-items-center mb-0">
                                <thead>
                                    <tr>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">MSSV</th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Họ tên</th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Email</th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Khoa</th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Lớp</th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">Trạng thái</th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">Tài khoản</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var student in Model.Items)
                                    {
                                        <tr>
                                            <td>
                                                <p class="text-xs font-weight-bold mb-0">@student.StudentCode</p>
                                            </td>
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <h6 class="mb-0 text-sm">@student.FullName</h6>
                                                    <p class="text-xs text-secondary mb-0">@student.Major</p>
                                                </div>
                                            </td>
                                            <td>
                                                <p class="text-xs mb-0">@student.Email</p>
                                            </td>
                                            <td>
                                                <p class="text-xs mb-0">@student.Faculty</p>
                                            </td>
                                            <td>
                                                <p class="text-xs mb-0">@student.ClassName - K@student.AcademicYear</p>
                                            </td>
                                            <td class="text-center">
                                                @if (student.Status == "Active")
                                                {
                                                    <span class="badge badge-sm bg-success">Active</span>
                                                }
                                                else if (student.Status == "Graduated")
                                                {
                                                    <span class="badge badge-sm bg-info">Graduated</span>
                                                }
                                                else if (student.Status == "Suspended")
                                                {
                                                    <span class="badge badge-sm bg-danger">Suspended</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-sm bg-warning">@student.Status</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (student.HasAccount && student.UserInfo != null)
                                                {
                                                    <div>
                                                        <span class="badge badge-sm bg-success">Có tài khoản</span>
                                                        @if (student.UserInfo.IsVerified)
                                                        {
                                                            <span class="badge badge-sm bg-primary">Verified</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-sm bg-warning">Chưa verify</span>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-sm bg-secondary">Chưa đăng ký</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        @if (Model.Pagination.TotalPages > 1)
                        {
                            <div class="px-4 py-3">
                                <nav>
                                    <ul class="pagination justify-content-center">
                                        <li class="page-item @(!Model.Pagination.HasPreviousPage ? "disabled" : "")">
                                            <a class="page-link" asp-action="Students" 
                                               asp-route-page="@(Model.Pagination.CurrentPage - 1)"
                                               asp-route-search="@search"
                                               asp-route-status="@status">Trước</a>
                                        </li>

                                        @for (int i = 1; i <= Model.Pagination.TotalPages; i++)
                                        {
                                            <li class="page-item @(i == Model.Pagination.CurrentPage ? "active" : "")">
                                                <a class="page-link" asp-action="Students" 
                                                   asp-route-page="@i"
                                                   asp-route-search="@search"
                                                   asp-route-status="@status">@i</a>
                                            </li>
                                        }

                                        <li class="page-item @(!Model.Pagination.HasNextPage ? "disabled" : "")">
                                            <a class="page-link" asp-action="Students" 
                                               asp-route-page="@(Model.Pagination.CurrentPage + 1)"
                                               asp-route-search="@search"
                                               asp-route-status="@status">Sau</a>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-user-graduate fa-3x text-secondary mb-3"></i>
                            <p class="text-secondary">Không tìm thấy sinh viên nào</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

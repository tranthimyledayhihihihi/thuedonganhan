@model AdminStatisticsViewModel
@{
    ViewData["Title"] = "Thống kê Hệ thống";
}

<div class="container-fluid py-4">
    <h4 class="mb-4">Thống kê Toàn hệ thống</h4>

    <!-- Users Statistics -->
    <div class="row mb-4">
        <div class="col-12">
            <h5 class="text-primary mb-3"><i class="fas fa-users"></i> Người dùng</h5>
        </div>
        <div class="col-xl-3 col-sm-6 mb-3">
            <div class="card">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-sm mb-0 text-uppercase font-weight-bold">Tổng Users</p>
                            <h5 class="font-weight-bolder mb-0">@Model.Users.Total</h5>
                        </div>
                        <div class="icon icon-shape bg-gradient-primary shadow text-center border-radius-md">
                            <i class="ni ni-single-02 text-lg opacity-10"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6 mb-3">
            <div class="card">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-sm mb-0 text-uppercase font-weight-bold">Đã xác thực</p>
                            <h5 class="font-weight-bolder mb-0 text-success">@Model.Users.Verified</h5>
                        </div>
                        <div class="icon icon-shape bg-gradient-success shadow text-center border-radius-md">
                            <i class="ni ni-check-bold text-lg opacity-10"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6 mb-3">
            <div class="card">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-sm mb-0 text-uppercase font-weight-bold">Đang hoạt động</p>
                            <h5 class="font-weight-bolder mb-0 text-info">@Model.Users.Active</h5>
                        </div>
                        <div class="icon icon-shape bg-gradient-info shadow text-center border-radius-md">
                            <i class="ni ni-active-40 text-lg opacity-10"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6 mb-3">
            <div class="card">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-sm mb-0 text-uppercase font-weight-bold">Không hoạt động</p>
                            <h5 class="font-weight-bolder mb-0 text-danger">@Model.Users.Inactive</h5>
                        </div>
                        <div class="icon icon-shape bg-gradient-danger shadow text-center border-radius-md">
                            <i class="ni ni-user-run text-lg opacity-10"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Students Statistics -->
    <div class="row mb-4">
        <div class="col-12">
            <h5 class="text-primary mb-3"><i class="fas fa-user-graduate"></i> Sinh viên</h5>
        </div>
        <div class="col-xl-4 col-sm-6 mb-3">
            <div class="card">
                <div class="card-body p-3">
                    <p class="text-sm mb-0 text-uppercase font-weight-bold">Tổng sinh viên</p>
                    <h5 class="font-weight-bolder mb-0">@Model.Students.Total</h5>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-sm-6 mb-3">
            <div class="card">
                <div class="card-body p-3">
                    <p class="text-sm mb-0 text-uppercase font-weight-bold">Đang học</p>
                    <h5 class="font-weight-bolder mb-0 text-success">@Model.Students.Active</h5>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-sm-6 mb-3">
            <div class="card">
                <div class="card-body p-3">
                    <p class="text-sm mb-0 text-uppercase font-weight-bold">Có tài khoản</p>
                    <h5 class="font-weight-bolder mb-0 text-info">@Model.Students.WithAccount</h5>
                </div>
            </div>
        </div>
    </div>

    <!-- Products Statistics -->
    <div class="row mb-4">
        <div class="col-12">
            <h5 class="text-primary mb-3"><i class="fas fa-box"></i> Sản phẩm</h5>
        </div>
        <div class="col-xl-3 col-sm-6 mb-3">
            <div class="card">
                <div class="card-body p-3">
                    <p class="text-sm mb-0 text-uppercase font-weight-bold">Tổng sản phẩm</p>
                    <h5 class="font-weight-bolder mb-0">@Model.Products.Total</h5>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6 mb-3">
            <div class="card">
                <div class="card-body p-3">
                    <p class="text-sm mb-0 text-uppercase font-weight-bold">Đang có sẵn</p>
                    <h5 class="font-weight-bolder mb-0 text-success">@Model.Products.Available</h5>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6 mb-3">
            <div class="card">
                <div class="card-body p-3">
                    <p class="text-sm mb-0 text-uppercase font-weight-bold">Cho thuê</p>
                    <h5 class="font-weight-bolder mb-0 text-info">@Model.Products.ForRent</h5>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6 mb-3">
            <div class="card">
                <div class="card-body p-3">
                    <p class="text-sm mb-0 text-uppercase font-weight-bold">Bán</p>
                    <h5 class="font-weight-bolder mb-0 text-warning">@Model.Products.ForSale</h5>
                </div>
            </div>
        </div>
    </div>

    <!-- Rentals Statistics -->
    <div class="row mb-4">
        <div class="col-12">
            <h5 class="text-primary mb-3"><i class="fas fa-handshake"></i> Đơn thuê</h5>
        </div>
        <div class="col-xl-2 col-sm-6 mb-3">
            <div class="card">
                <div class="card-body p-3">
                    <p class="text-sm mb-0 text-uppercase font-weight-bold">Tổng</p>
                    <h5 class="font-weight-bolder mb-0">@Model.Rentals.Total</h5>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-sm-6 mb-3">
            <div class="card">
                <div class="card-body p-3">
                    <p class="text-sm mb-0 text-uppercase font-weight-bold">Pending</p>
                    <h5 class="font-weight-bolder mb-0 text-warning">@Model.Rentals.Pending</h5>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-sm-6 mb-3">
            <div class="card">
                <div class="card-body p-3">
                    <p class="text-sm mb-0 text-uppercase font-weight-bold">Confirmed</p>
                    <h5 class="font-weight-bolder mb-0 text-info">@Model.Rentals.Confirmed</h5>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-sm-6 mb-3">
            <div class="card">
                <div class="card-body p-3">
                    <p class="text-sm mb-0 text-uppercase font-weight-bold">In Progress</p>
                    <h5 class="font-weight-bolder mb-0 text-primary">@Model.Rentals.InProgress</h5>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-sm-6 mb-3">
            <div class="card">
                <div class="card-body p-3">
                    <p class="text-sm mb-0 text-uppercase font-weight-bold">Completed</p>
                    <h5 class="font-weight-bolder mb-0 text-success">@Model.Rentals.Completed</h5>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-sm-6 mb-3">
            <div class="card">
                <div class="card-body p-3">
                    <p class="text-sm mb-0 text-uppercase font-weight-bold">Cancelled</p>
                    <h5 class="font-weight-bolder mb-0 text-danger">@Model.Rentals.Cancelled</h5>
                </div>
            </div>
        </div>
    </div>

    <!-- Sale Orders & Payments -->
    <div class="row mb-4">
        <div class="col-xl-6">
            <div class="card">
                <div class="card-header pb-0">
                    <h6><i class="fas fa-shopping-cart"></i> Đơn mua</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-4 text-center">
                            <p class="text-sm mb-0">Tổng</p>
                            <h4 class="font-weight-bolder">@Model.SaleOrders.Total</h4>
                        </div>
                        <div class="col-4 text-center">
                            <p class="text-sm mb-0">Pending</p>
                            <h4 class="font-weight-bolder text-warning">@Model.SaleOrders.Pending</h4>
                        </div>
                        <div class="col-4 text-center">
                            <p class="text-sm mb-0">Completed</p>
                            <h4 class="font-weight-bolder text-success">@Model.SaleOrders.Completed</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="card">
                <div class="card-header pb-0">
                    <h6><i class="fas fa-credit-card"></i> Thanh toán</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-4 text-center">
                            <p class="text-sm mb-0">Tổng</p>
                            <h4 class="font-weight-bolder">@Model.Payments.Total</h4>
                        </div>
                        <div class="col-4 text-center">
                            <p class="text-sm mb-0">Completed</p>
                            <h4 class="font-weight-bolder text-success">@Model.Payments.Completed</h4>
                        </div>
                        <div class="col-4 text-center">
                            <p class="text-sm mb-0">Pending</p>
                            <h4 class="font-weight-bolder text-warning">@Model.Payments.Pending</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Revenue Statistics -->
    <div class="row">
        <div class="col-12">
            <h5 class="text-primary mb-3"><i class="fas fa-dollar-sign"></i> Doanh thu</h5>
        </div>
        <div class="col-xl-3 col-sm-6 mb-3">
            <div class="card bg-gradient-success">
                <div class="card-body p-3 text-white">
                    <p class="text-sm mb-0 text-uppercase font-weight-bold opacity-7">Doanh thu thuê</p>
                    <h5 class="font-weight-bolder mb-0 text-white">@Model.Revenue.TotalRentalRevenue.ToString("N0") đ</h5>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6 mb-3">
            <div class="card bg-gradient-info">
                <div class="card-body p-3 text-white">
                    <p class="text-sm mb-0 text-uppercase font-weight-bold opacity-7">Doanh thu bán</p>
                    <h5 class="font-weight-bolder mb-0 text-white">@Model.Revenue.TotalSaleRevenue.ToString("N0") đ</h5>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6 mb-3">
            <div class="card bg-gradient-warning">
                <div class="card-body p-3 text-white">
                    <p class="text-sm mb-0 text-uppercase font-weight-bold opacity-7">Tổng hoa hồng</p>
                    <h5 class="font-weight-bolder mb-0 text-white">@Model.Revenue.TotalCommission.ToString("N0") đ</h5>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6 mb-3">
            <div class="card bg-gradient-primary">
                <div class="card-body p-3 text-white">
                    <p class="text-sm mb-0 text-uppercase font-weight-bold opacity-7">Số dư Admin</p>
                    <h5 class="font-weight-bolder mb-0 text-white">@Model.Revenue.AdminBalance.ToString("N0") đ</h5>
                </div>
            </div>
        </div>
    </div>
</div>

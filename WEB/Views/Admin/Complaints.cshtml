@model List<WEB.Models.ComplaintViewModel>
@{
    ViewData["Title"] = "Quản lý Khiếu nại";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    // Summary stats
    var allCount = Model.Count;
    var pendingCount = Model.Count(c => c.Status == "Pending");
    var resolvingCount = Model.Count(c => c.Status == "Resolving");
    var resolvedCount = Model.Count(c => c.Status == "Resolved");
    var rejectedCount = Model.Count(c => c.Status == "Rejected");
}

<div class="lm-admin-wrapper">

    <!-- Header -->
    <div class="lm-page-header">
        <div class="lm-breadcrumb">UTE Rent Admin</div>
        <h1 class="lm-page-title">Quản lý Khiếu nại</h1>
        <p class="lm-page-subtitle">Phân xử và giải quyết các khiếu nại tranh chấp giữa người thuê và chủ sản phẩm để đảm bảo công bằng.</p>
    </div>

    <!-- Stat cards -->
    <div class="lm-stats-grid">
        <div class="lm-stat-card">
            <div class="lm-stat-top">
                <div class="lm-stat-icon" style="background:#eef2ff; color:#4f46e5;">
                    <i class="fas fa-balance-scale"></i>
                </div>
            </div>
            <div class="lm-stat-label">Tổng khiếu nại</div>
            <div class="lm-stat-value">@allCount</div>
            <div class="lm-stat-border" style="background:#4f46e5;"></div>
        </div>

        <div class="lm-stat-card">
            <div class="lm-stat-top">
                <div class="lm-stat-icon" style="background:var(--badge-yellow-bg); color:var(--badge-yellow-text);">
                    <i class="fas fa-hourglass-start"></i>
                </div>
            </div>
            <div class="lm-stat-label">Đang chờ xử lý</div>
            <div class="lm-stat-value">@pendingCount</div>
            <div class="lm-stat-border" style="background:var(--badge-yellow-text);"></div>
        </div>

        <div class="lm-stat-card">
            <div class="lm-stat-top">
                <div class="lm-stat-icon" style="background:var(--badge-blue-bg); color:var(--badge-blue-text);">
                    <i class="fas fa-spinner fa-spin"></i>
                </div>
            </div>
            <div class="lm-stat-label">Đang giải quyết</div>
            <div class="lm-stat-value">@resolvingCount</div>
            <div class="lm-stat-border" style="background:var(--badge-blue-text);"></div>
        </div>

        <div class="lm-stat-card">
            <div class="lm-stat-top">
                <div class="lm-stat-icon" style="background:var(--badge-green-bg); color:var(--badge-green-text);">
                    <i class="fas fa-check-circle"></i>
                </div>
            </div>
            <div class="lm-stat-label">Đã hoàn tất</div>
            <div class="lm-stat-value">@(resolvedCount + rejectedCount)</div>
            <div class="lm-stat-border" style="background:var(--badge-green-text);"></div>
        </div>
    </div>

    <!-- Controls (Tabs & Search) -->
    <div class="lm-controls-row">
        <div class="lm-tabs">
            <button class="lm-tab active" onclick="setActiveTab(this, 'all')">
                Tất cả <span class="lm-tab-count">@allCount</span>
            </button>
            <button class="lm-tab" onclick="setActiveTab(this, 'Pending')">
                Chờ xử lý <span class="lm-tab-count">@pendingCount</span>
            </button>
            <button class="lm-tab" onclick="setActiveTab(this, 'Resolving')">
                Đang xử lý <span class="lm-tab-count">@resolvingCount</span>
            </button>
            <button class="lm-tab" onclick="setActiveTab(this, 'Resolved')">
                Đã giải quyết <span class="lm-tab-count">@resolvedCount</span>
            </button>
            <button class="lm-tab" onclick="setActiveTab(this, 'Rejected')">
                Đã từ chối <span class="lm-tab-count">@rejectedCount</span>
            </button>
        </div>

        <div class="lm-search-box">
            <i class="fas fa-search"></i>
            <input type="text" id="lmSearchInput" placeholder="Tìm ID, lý do, tiêu đề..." />
        </div>
    </div>

    <!-- Main Table Panel -->
    <div class="lm-table-card">
        @if (Model.Any())
        {
            <div class="lm-table-responsive">
                <table class="lm-table">
                    <thead>
                        <tr>
                            <th style="width: 100px;">MÃ KN</th>
                            <th>ĐƠN THUÊ & NGƯỜI GỬI</th>
                            <th style="width: 35%;">NỘI DUNG KHIẾU NẠI</th>
                            <th>TRẠNG THÁI</th>
                            <th>HÀNH ĐỘNG</th>
                        </tr>
                    </thead>
                    <tbody id="lmTableBody">
                        @foreach (var complaint in Model)
                        {
                            var badgeClass = complaint.Status switch
                            {
                                "Pending" => "lm-badge-yellow",
                                "Resolving" => "lm-badge-blue",
                                "Resolved" => "lm-badge-green",
                                "Rejected" => "lm-badge-red",
                                _ => "lm-badge-yellow"
                            };
                            var statusText = complaint.Status switch
                            {
                                "Pending" => "Đang chờ",
                                "Resolving" => "Đang xử lý",
                                "Resolved" => "Đã giải quyết",
                                "Rejected" => "Bị từ chối",
                                _ => complaint.Status
                            };

                            <tr class="lm-row" data-status="@complaint.Status">
                                <td>
                                    <span class="lm-id">#CMP-@complaint.ComplaintId.ToString("D4")</span>
                                </td>
                                <td>
                                    <div class="lm-order-ref">
                                        <a href="/Admin/Rentals?search=@complaint.RentalId" class="lm-order-link">
                                            <i class="fas fa-shopping-bag"></i> Đơn thuê #ORD-@complaint.RentalId.ToString("D4")
                                        </a>
                                    </div>
                                    <div class="lm-user-ref">User ID: <strong>@complaint.UserId</strong></div>
                                    <div class="lm-date-ref">Ngày gửi: @complaint.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                </td>
                                <td>
                                    <span class="lm-reason-tag">@complaint.Reason</span>
                                    <div class="lm-c-title">@complaint.Title</div>
                                    <div class="lm-c-desc">@complaint.Description</div>

                                    @if (!string.IsNullOrEmpty(complaint.ImageUrl))
                                    {
                                        var images = complaint.ImageUrl.Split(';', StringSplitOptions.RemoveEmptyEntries);
                                        <div class="lm-evidence-area">
                                            @if (images.Length > 1)
                                            {
                                                <div class="lm-evidence-item">
                                                    <span class="lm-evidence-lbl green"><i class="fas fa-camera"></i> 1. Lúc cho thuê</span>
                                                    <a href="@images[0]" target="_blank" class="lm-evidence-link"><i class="far fa-eye"></i> Xem ảnh</a>
                                                </div>
                                                <div class="lm-evidence-item">
                                                    <span class="lm-evidence-lbl orange"><i class="fas fa-truck-pickup"></i> 2. Lúc lấy đồ</span>
                                                    <a href="@images[1]" target="_blank" class="lm-evidence-link"><i class="far fa-eye"></i> Xem ảnh/video</a>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="lm-evidence-item">
                                                    <a href="@complaint.ImageUrl" target="_blank" class="lm-evidence-link"><i class="fas fa-image"></i> Xem ảnh bằng chứng</a>
                                                </div>
                                            }
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="lm-badge @badgeClass">@statusText</span>
                                </td>
                                <td>
                                    <div class="lm-actions-wrapper">
                                        @if (complaint.Status == "Pending")
                                        {
                                            <button type="button" class="lm-btn lm-btn-primary" onclick="updateComplaintStatus(@complaint.ComplaintId, 'Resolving')">
                                                <i class="fas fa-spinner"></i> Tiếp nhận
                                            </button>
                                            <button type="button" class="lm-btn lm-btn-danger" onclick="updateComplaintStatus(@complaint.ComplaintId, 'Rejected')">
                                                <i class="fas fa-ban"></i> Từ chối
                                            </button>
                                        }
                                        else if (complaint.Status == "Resolving")
                                        {
                                            <button type="button" class="lm-btn lm-btn-success" onclick="openResolveModal(@complaint.ComplaintId, @(complaint.Rental?.TotalPrice ?? 0), @(complaint.Rental?.DepositAmount ?? 0))">
                                                <i class="fas fa-gavel"></i> Phân xử
                                            </button>
                                            <button type="button" class="lm-btn lm-btn-danger" onclick="updateComplaintStatus(@complaint.ComplaintId, 'Rejected')">
                                                <i class="fas fa-ban"></i> Từ chối
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="lm-action-done">
                                                <i class="fas fa-check-double"></i> Đã hoàn tất xử lý
                                            </span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- Empty state -->
        <div class="lm-empty" id="lmEmptyState" style="@(Model.Any() ? "display:none;" : "")">
            <i class="fas fa-balance-scale-left"></i>
            <p>Không tìm thấy khiếu nại nào phù hợp</p>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

<!-- Modal Phân xử (Thừa kế cấu trúc Bootstrap nhưng ghi đè style nội bộ) -->
<div class="modal fade" id="resolveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content lm-modal-content">
            <div class="lm-modal-header">
                <h5 class="lm-modal-title">
                    <i class="fas fa-gavel"></i> Phân xử & Bồi thường
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="lm-modal-body">
                <input type="hidden" id="resolveComplaintId" />

                <div class="lm-alert-warning">
                    <div class="alert-title"><i class="fas fa-exclamation-triangle"></i> LƯU Ý KHI PHÂN XỬ</div>
                    <ul>
                        <li>Đơn <b>InProgress</b>: Hệ thống đang giữ cả Tiền thuê + Tiền cọc.</li>
                        <li>Đơn <b>Active / Returned</b>: Hệ thống chỉ giữ Tiền cọc.</li>
                    </ul>
                </div>

                <div class="lm-modal-stats">
                    <div class="stat-col">
                        <span class="lbl">TIỀN THUÊ</span>
                        <strong id="calcRentalPriceText">0đ</strong>
                    </div>
                    <div class="stat-col">
                        <span class="lbl">TIỀN ĐẶT CỌC</span>
                        <strong id="calcDepositPriceText">0đ</strong>
                    </div>
                </div>

                <div class="lm-modal-section">
                    <label class="lm-form-label">Bên chịu trách nhiệm chính</label>
                    <div class="lm-radio-group">
                        <input type="radio" class="btn-check" name="faultParty" id="faultOwner" autocomplete="off" checked onchange="calculateArbitration()">
                        <label class="lm-radio-btn owner" for="faultOwner">
                            <i class="fas fa-store"></i> Chủ đồ có lỗi
                        </label>

                        <input type="radio" class="btn-check" name="faultParty" id="faultRenter" autocomplete="off" onchange="calculateArbitration()">
                        <label class="lm-radio-btn renter" for="faultRenter">
                            <i class="fas fa-user"></i> Khách thuê có lỗi
                        </label>
                    </div>
                </div>

                <div class="lm-modal-section">
                    <label class="lm-form-label">Mức độ thiệt hại / Bồi thường</label>
                    <div class="lm-percent-presets">
                        <button type="button" onclick="setPresetPercent(20)">20% (Nhẹ)</button>
                        <button type="button" onclick="setPresetPercent(50)">50% (Vừa)</button>
                        <button type="button" onclick="setPresetPercent(100)">100% (Tối đa)</button>
                    </div>

                    <div class="lm-slider-box">
                        <div class="slider-head">
                            <span>Tỷ lệ phân xử bồi thường:</span>
                            <strong id="sliderValLabel">50%</strong>
                        </div>
                        <input type="range" class="form-range lm-range" id="calcPercentSlider" min="0" max="100" value="50" oninput="calculateArbitration()">
                    </div>
                </div>

                <div class="lm-preview-box">
                    <div class="preview-head"><i class="fas fa-calculator"></i> Đề xuất phân xử tự động</div>
                    <div class="preview-row">
                        <span>Chuyển cho Chủ đồ:</span>
                        <strong id="previewOwnerComp">0đ</strong>
                    </div>
                    <div class="preview-row">
                        <span>Hoàn cho Khách thuê:</span>
                        <strong class="text-green" id="previewRenterRefund">0đ</strong>
                    </div>
                </div>

                <div class="lm-modal-section">
                    <label class="lm-switch">
                        <input type="checkbox" id="manualOverrideSwitch" onchange="toggleManualInputs()">
                        <span class="slider round"></span>
                        <span class="lbl">Chỉnh sửa thủ công số tiền bồi thường</span>
                    </label>

                    <div id="manualInputsArea" class="lm-manual-inputs" style="display: none;">
                        <div class="input-col">
                            <label>Tiền CHỦ ĐỒ (VNĐ)</label>
                            <input type="number" id="ownerCompInput" value="0">
                        </div>
                        <div class="input-col">
                            <label>Tiền NGƯỜI THUÊ (VNĐ)</label>
                            <input type="number" id="renterRefInput" value="0">
                        </div>
                    </div>
                </div>

                <div class="lm-modal-section" style="margin-bottom:0;">
                    <label class="lm-form-label">Ghi chú của Admin</label>
                    <textarea class="lm-textarea" id="adminNotesInput" rows="3" placeholder="Nhập lý do phân xử..."></textarea>
                </div>
            </div>

            <div class="lm-modal-footer">
                <button type="button" class="lm-btn lm-btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="lm-btn lm-btn-primary" onclick="submitResolve()">Xác nhận Giải quyết</button>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --bg-body: #f7f5f2;
        --card-bg: #ffffff;
        --text-main: #2b3a30;
        --text-muted: #8b9690;
        --primary-green: #3f5947;
        --primary-green-hover: #324738;
        --primary-brown: #8b5a3c;
        --primary-brown-hover: #734a30;
        --border-color: #f0ebe1;
        --badge-green-bg: #e6f0e9;
        --badge-green-text: #2f5c3f;
        --badge-yellow-bg: #fdf3e7;
        --badge-yellow-text: #b86e24;
        --badge-blue-bg: #e0f2fe;
        --badge-blue-text: #0284c7;
        --badge-red-bg: #fee2e2;
        --badge-red-text: #dc2626;
    }

    .lm-admin-wrapper {
        font-family: 'Inter', sans-serif;
        color: var(--text-main);
        max-width: 1400px;
        margin: 0 auto;
    }

    /* Header */
    .lm-page-header {
        margin-bottom: 25px;
    }

    .lm-breadcrumb {
        font-size: 0.75rem;
        font-weight: 800;
        color: var(--primary-green);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 5px;
    }

    .lm-page-title {
        font-size: 1.8rem;
        font-weight: 800;
        color: var(--text-main);
        margin: 0 0 5px 0;
    }

    .lm-page-subtitle {
        font-size: 0.9rem;
        color: var(--text-muted);
        max-width: 600px;
        margin: 0;
    }

    /* Stats Grid */
    .lm-stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 30px;
    }

    .lm-stat-card {
        background: var(--card-bg);
        border-radius: 16px;
        padding: 20px;
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
        position: relative;
        overflow: hidden;
        transition: 0.2s;
    }

        .lm-stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.04);
        }

    .lm-stat-top {
        margin-bottom: 10px;
    }

    .lm-stat-icon {
        width: 45px;
        height: 45px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .lm-stat-label {
        font-size: 0.8rem;
        color: var(--text-muted);
        font-weight: 600;
        margin-bottom: 5px;
        text-transform: uppercase;
    }

    .lm-stat-value {
        font-size: 2rem;
        font-weight: 800;
        color: var(--text-main);
        line-height: 1;
    }

    .lm-stat-border {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 4px;
    }

    /* Controls */
    .lm-controls-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 15px;
    }

    .lm-tabs {
        display: flex;
        gap: 10px;
        background: white;
        padding: 5px;
        border-radius: 50px;
        border: 1px solid var(--border-color);
    }

    .lm-tab {
        background: transparent;
        border: none;
        padding: 8px 16px;
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-muted);
        cursor: pointer;
        transition: 0.2s;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .lm-tab:hover {
            color: var(--text-main);
        }

        .lm-tab.active {
            background: var(--primary-green);
            color: white;
        }

    .lm-tab-count {
        font-size: 0.7rem;
        font-weight: 800;
        padding: 2px 8px;
        border-radius: 50px;
        background: #f1f5f9;
        color: var(--text-muted);
    }

    .lm-tab.active .lm-tab-count {
        background: rgba(255,255,255,0.2);
        color: white;
    }

    .lm-search-box {
        position: relative;
        width: 300px;
    }

        .lm-search-box i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
        }

        .lm-search-box input {
            width: 100%;
            padding: 10px 15px 10px 40px;
            border-radius: 50px;
            border: 1px solid var(--border-color);
            font-size: 0.85rem;
            outline: none;
            transition: 0.2s;
        }

            .lm-search-box input:focus {
                border-color: var(--primary-brown);
            }

    /* Table */
    .lm-table-card {
        background: white;
        border-radius: 20px;
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
        overflow: hidden;
    }

    .lm-table-responsive {
        overflow-x: auto;
    }

    .lm-table {
        width: 100%;
        border-collapse: collapse;
    }

        .lm-table th {
            padding: 15px 20px;
            text-align: left;
            font-size: 0.75rem;
            font-weight: 800;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 2px solid var(--border-color);
            background: #fafafa;
            white-space: nowrap;
        }

        .lm-table td {
            padding: 20px;
            border-bottom: 1px solid var(--border-color);
            vertical-align: top;
        }

        .lm-table tr:last-child td {
            border-bottom: none;
        }

        .lm-table tr:hover td {
            background: #fdfaf6;
        }

    .lm-id {
        font-weight: 800;
        color: var(--primary-brown);
        font-size: 0.9rem;
    }

    .lm-order-ref {
        margin-bottom: 8px;
    }

    .lm-order-link {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--primary-green);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

        .lm-order-link:hover {
            text-decoration: underline;
        }

    .lm-user-ref {
        font-size: 0.85rem;
        color: var(--text-main);
        margin-bottom: 2px;
    }

    .lm-date-ref {
        font-size: 0.8rem;
        color: var(--text-muted);
    }

    .lm-reason-tag {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 800;
        background: var(--badge-red-bg);
        color: var(--badge-red-text);
        margin-bottom: 8px;
        text-transform: uppercase;
    }

    .lm-c-title {
        font-weight: 800;
        font-size: 1rem;
        color: var(--text-main);
        margin-bottom: 5px;
    }

    .lm-c-desc {
        font-size: 0.85rem;
        color: var(--text-muted);
        line-height: 1.5;
        margin-bottom: 12px;
    }

    .lm-evidence-area {
        background: #fafafa;
        border: 1px dashed #d1d5db;
        border-radius: 12px;
        padding: 10px 15px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .lm-evidence-item {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .lm-evidence-lbl {
        font-size: 0.7rem;
        font-weight: 800;
        padding: 3px 8px;
        border-radius: 6px;
    }

        .lm-evidence-lbl.green {
            background: var(--badge-green-bg);
            color: var(--badge-green-text);
        }

        .lm-evidence-lbl.orange {
            background: #ffedd5;
            color: #9a3412;
        }

    .lm-evidence-link {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--primary-brown);
        text-decoration: none;
    }

        .lm-evidence-link:hover {
            text-decoration: underline;
        }

    .lm-badge {
        padding: 6px 12px;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 800;
        display: inline-block;
        white-space: nowrap;
    }

    .lm-badge-yellow {
        background: var(--badge-yellow-bg);
        color: var(--badge-yellow-text);
    }

    .lm-badge-blue {
        background: var(--badge-blue-bg);
        color: var(--badge-blue-text);
    }

    .lm-badge-green {
        background: var(--badge-green-bg);
        color: var(--badge-green-text);
    }

    .lm-badge-red {
        background: var(--badge-red-bg);
        color: var(--badge-red-text);
    }


</style>

@section Scripts {
    <script>
        // ── Client-side filter and search ─────────────────────
        let currentFilter = 'all';
        let searchQuery = '';

        function filterComplaints() {
            const rows = document.querySelectorAll('.lm-row');
            let visibleCount = 0;

            rows.forEach(row => {
                const status = row.getAttribute('data-status');
                const textContent = row.textContent.toLowerCase();

                const matchesStatus = (currentFilter === 'all') || (status === currentFilter);
                const matchesSearch = textContent.includes(searchQuery.toLowerCase());

                if (matchesStatus && matchesSearch) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            const emptyState = document.getElementById('lmEmptyState');
            if (emptyState) {
                emptyState.style.display = visibleCount === 0 ? '' : 'none';
            }
        }

        document.getElementById('lmSearchInput').addEventListener('input', function(e) {
            searchQuery = e.target.value;
            filterComplaints();
        });

        function setActiveTab(tabElement, status) {
            document.querySelectorAll('.lm-tab').forEach(t => t.classList.remove('active'));
            tabElement.classList.add('active');
            currentFilter = status;
            filterComplaints();
        }

        // ── Status updates via Fetch API ──────────────────────
        function updateComplaintStatus(id, newStatus) {
            let confirmMsg = 'Bạn có chắc chắn muốn cập nhật trạng thái khiếu nại này?';
            if (newStatus === 'Resolving') {
                confirmMsg = 'Tiếp nhận xử lý khiếu nại này? Trạng thái sẽ đổi sang "Đang xử lý".';
            } else if (newStatus === 'Rejected') {
                confirmMsg = 'Từ chối khiếu nại này? Thao tác không thể hoàn tác.';
            }

            if (!confirm(confirmMsg)) return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch('/Admin/UpdateComplaintStatus', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: `complaintId=${id}&status=${newStatus}&__RequestVerificationToken=${token}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('Cập nhật trạng thái thành công!');
                    location.reload();
                } else {
                    alert('Lỗi: ' + data.message);
                }
            })
            .catch(err => {
                alert('Đã xảy ra lỗi khi kết nối với máy chủ.');
                console.error(err);
            });
        }

        // ── Modal arbitration handling ────────────────────────
        let bsResolveModal = null;
        let currentRentalPrice = 0;
        let currentDepositPrice = 0;

        function openResolveModal(id, rentalPrice, depositPrice) {
            document.getElementById('resolveComplaintId').value = id;
            currentRentalPrice = rentalPrice;
            currentDepositPrice = depositPrice;

            // Reset controls
            document.getElementById('faultOwner').checked = true;
            document.getElementById('calcPercentSlider').value = 50;
            document.getElementById('sliderValLabel').innerText = '50%';
            document.getElementById('manualOverrideSwitch').checked = false;
            document.getElementById('manualInputsArea').style.display = 'none';
            document.getElementById('adminNotesInput').value = '';

            // Update static info
            document.getElementById('calcRentalPriceText').innerText = rentalPrice.toLocaleString('vi-VN') + 'đ';
            document.getElementById('calcDepositPriceText').innerText = depositPrice.toLocaleString('vi-VN') + 'đ';

            calculateArbitration();

            const modalEl = document.getElementById('resolveModal');
            bsResolveModal = new bootstrap.Modal(modalEl);
            bsResolveModal.show();
        }

        function setPresetPercent(percent) {
            document.getElementById('calcPercentSlider').value = percent;
            calculateArbitration();
        }

        function calculateArbitration() {
            const isOwnerFault = document.getElementById('faultOwner').checked;
            const percent = parseFloat(document.getElementById('calcPercentSlider').value);

            document.getElementById('sliderValLabel').innerText = percent + '%';

            let renterRefund = 0;
            let ownerComp = 0;

            if (isOwnerFault) {
                renterRefund = currentDepositPrice + (currentRentalPrice * (percent / 100));
                ownerComp = - (currentRentalPrice * (percent / 100));
            } else {
                ownerComp = currentDepositPrice * (percent / 100);
                renterRefund = currentDepositPrice - ownerComp;
            }

            renterRefund = Math.round(renterRefund);
            ownerComp = Math.round(ownerComp);

            if (!document.getElementById('manualOverrideSwitch').checked) {
                document.getElementById('ownerCompInput').value = ownerComp;
                document.getElementById('renterRefInput').value = renterRefund;
            }

            document.getElementById('previewOwnerComp').innerText = (ownerComp >= 0 ? '+' : '') + ownerComp.toLocaleString('vi-VN') + 'đ';
            document.getElementById('previewRenterRefund').innerText = renterRefund.toLocaleString('vi-VN') + 'đ';
        }

        function toggleManualInputs() {
            const override = document.getElementById('manualOverrideSwitch').checked;
            const area = document.getElementById('manualInputsArea');
            area.style.display = override ? 'flex' : 'none';

            if (!override) calculateArbitration();
        }

        function submitResolve() {
            const id = document.getElementById('resolveComplaintId').value;
            const ownerComp = document.getElementById('ownerCompInput').value;
            const renterRef = document.getElementById('renterRefInput').value;
            const adminNotes = document.getElementById('adminNotesInput').value;
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            if (!adminNotes.trim()) {
                alert("Vui lòng nhập ghi chú phân xử của Admin.");
                return;
            }

            fetch('/Admin/ResolveComplaint', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: `complaintId=${id}&ownerCompensation=${ownerComp}&renterRefund=${renterRef}&adminNotes=${encodeURIComponent(adminNotes)}&__RequestVerificationToken=${token}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('Đã phân xử và thực hiện các giao dịch bồi thường thành công!');
                    if (bsResolveModal) bsResolveModal.hide();
                    location.reload();
                } else {
                    alert('Lỗi phân xử: ' + data.message);
                }
            })
            .catch(err => {
                alert('Đã xảy ra lỗi khi kết nối với máy chủ.');
                console.error(err);
            });
        }
    </script>
}
@model List<AdminCategoryViewModel>
@{
    ViewData["Title"] = "Quản lý Danh mục";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header pb-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Danh sách Danh mục</h5>
                        <span class="badge bg-primary">Tổng: @Model.Count danh mục</span>
                    </div>
                </div>

                <div class="card-body px-0 pt-0 pb-2">
                    @if (Model.Any())
                    {
                        <div class="table-responsive p-0">
                            <table class="table align-items-center mb-0">
                                <thead>
                                    <tr>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">ID</th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Icon</th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Tên danh mục</th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Mô tả</th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">Số sản phẩm</th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">Thứ tự</th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var category in Model.OrderBy(c => c.SortOrder))
                                    {
                                        <tr>
                                            <td>
                                                <p class="text-xs font-weight-bold mb-0">@category.CategoryId</p>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(category.IconUrl))
                                                {
                                                    <img src="@category.IconUrl" class="avatar avatar-sm" alt="icon">
                                                }
                                                else
                                                {
                                                    <i class="fas fa-box text-secondary"></i>
                                                }
                                            </td>
                                            <td>
                                                <h6 class="mb-0 text-sm">@category.CategoryName</h6>
                                            </td>
                                            <td>
                                                <p class="text-xs mb-0">@category.Description</p>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge badge-sm bg-info">@category.ProductCount sản phẩm</span>
                                            </td>
                                            <td class="text-center">
                                                <p class="text-xs font-weight-bold mb-0">@category.SortOrder</p>
                                            </td>
                                            <td class="text-center">
                                                @if (category.IsActive)
                                                {
                                                    <span class="badge badge-sm bg-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-sm bg-secondary">Inactive</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-folder-open fa-3x text-secondary mb-3"></i>
                            <p class="text-secondary">Không có danh mục nào</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

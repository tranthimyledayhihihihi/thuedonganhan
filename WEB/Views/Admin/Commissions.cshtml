@model WEB.Models.AdminCommissionsViewModel
@{
    ViewData["Title"] = "Quản lý hoa hồng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <!-- Admin Balance Card -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card bg-gradient-primary text-white">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h4 class="mb-2"><i class="fas fa-wallet"></i> Số dư ví Admin</h4>
                            <h2 class="mb-0 fw-bold">@Model.AdminBalance.ToString("N0")đ</h2>
                            <p class="mb-0 mt-2 opacity-75">Tổng hoa hồng 5% từ các đơn thuê đã giao hàng</p>
                        </div>
                        <div class="col-md-4 text-end">
                            <i class="fas fa-chart-line fa-5x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Commissions Table -->
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Lịch sử hoa hồng (@Model.Pagination.TotalItems giao dịch)</h5>
        </div>
        <div class="card-body">
            @if (Model.Items.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Mô tả</th>
                                <th>Số tiền</th>
                                <th>Loại</th>
                                <th>Đơn thuê</th>
                                <th>Thời gian</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var commission in Model.Items)
                            {
                                <tr>
                                    <td><strong>#@commission.TransactionId</strong></td>
                                    <td>@commission.Description</td>
                                    <td class="text-success fw-bold">
                                        <i class="fas fa-arrow-up"></i> +@commission.Amount.ToString("N0")đ
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@commission.Type</span>
                                    </td>
                                    <td>
                                        @if (commission.ReferenceId.HasValue)
                                        {
                                            <span class="badge bg-secondary">#@commission.ReferenceId</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>@commission.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.Pagination.TotalPages > 1)
                {
                    <nav class="mt-4">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(!Model.Pagination.HasPreviousPage ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Commissions", new { page = Model.Pagination.CurrentPage - 1 })">
                                    Trước
                                </a>
                            </li>

                            @for (int i = 1; i <= Model.Pagination.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.Pagination.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Commissions", new { page = i })">@i</a>
                                </li>
                            }

                            <li class="page-item @(!Model.Pagination.HasNextPage ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Commissions", new { page = Model.Pagination.CurrentPage + 1 })">
                                    Sau
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
                    <p class="text-muted">Chưa có giao dịch hoa hồng nào</p>
                </div>
            }
        </div>
    </div>

    <!-- Info Box -->
    <div class="card mt-4 border-info">
        <div class="card-body">
            <h5 class="card-title"><i class="fas fa-info-circle text-info"></i> Thông tin về hoa hồng</h5>
            <ul class="mb-0">
                <li>Hệ thống tự động thu <strong>5% hoa hồng</strong> từ mỗi đơn thuê</li>
                <li>Hoa hồng được tính khi <strong>người cho thuê xác nhận giao hàng</strong></li>
                <li>Người cho thuê nhận <strong>95% giá trị đơn thuê</strong>, Admin nhận <strong>5%</strong></li>
                <li>Tiền cọc không tính hoa hồng, sẽ được hoàn trả khi trả đồ</li>
            </ul>
        </div>
    </div>
</div>

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
</style>

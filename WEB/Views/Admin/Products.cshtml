@model WEB.Models.AdminPagedResult<WEB.Models.AdminProductViewModel>
@{
    ViewData["Title"] = "Quản lý sản phẩm";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var search      = ViewBag.Search as string ?? "";
    var filterCat   = ViewBag.FilterCat as string ?? "all";
    var currentPage = Model.Pagination.CurrentPage;
    int totalProducts   = Model.Pagination.TotalItems;
    int totalRenting    = Model.Items.Count(p => !p.IsAvailable && p.IsApproved);
    int totalOutOfStock = Model.Items.Count(p => p.Quantity == 0);
    decimal todayRev    = Model.Items.Sum(p => p.PricePerDay);
    var categories = Model.Items.Select(p => p.CategoryName)
        .Where(c => !string.IsNullOrEmpty(c)).Distinct().OrderBy(c => c).Take(5).ToList();
}
<style>
.pm-header { display:flex; align-items:flex-start; justify-content:space-between; flex-wrap:wrap; gap:1rem; margin-bottom:1.75rem; }
.pm-header-left h1 { font-size:1.75rem; font-weight:800; color:#111827; margin-bottom:.2rem; }
.pm-header-left p  { font-size:.875rem; color:#6b7280; max-width:420px; }
.pm-header-right   { display:flex; align-items:center; gap:.75rem; flex-wrap:wrap; }
.pm-search-box { position:relative; }
.pm-search-box i { position:absolute; left:.9rem; top:50%; transform:translateY(-50%); color:#9ca3af; font-size:.875rem; }
.pm-search-box input { padding:.6rem 1rem .6rem 2.4rem; border:1.5px solid #e5e7eb; border-radius:10px; width:240px; font-size:.875rem; font-family:inherit; background:#f9fafb; transition:all .2s; }
.pm-search-box input:focus { outline:none; border-color:#4f46e5; background:#fff; box-shadow:0 0 0 3px rgba(79,70,229,.1); width:280px; }
.pm-search-box input::placeholder { color:#9ca3af; }
.pm-btn { display:inline-flex; align-items:center; gap:.4rem; padding:.6rem 1.1rem; border:none; border-radius:10px; font-size:.875rem; font-weight:600; cursor:pointer; font-family:inherit; transition:all .18s; text-decoration:none; }
.pm-btn-primary { background:#4f46e5; color:#fff; box-shadow:0 2px 8px rgba(79,70,229,.3); }
.pm-btn-primary:hover { background:#4338ca; color:#fff; }
.pm-btn-outline { background:#fff; color:#374151; border:1.5px solid #e5e7eb; }
.pm-btn-outline:hover { border-color:#4f46e5; color:#4f46e5; }
.pm-btn-sm { padding:.35rem .75rem; font-size:.78rem; }
.pm-btn-approve { background:#dcfce7; color:#16a34a; }
.pm-btn-approve:hover { background:#16a34a; color:#fff; }
.pm-btn-edit { background:#eef2ff; color:#4f46e5; }
.pm-btn-edit:hover { background:#4f46e5; color:#fff; }
.pm-btn-danger { background:#fee2e2; color:#dc2626; }
.pm-btn-danger:hover { background:#dc2626; color:#fff; }
.pm-btn-bulk-del { background:#dc2626; color:#fff; }
.pm-btn-bulk-del:hover { background:#b91c1c; }
</style>
<style>
.pm-stats { display:grid; grid-template-columns:repeat(4,1fr); gap:1rem; margin-bottom:1.75rem; }
.pm-stat { background:#fff; border-radius:14px; border:1px solid #e5e7eb; padding:1.25rem 1.4rem; box-shadow:0 1px 4px rgba(0,0,0,.04); transition:box-shadow .2s,transform .2s; display:flex; align-items:center; gap:1rem; }
.pm-stat:hover { box-shadow:0 6px 18px rgba(0,0,0,.08); transform:translateY(-2px); }
.pm-stat-icon { width:46px; height:46px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:1.15rem; flex-shrink:0; }
.pm-stat-label { font-size:.7rem; font-weight:700; color:#9ca3af; text-transform:uppercase; letter-spacing:.5px; margin-bottom:.3rem; }
.pm-stat-value { font-size:1.75rem; font-weight:800; color:#111827; line-height:1; }
.pm-panel { background:#fff; border-radius:16px; border:1px solid #e5e7eb; box-shadow:0 1px 4px rgba(0,0,0,.05); overflow:hidden; }
.pm-toolbar { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:.75rem; padding:.875rem 1.4rem; border-bottom:1px solid #f3f4f6; }
.pm-tabs { display:flex; gap:.4rem; flex-wrap:wrap; }
.pm-tab { padding:.4rem .9rem; border-radius:20px; font-size:.82rem; font-weight:600; color:#6b7280; cursor:pointer; border:1.5px solid transparent; background:transparent; transition:all .18s; text-decoration:none; white-space:nowrap; }
.pm-tab:hover { color:#4f46e5; background:#eef2ff; }
.pm-tab.active { background:#eef2ff; color:#4f46e5; border-color:#c7d2fe; }
.pm-toolbar-right { font-size:.82rem; color:#6b7280; display:flex; align-items:center; gap:.75rem; }
/* Bulk action bar */
.pm-bulk-bar { display:none; align-items:center; gap:1rem; padding:.75rem 1.4rem; background:#fef3c7; border-bottom:1px solid #fde68a; }
.pm-bulk-bar.visible { display:flex; }
.pm-bulk-info { font-size:.875rem; font-weight:600; color:#92400e; }
/* Checkbox */
.pm-cb { width:16px; height:16px; accent-color:#4f46e5; cursor:pointer; }
/* Table */
.pm-table { width:100%; border-collapse:collapse; }
.pm-table th { font-size:.68rem; font-weight:700; color:#9ca3af; text-transform:uppercase; letter-spacing:.6px; padding:.75rem 1rem; text-align:left; border-bottom:1px solid #f3f4f6; background:#fafafa; white-space:nowrap; }
.pm-table td { padding:.9rem 1rem; border-bottom:1px solid #f9fafb; font-size:.875rem; color:#374151; vertical-align:middle; }
.pm-table tr:last-child td { border-bottom:none; }
.pm-table tr:hover td { background:#fafafa; }
.pm-table tr.selected td { background:#eef2ff; }
.pm-product-cell { display:flex; align-items:center; gap:.875rem; }
.pm-thumb { width:52px; height:52px; border-radius:10px; object-fit:cover; flex-shrink:0; background:#f3f4f6; border:1px solid #e5e7eb; }
.pm-thumb-placeholder { width:52px; height:52px; border-radius:10px; background:linear-gradient(135deg,#eef2ff,#e0e7ff); display:flex; align-items:center; justify-content:center; color:#818cf8; font-size:1.25rem; flex-shrink:0; border:1px solid #e0e7ff; }
.pm-prod-name { font-weight:700; color:#111827; font-size:.9rem; line-height:1.3; }
.pm-prod-desc { font-size:.75rem; color:#9ca3af; margin-top:.15rem; max-width:200px; overflow:hidden; display:-webkit-box; -webkit-line-clamp:1; -webkit-box-orient:vertical; }
.pm-id { font-size:.75rem; color:#9ca3af; font-family:monospace; }
.cat-badge { display:inline-block; padding:.3rem .8rem; border-radius:20px; font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.3px; }
.cat-academic    { background:#ede9fe; color:#6d28d9; }
.cat-electronics { background:#dbeafe; color:#1d4ed8; }
.cat-fashion     { background:#fce7f3; color:#be185d; }
.cat-books       { background:#fef3c7; color:#d97706; }
.cat-other       { background:#f3f4f6; color:#374151; }
.pm-price { font-weight:700; color:#4f46e5; font-size:.95rem; }
.pm-price-unit { font-size:.72rem; color:#9ca3af; font-weight:400; }
.pm-status { display:flex; align-items:center; gap:.45rem; font-size:.82rem; font-weight:600; }
.pm-dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
.dot-available { background:#10b981; }
.dot-rented    { background:#3b82f6; }
.dot-pending   { background:#f59e0b; }
.dot-hidden    { background:#9ca3af; }
.pm-actions { display:flex; gap:.35rem; align-items:center; }
.pm-footer { display:flex; align-items:center; justify-content:space-between; padding:.875rem 1.4rem; border-top:1px solid #f3f4f6; flex-wrap:wrap; gap:.75rem; }
.pm-footer-info { font-size:.82rem; color:#6b7280; }
.pm-pages { display:flex; gap:.35rem; align-items:center; }
.pm-page-btn { min-width:34px; height:34px; padding:0 .5rem; border:1px solid #e5e7eb; border-radius:8px; background:#fff; color:#374151; font-size:.82rem; font-weight:600; cursor:pointer; transition:all .18s; text-decoration:none; display:inline-flex; align-items:center; justify-content:center; }
.pm-page-btn:hover { border-color:#4f46e5; color:#4f46e5; }
.pm-page-btn.active { background:#4f46e5; border-color:#4f46e5; color:#fff; }
.pm-page-btn.disabled { opacity:.35; pointer-events:none; }
.pm-empty { text-align:center; padding:4rem 1rem; color:#9ca3af; }
.pm-empty i { font-size:3rem; margin-bottom:1rem; display:block; }
@@media (max-width:1100px) { .pm-stats { grid-template-columns:repeat(2,1fr); } }
@@media (max-width:640px)  { .pm-stats { grid-template-columns:1fr 1fr; } .pm-header { flex-direction:column; } }
</style>

<!-- Edit Modal styles -->
<style>
.pm-modal-backdrop { position:fixed; inset:0; background:rgba(15,23,42,.45); backdrop-filter:blur(4px); display:none; align-items:center; justify-content:center; z-index:2000; padding:1rem; }
.pm-modal-backdrop.open { display:flex; }
.pm-modal { background:#fff; border-radius:18px; width:100%; max-width:560px; box-shadow:0 20px 50px rgba(0,0,0,.18); animation:pmSlideIn .25s ease; overflow:hidden; }
@@keyframes pmSlideIn { from { transform:translateY(-16px); opacity:0; } to { transform:translateY(0); opacity:1; } }
.pm-modal-header { display:flex; align-items:center; justify-content:space-between; padding:1.25rem 1.5rem; border-bottom:1px solid #f3f4f6; }
.pm-modal-title { font-size:1.05rem; font-weight:700; color:#111827; }
.pm-modal-close { background:none; border:none; font-size:1.4rem; color:#9ca3af; cursor:pointer; line-height:1; padding:.2rem; }
.pm-modal-close:hover { color:#374151; }
.pm-modal-body { padding:1.5rem; }
.pm-modal-footer { display:flex; justify-content:flex-end; gap:.6rem; padding:1rem 1.5rem; border-top:1px solid #f3f4f6; background:#fafafa; }
.pm-field { margin-bottom:1rem; }
.pm-field label { display:block; font-size:.75rem; font-weight:700; color:#6b7280; text-transform:uppercase; letter-spacing:.5px; margin-bottom:.4rem; }
.pm-field input, .pm-field textarea, .pm-field select { width:100%; padding:.65rem .9rem; border:1.5px solid #e5e7eb; border-radius:9px; font-size:.9rem; font-family:inherit; background:#f9fafb; transition:all .2s; }
.pm-field input:focus, .pm-field textarea:focus { outline:none; border-color:#4f46e5; background:#fff; box-shadow:0 0 0 3px rgba(79,70,229,.1); }
.pm-field textarea { resize:vertical; min-height:80px; }
.pm-field-row { display:grid; grid-template-columns:1fr 1fr; gap:.875rem; }
</style>

<!-- Page header -->
<div class="pm-header">
    <div class="pm-header-left">
        <h1>Quản lý sản phẩm</h1>
        <p>Theo dõi và chỉnh sửa kho hàng lưu trữ trong toàn hệ thống UTE Rent.</p>
    </div>
    <div class="pm-header-right">
        <form method="get" asp-action="Products" style="display:flex;gap:.6rem;align-items:center;">
            <div class="pm-search-box">
                <i class="fas fa-search"></i>
                <input type="text" name="search" value="@search" placeholder="Tìm kiếm sản phẩm..." />
                <input type="hidden" name="filterCat" value="@filterCat" />
            </div>
            <button type="submit" class="pm-btn pm-btn-outline">
                <i class="fas fa-filter"></i> Bộ lọc
            </button>
        </form>
        @if (Model.Items.Any(p => !p.IsApproved))
        {
            <form method="post" asp-action="ApproveAllProducts" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="pm-btn pm-btn-primary"
                        onclick="return confirm('Duyệt toàn bộ sản phẩm đang chờ?')">
                    <i class="fas fa-check-double"></i> Duyệt tất cả
                </button>
            </form>
        }
    </div>
</div>

<!-- Stat cards -->
<div class="pm-stats">
    <div class="pm-stat">
        <div class="pm-stat-icon" style="background:#eef2ff;color:#4f46e5;"><i class="fas fa-box"></i></div>
        <div><div class="pm-stat-label">Tổng sản phẩm</div><div class="pm-stat-value">@totalProducts.ToString("N0")</div></div>
    </div>
    <div class="pm-stat">
        <div class="pm-stat-icon" style="background:#dbeafe;color:#2563eb;"><i class="fas fa-handshake"></i></div>
        <div><div class="pm-stat-label">Đang cho thuê</div><div class="pm-stat-value">@totalRenting.ToString("N0")</div></div>
    </div>
    <div class="pm-stat">
        <div class="pm-stat-icon" style="background:#fef3c7;color:#d97706;"><i class="fas fa-exclamation-triangle"></i></div>
        <div><div class="pm-stat-label">Hết hàng</div><div class="pm-stat-value">@totalOutOfStock.ToString("N0")</div></div>
    </div>
    <div class="pm-stat">
        <div class="pm-stat-icon" style="background:#fce7f3;color:#be185d;"><i class="fas fa-coins"></i></div>
        <div>
            <div class="pm-stat-label">Doanh thu ngày</div>
            <div class="pm-stat-value">@(todayRev >= 1_000_000 ? (todayRev/1_000_000m).ToString("0.#")+"M" : todayRev.ToString("N0"))</div>
        </div>
    </div>
</div>

<!-- ✅ FIX: Các form Approve/Delete phải nằm NGOÀI bulkForm vì HTML không cho phép lồng <form> -->
<!-- Các form này sẽ được render ở đây, JS sẽ submit chúng -->
<div id="productFormsContainer"></div>

<!-- Bulk delete form wraps the whole table -->
<form id="bulkForm" method="post" asp-action="DeleteBulkProducts">
    @Html.AntiForgeryToken()
    <input type="hidden" name="search" value="@search" />
    <input type="hidden" name="filterCat" value="@filterCat" />
    <input type="hidden" name="productIds" id="bulkIds" />

    <div class="pm-panel">
        <!-- Toolbar -->
        <div class="pm-toolbar">
            <div class="pm-tabs">
                <a class="pm-tab @(filterCat=="all"?"active":"")" href="@Url.Action("Products",new{search,filterCat="all",page=1})">Tất cả</a>
                @foreach (var cat in categories)
                {
                    <a class="pm-tab @(filterCat==cat?"active":"")" href="@Url.Action("Products",new{search,filterCat=cat,page=1})">@cat</a>
                }
            </div>
            <div class="pm-toolbar-right">
                <span>Hiển thị @Model.Items.Count trong @Model.Pagination.TotalItems</span>
            </div>
        </div>

        <!-- Bulk action bar (hidden until items selected) -->
        <div class="pm-bulk-bar" id="bulkBar">
            <span class="pm-bulk-info"><span id="bulkCount">0</span> sản phẩm đã chọn</span>
            <button type="button" class="pm-btn pm-btn-sm pm-btn-bulk-del" onclick="confirmBulkDelete()">
                <i class="fas fa-trash"></i> Xóa đã chọn
            </button>
            <button type="button" class="pm-btn pm-btn-sm pm-btn-outline" onclick="clearSelection()">
                Bỏ chọn tất cả
            </button>
        </div>

        @if (Model.Items.Any())
        {
            var displayItems = filterCat == "all"
                ? Model.Items
                : Model.Items.Where(p => p.CategoryName == filterCat).ToList();

            <div style="overflow-x:auto;">
                <table class="pm-table">
                    <thead>
                        <tr>
                            <th style="width:40px;">
                                <input type="checkbox" class="pm-cb" id="checkAll" onchange="toggleAll(this)" title="Chọn tất cả" />
                            </th>
                            <th>Product ID</th>
                            <th>Sản phẩm</th>
                            <th>Danh mục</th>
                            <th>Người cho thuê</th>
                            <th>Giá / Ngày</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in displayItems)
                        {
                            var catLower  = product.CategoryName?.ToLower() ?? "";
                            var catClass  = catLower.Contains("academic")||catLower.Contains("học") ? "cat-academic"
                                          : catLower.Contains("electron")||catLower.Contains("điện") ? "cat-electronics"
                                          : catLower.Contains("fashion")||catLower.Contains("thời") ? "cat-fashion"
                                          : catLower.Contains("book")||catLower.Contains("sách") ? "cat-books"
                                          : "cat-other";
                            string statusDot, statusText;
                            if (!product.IsApproved)          { statusDot="dot-pending";   statusText="Chờ duyệt"; }
                            else if (!product.IsAvailable)    { statusDot="dot-rented";    statusText="Đang thuê"; }
                            else if (product.Quantity == 0)   { statusDot="dot-hidden";    statusText="Hết hàng";  }
                            else                              { statusDot="dot-available"; statusText="Available"; }

                            <tr id="row-@product.ProductId">
                                <td>
                                    <input type="checkbox" class="pm-cb row-cb"
                                           value="@product.ProductId"
                                           onchange="updateBulkBar()" />
                                </td>
                                <td><span class="pm-id">#PRD-@product.ProductId.ToString("D4")</span></td>
                                <td>
                                    <div class="pm-product-cell">
                                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                                        {
                                            <img src="@product.ImageUrl" class="pm-thumb" alt="@product.ProductName"
                                                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                            <div class="pm-thumb-placeholder" style="display:none;"><i class="fas fa-image"></i></div>
                                        }
                                        else
                                        {
                                            <div class="pm-thumb-placeholder"><i class="fas fa-image"></i></div>
                                        }
                                        <div>
                                            <div class="pm-prod-name">@product.ProductName</div>
                                            @if (!string.IsNullOrEmpty(product.Description))
                                            {
                                                <div class="pm-prod-desc">@product.Description</div>
                                            }
                                            else if (!string.IsNullOrEmpty(product.Location))
                                            {
                                                <div class="pm-prod-desc"><i class="fas fa-map-marker-alt" style="font-size:.65rem;"></i> @product.Location</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td><span class="cat-badge @catClass">@product.CategoryName</span></td>
                                <td>
                                    <div style="font-weight:600;color:#111827;font-size:.875rem;">@product.OwnerName</div>
                                    <div style="font-size:.75rem;color:#9ca3af;">@product.OwnerEmail</div>
                                </td>
                                <td>
                                    <span class="pm-price">@product.PricePerDay.ToString("N0")đ</span>
                                    <span class="pm-price-unit">/ngày</span>
                                </td>
                                <td>
                                    <div class="pm-status">
                                        <span class="pm-dot @statusDot"></span>@statusText
                                    </div>
                                </td>
                                <td>
                                    <div class="pm-actions">
                                        @if (!product.IsApproved)
                                        {
                                            <!-- ✅ FIX: Nút Approve - submit form nằm ngoài bulkForm qua JS -->
                                            <button type="button" class="pm-btn pm-btn-sm pm-btn-approve" title="Duyệt"
                                                    onclick="submitApproveForm(@product.ProductId)">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        }
                                        <!-- Edit button -->
                                        <button type="button" class="pm-btn pm-btn-sm pm-btn-edit" title="Chỉnh sửa"
                                                onclick="openEditModal(@product.ProductId,'@Html.Raw(product.ProductName.Replace("'","\\'"))','@product.PricePerDay','@product.Deposit','@product.Quantity','@Html.Raw((product.Location??"").Replace("'","\\'"))','@Html.Raw((product.Description??"").Replace("'","\\'"))')">
                                            <i class="fas fa-pen"></i>
                                        </button>
                                        <!-- ✅ FIX: Nút Delete - submit form nằm ngoài bulkForm qua JS -->
                                        <button type="button" class="pm-btn pm-btn-sm pm-btn-danger" title="Xóa"
                                                onclick="if(confirm('Xóa sản phẩm này?')) submitDeleteForm(@product.ProductId)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Footer -->
            <div class="pm-footer">
                <span class="pm-footer-info">
                    Trang @currentPage / @Model.Pagination.TotalPages &nbsp;·&nbsp;
                    @((currentPage-1)*Model.Pagination.PageSize+1)–@Math.Min(currentPage*Model.Pagination.PageSize,Model.Pagination.TotalItems)
                    trong @Model.Pagination.TotalItems sản phẩm
                </span>
                @if (Model.Pagination.TotalPages > 1)
                {
                    <div class="pm-pages">
                        <a class="pm-page-btn @(!Model.Pagination.HasPreviousPage?"disabled":"")"
                           href="@Url.Action("Products",new{page=currentPage-1,search,filterCat})">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                        @{
                            int sp = Math.Max(1, currentPage-2);
                            int ep = Math.Min(Model.Pagination.TotalPages, currentPage+2);
                        }
                        @if (sp > 1)
                        {
                            <a class="pm-page-btn" href="@Url.Action("Products",new{page=1,search,filterCat})">1</a>
                            if (sp > 2) { <span style="color:#9ca3af;padding:0 .2rem;">…</span> }
                        }
                        @for (int i = sp; i <= ep; i++)
                        {
                            <a class="pm-page-btn @(i==currentPage?"active":"")"
                               href="@Url.Action("Products",new{page=i,search,filterCat})">@i</a>
                        }
                        @if (ep < Model.Pagination.TotalPages)
                        {
                            if (ep < Model.Pagination.TotalPages-1) { <span style="color:#9ca3af;padding:0 .2rem;">…</span> }
                            <a class="pm-page-btn" href="@Url.Action("Products",new{page=Model.Pagination.TotalPages,search,filterCat})">@Model.Pagination.TotalPages</a>
                        }
                        <a class="pm-page-btn @(!Model.Pagination.HasNextPage?"disabled":"")"
                           href="@Url.Action("Products",new{page=currentPage+1,search,filterCat})">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="pm-empty">
                <i class="fas fa-box-open"></i>
                <p>Không tìm thấy sản phẩm nào</p>
            </div>
        }
    </div>
</form>

<!-- Edit Modal -->
<div class="pm-modal-backdrop" id="editModal">
    <div class="pm-modal">
        <div class="pm-modal-header">
            <span class="pm-modal-title"><i class="fas fa-pen" style="color:#4f46e5;margin-right:.5rem;"></i>Chỉnh sửa sản phẩm</span>
            <button class="pm-modal-close" onclick="closeEditModal()">×</button>
        </div>
        <form method="post" asp-action="EditProduct" id="editForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="productId" id="editProductId" />
            <input type="hidden" name="search" value="@search" />
            <input type="hidden" name="filterCat" value="@filterCat" />
            <div class="pm-modal-body">
                <div class="pm-field">
                    <label>Tên sản phẩm</label>
                    <input type="text" name="productName" id="editName" required placeholder="Nhập tên sản phẩm..." />
                </div>
                <div class="pm-field-row">
                    <div class="pm-field">
                        <label>Giá thuê / ngày (đ)</label>
                        <input type="number" name="pricePerDay" id="editPrice" min="0" step="1000" required />
                    </div>
                    <div class="pm-field">
                        <label>Tiền cọc (đ)</label>
                        <input type="number" name="deposit" id="editDeposit" min="0" step="1000" required />
                    </div>
                </div>
                <div class="pm-field-row">
                    <div class="pm-field">
                        <label>Số lượng</label>
                        <input type="number" name="quantity" id="editQty" min="0" required />
                    </div>
                    <div class="pm-field">
                        <label>Vị trí</label>
                        <input type="text" name="location" id="editLocation" placeholder="Ký túc xá A, Khu A..." />
                    </div>
                </div>
                <div class="pm-field">
                    <label>Mô tả</label>
                    <textarea name="description" id="editDesc" placeholder="Mô tả chi tiết sản phẩm..."></textarea>
                </div>
            </div>
            <div class="pm-modal-footer">
                <button type="button" class="pm-btn pm-btn-outline" onclick="closeEditModal()">Hủy</button>
                <button type="submit" class="pm-btn pm-btn-primary">
                    <i class="fas fa-save"></i> Lưu thay đổi
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
// ── Checkbox & Bulk ──────────────────────────────────
function toggleAll(master) {
    document.querySelectorAll('.row-cb').forEach(cb => cb.checked = master.checked);
    updateBulkBar();
}

function updateBulkBar() {
    const checked = document.querySelectorAll('.row-cb:checked');
    const bar = document.getElementById('bulkBar');
    document.getElementById('bulkCount').textContent = checked.length;
    bar.classList.toggle('visible', checked.length > 0);

    // Highlight rows
    document.querySelectorAll('.row-cb').forEach(cb => {
        cb.closest('tr').classList.toggle('selected', cb.checked);
    });

    // Sync master checkbox
    const all = document.querySelectorAll('.row-cb');
    const master = document.getElementById('checkAll');
    if (master) {
        master.indeterminate = checked.length > 0 && checked.length < all.length;
        master.checked = checked.length === all.length && all.length > 0;
    }
}

function clearSelection() {
    document.querySelectorAll('.row-cb, #checkAll').forEach(cb => cb.checked = false);
    document.querySelectorAll('tr.selected').forEach(tr => tr.classList.remove('selected'));
    document.getElementById('bulkBar').classList.remove('visible');
    const master = document.getElementById('checkAll');
    if (master) master.indeterminate = false;
}

function confirmBulkDelete() {
    const checked = document.querySelectorAll('.row-cb:checked');
    if (checked.length === 0) return;
    if (!confirm(`Bạn có chắc muốn xóa ${checked.length} sản phẩm đã chọn? Thao tác không thể hoàn tác.`)) return;
    const ids = Array.from(checked).map(cb => cb.value).join(',');
    document.getElementById('bulkIds').value = ids;
    document.getElementById('bulkForm').submit();
}

// ── Edit Modal ───────────────────────────────────────
function openEditModal(id, name, price, deposit, qty, location, desc) {
    document.getElementById('editProductId').value = id;
    document.getElementById('editName').value      = name;
    document.getElementById('editPrice').value     = price;
    document.getElementById('editDeposit').value   = deposit;
    document.getElementById('editQty').value       = qty;
    document.getElementById('editLocation').value  = location;
    document.getElementById('editDesc').value      = desc;
    document.getElementById('editModal').classList.add('open');
}

function closeEditModal() {
    document.getElementById('editModal').classList.remove('open');
}

// Close modal on backdrop click
document.getElementById('editModal').addEventListener('click', function(e) {
    if (e.target === this) closeEditModal();
});

// Close on Escape
document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeEditModal();
});

// ── ✅ FIX: Approve & Delete Forms (tạo động ngoài bulkForm) ─────
// Lấy antiforgery token từ bulkForm để dùng lại
function getAntiForgeryToken() {
    const tokenInput = document.querySelector('#bulkForm input[name="__RequestVerificationToken"]');
    return tokenInput ? tokenInput.value : '';
}

function submitApproveForm(productId) {
    // Tạo form tạm thời bên ngoài bulkForm
    const form = document.createElement('form');
    form.method = 'post';
    form.action = '@Url.Action("ApproveProduct", "Admin")';
    form.style.display = 'none';

    // Antiforgery token
    const token = document.createElement('input');
    token.type = 'hidden';
    token.name = '__RequestVerificationToken';
    token.value = getAntiForgeryToken();
    form.appendChild(token);

    // productId
    const pid = document.createElement('input');
    pid.type = 'hidden';
    pid.name = 'productId';
    pid.value = productId;
    form.appendChild(pid);

    // search & filterCat
    const search = document.createElement('input');
    search.type = 'hidden';
    search.name = 'search';
    search.value = '@search';
    form.appendChild(search);

    const filterCat = document.createElement('input');
    filterCat.type = 'hidden';
    filterCat.name = 'filterCat';
    filterCat.value = '@filterCat';
    form.appendChild(filterCat);

    document.body.appendChild(form);
    form.submit();
}

function submitDeleteForm(productId) {
    // Tạo form tạm thời bên ngoài bulkForm
    const form = document.createElement('form');
    form.method = 'post';
    form.action = '@Url.Action("DeleteProduct", "Admin")';
    form.style.display = 'none';

    // Antiforgery token
    const token = document.createElement('input');
    token.type = 'hidden';
    token.name = '__RequestVerificationToken';
    token.value = getAntiForgeryToken();
    form.appendChild(token);

    // productId
    const pid = document.createElement('input');
    pid.type = 'hidden';
    pid.name = 'productId';
    pid.value = productId;
    form.appendChild(pid);

    // search & filterCat
    const search = document.createElement('input');
    search.type = 'hidden';
    search.name = 'search';
    search.value = '@search';
    form.appendChild(search);

    const filterCat = document.createElement('input');
    filterCat.type = 'hidden';
    filterCat.name = 'filterCat';
    filterCat.value = '@filterCat';
    form.appendChild(filterCat);

    document.body.appendChild(form);
    form.submit();
}
</script>
}

@{
    ViewData["Title"] = "Giỏ hàng ký quỹ";
    var userName = Context.Session.GetString("UserName");
    var isLoggedIn = !string.IsNullOrEmpty(userName);
}

<div class="cart-page-wrapper" style="max-width: 1200px; margin: 3rem auto; padding: 0 1.5rem; font-family: 'Inter', sans-serif;">
    
    <!-- Header Banner -->
    <div class="cart-header-banner" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); padding: 2.5rem; border-radius: 24px; color: white; margin-bottom: 2.5rem; box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08); position: relative; overflow: hidden;">
        <div style="position: absolute; right: -50px; bottom: -50px; font-size: 12rem; color: rgba(255,255,255,0.02); pointer-events: none;">
            <i class="fas fa-shopping-bag"></i>
        </div>
        <h1 style="font-size: 2rem; font-weight: 850; margin: 0 0 0.5rem 0; letter-spacing: -0.5px; display: flex; align-items: center; gap: 0.75rem;">
            <i class="fas fa-shopping-cart" style="color: #3b82f6;"></i>
            Giỏ hàng ký quỹ
        </h1>
        <p style="color: #94a3b8; font-size: 0.95rem; margin: 0; max-width: 600px; line-height: 1.6;">
            Xem lại các sản phẩm bạn đã chọn để chuẩn bị thuê. Hệ thống bảo vệ ký quỹ của <strong style="color: #3b82f6;">UTE Rent</strong> sẽ giữ khoản đặt cọc an toàn cho đến khi bàn giao thành công.
        </p>
    </div>

    <!-- Empty State Container -->
    <div id="cart-empty-state" style="display: none; text-align: center; padding: 5rem 2rem; background: white; border: 2px dashed #cbd5e1; border-radius: 24px; box-shadow: 0 4px 6px rgba(0,0,0,0.01);">
        <div style="font-size: 4rem; color: #94a3b8; margin-bottom: 1.5rem;">
            <i class="fas fa-shopping-bag"></i>
        </div>
        <h2 style="font-size: 1.5rem; font-weight: 800; color: #1e293b; margin: 0 0 0.5rem 0;">Giỏ hàng của bạn đang trống</h2>
        <p style="color: #64748b; font-size: 0.95rem; margin: 0 0 2rem 0; max-width: 400px; margin-left: auto; margin-right: auto; line-height: 1.5;">
            Khám phá hàng trăm thiết bị công nghệ, học tập hữu ích dành riêng cho sinh viên UTE và bắt đầu thuê ngay hôm nay!
        </p>
        <a href="/Product" class="btn-primary-custom" style="display: inline-flex; align-items: center; gap: 0.5rem; background: #2563eb; color: white; padding: 1rem 2rem; border-radius: 16px; font-weight: 700; text-decoration: none; transition: all 0.3s ease; box-shadow: 0 10px 25px rgba(37, 99, 235, 0.2);">
            <i class="fas fa-arrow-left"></i> Quay lại cửa hàng
        </a>
    </div>

    <!-- Cart Layout Grid -->
    <div id="cart-layout-grid" class="cart-grid-container" style="display: grid; grid-template-columns: 1.6fr 1fr; gap: 2rem;">
        
        <!-- Left Panel: Product List -->
        <div style="display: flex; flex-direction: column; gap: 1.25rem;" id="cart-items-container">
            <!-- Dynamic items rendered by JS -->
        </div>

        <!-- Right Panel: Summary checkout -->
        <div>
            <div class="summary-card" style="background: white; border: 2px solid #e2e8f0; border-radius: 24px; padding: 2rem; box-shadow: 0 4px 20px rgba(0,0,0,0.02); position: sticky; top: 2rem;">
                <h3 style="font-size: 1.15rem; font-weight: 800; color: #1e293b; margin: 0 0 1.5rem 0; display: flex; align-items: center; gap: 0.5rem; border-bottom: 2px solid #f1f5f9; padding-bottom: 1rem;">
                    <i class="fas fa-file-invoice-dollar" style="color: #10b981;"></i>
                    Tóm tắt thanh toán ký quỹ
                </h3>

                <!-- Subtotals -->
                <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem;">
                    <div style="display: flex; justify-content: space-between; font-size: 0.95rem; color: #64748b;">
                        <span>Số lượng sản phẩm:</span>
                        <strong id="summary-total-qty" style="color: #1e293b;">0 món</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between; font-size: 0.95rem; color: #64748b;">
                        <span>Thành tiền thuê:</span>
                        <strong id="summary-total-rent" style="color: #1e293b;">0 đ</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between; font-size: 0.95rem; color: #64748b; padding-bottom: 1rem; border-bottom: 1px solid #f1f5f9;">
                        <span>
                            Tổng tiền cọc (hoàn 100%): 
                            <i class="fas fa-question-circle" title="Toàn bộ tiền cọc sẽ được hệ thống tạm giữ an toàn trong ví bảo vệ và hoàn trả ngay khi trả đồ nguyên vẹn." style="cursor: help; color: #94a3b8;"></i>
                        </span>
                        <strong id="summary-total-deposit" style="color: #1e293b;">+ 0 đ</strong>
                    </div>
                </div>

                <!-- Grand Total -->
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
                    <span style="font-size: 1rem; font-weight: 800; color: #0f172a;">Tổng cộng tạm giữ:</span>
                    <div style="text-align: right;">
                        <div id="summary-grand-total" style="font-size: 1.6rem; font-weight: 900; color: #2563eb;">0 đ</div>
                        <span style="font-size: 0.72rem; color: #94a3b8; font-weight: 500;">Bao gồm tiền cọc hoàn lại</span>
                    </div>
                </div>

                <!-- Checkout CTA -->
                @if (isLoggedIn)
                {
                    <button type="button" onclick="checkoutCartAll()" class="btn-checkout-primary" style="width: 100%; border: none; background: #2563eb; color: white; padding: 1.25rem; border-radius: 18px; font-size: 1.1rem; font-weight: 800; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 10px 25px rgba(37, 99, 235, 0.25); display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
                        <i class="fas fa-shopping-bag"></i>
                        TIẾN HÀNH ĐẶT THUÊ TẤT CẢ
                    </button>
                }
                else
                {
                    <a href="/Account/Login?returnUrl=/Product/Cart" class="btn-checkout-primary" style="text-decoration: none; width: 100%; background: #2563eb; color: white; padding: 1.25rem; border-radius: 18px; font-size: 1.1rem; font-weight: 800; display: flex; align-items: center; justify-content: center; gap: 0.5rem; box-shadow: 0 10px 25px rgba(37, 99, 235, 0.25);">
                        <i class="fas fa-sign-in-alt"></i>
                        ĐĂNG NHẬP ĐỂ ĐẶT THUÊ
                    </a>
                }

                <!-- Protection Policy Card -->
                <div style="margin-top: 1.5rem; padding: 1rem; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 16px; display: flex; gap: 0.75rem; align-items: flex-start;">
                    <i class="fas fa-shield-alt" style="color: #2563eb; font-size: 1.1rem; margin-top: 0.1rem;"></i>
                    <p style="margin: 0; font-size: 0.78rem; color: #1e3a8a; line-height: 1.5; font-weight: 500;">
                        <strong>Bảo vệ ký quỹ thông minh</strong>: UTE Rent giữ tiền thuê & cọc của bạn. Chủ nhà chỉ được nhận tiền khi bạn xác nhận đã nhận đồ thành công. Hoàn cọc 100%.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .cart-item-card {
        background: white;
        border: 2px solid #e2e8f0;
        border-radius: 20px;
        padding: 1.25rem;
        display: flex;
        gap: 1.5rem;
        transition: all 0.3s ease;
        position: relative;
    }

    .cart-item-card:hover {
        border-color: #cbd5e1;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.02);
    }

    .btn-checkout-primary:hover {
        background: #1d4ed8 !important;
        transform: translateY(-2px);
        box-shadow: 0 15px 30px rgba(37, 99, 235, 0.3) !important;
    }

    .btn-checkout-primary:active {
        transform: translateY(0);
    }

    .btn-duration-qty {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 1px solid #cbd5e1;
        background: #f8fafc;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        color: #475569;
    }

    .btn-checkout-single:hover {
        background: #1d4ed8 !important;
        transform: translateY(-2px);
        box-shadow: 0 6px 15px rgba(37, 99, 235, 0.25) !important;
    }

    .btn-checkout-single:active {
        transform: translateY(0);
    }

    .btn-duration-qty:hover {
        background: #e2e8f0;
        color: #0f172a;
        border-color: #94a3b8;
    }

    @@media (max-width: 968px) {
        .cart-grid-container {
            grid-template-columns: 1fr !important;
        }
    }
</style>

<script>
    let cart = [];

    function loadCart() {
        try {
            cart = JSON.parse(localStorage.getItem('uterent_cart') || '[]');
        } catch (e) {
            console.error("Lỗi khi đọc giỏ hàng:", e);
            cart = [];
        }

        const emptyState = document.getElementById('cart-empty-state');
        const grid = document.getElementById('cart-layout-grid');
        const container = document.getElementById('cart-items-container');

        if (cart.length === 0) {
            emptyState.style.display = 'block';
            grid.style.display = 'none';
            return;
        }

        emptyState.style.display = 'none';
        grid.style.display = 'grid';
        container.innerHTML = '';

        cart.forEach((item, index) => {
            let unitText = "ngày";
            if (item.unit === 'Hour') unitText = "giờ";
            if (item.unit === 'Week') unitText = "tuần";
            if (item.unit === 'Month') unitText = "tháng";

            const itemRentTotal = item.price * item.duration;
            const itemTotal = itemRentTotal + item.deposit;

            const formatter = new Intl.NumberFormat('vi-VN');

            // Format date readable
            let dateStr = "Chưa chọn ngày";
            if (item.startDate) {
                const dateObj = new Date(item.startDate);
                if (!isNaN(dateObj.getTime())) {
                    dateStr = `${String(dateObj.getDate()).padStart(2, '0')}/${String(dateObj.getMonth() + 1).padStart(2, '0')}/${dateObj.getFullYear()} lúc ${String(dateObj.getHours()).padStart(2, '0')}:${String(dateObj.getMinutes()).padStart(2, '0')}`;
                }
            }

            const itemHtml = `
                <div class="cart-item-card" id="cart-item-${item.productId}">
                    <!-- Product Image -->
                    <img src="${item.imageUrl}" alt="${item.name}" style="width: 100px; height: 100px; border-radius: 14px; object-fit: cover; border: 1px solid #f1f5f9; background: #f8fafc;" />
                    
                    <!-- Content Panel -->
                    <div style="flex: 1; display: flex; flex-direction: column; justify-content: space-between;">
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                <a href="/Product/Details/${item.productId}" style="font-size: 1.05rem; font-weight: 800; color: #1e293b; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#2563eb'" onmouseout="this.style.color='#1e293b'">
                                    ${item.name}
                                </a>
                                <button type="button" onclick="deleteCartItem(${item.productId})" style="background: none; border: none; color: #94a3b8; cursor: pointer; font-size: 1.1rem; transition: color 0.2s;" onmouseover="this.style.color='#ef4444'" onmouseout="this.style.color='#94a3b8'">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </div>
                            
                            <!-- Date Selected info -->
                            <div style="font-size: 0.82rem; color: #64748b; margin-top: 0.35rem; display: flex; align-items: center; gap: 0.35rem;">
                                <i class="far fa-calendar-alt" style="color: #3b82f6;"></i>
                                Nhận đồ: <strong>${dateStr}</strong>
                            </div>
                        </div>

                        <!-- Bottom panel: duration adjust & totals -->
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1rem; border-top: 1px solid #f1f5f9; padding-top: 0.85rem;">
                            
                            <!-- Duration Adjuster -->
                            <div style="display: flex; align-items: center; gap: 0.75rem;">
                                <span style="font-size: 0.85rem; color: #64748b; font-weight: 600;">Thời lượng:</span>
                                <div style="display: flex; align-items: center; gap: 0.5rem; background: #f8fafc; padding: 0.25rem; border-radius: 999px; border: 1px solid #e2e8f0;">
                                    <button type="button" class="btn-duration-qty" onclick="adjustItemDuration(${item.productId}, -1)">−</button>
                                    <span style="font-size: 0.95rem; font-weight: 800; color: #1e293b; min-width: 24px; text-align: center;">${item.duration}</span>
                                    <button type="button" class="btn-duration-qty" onclick="adjustItemDuration(${item.productId}, 1)">+</button>
                                </div>
                                <span style="font-size: 0.85rem; color: #64748b; font-weight: 600;">${unitText}</span>
                            </div>

                            <!-- Cost Totals & Single Checkout -->
                            <div style="display: flex; align-items: center; gap: 1.25rem;">
                                <div style="text-align: right;">
                                    <div style="font-size: 0.78rem; color: #94a3b8;">Tiền thuê: <strong style="color: #475569;">${formatter.format(itemRentTotal)} đ</strong></div>
                                    <div style="font-size: 0.78rem; color: #94a3b8;">Tiền cọc cọc: <strong style="color: #475569;">+ ${formatter.format(item.deposit)} đ</strong></div>
                                    <div style="font-size: 1rem; font-weight: 850; color: #2563eb; margin-top: 0.15rem;">${formatter.format(itemTotal)} đ</div>
                                </div>

                                <button type="button" onclick="checkoutSingleItem(${item.productId})" class="btn-checkout-single" style="border: none; background: #2563eb; color: white; padding: 0.6rem 1.25rem; border-radius: 12px; font-weight: 800; font-size: 0.85rem; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.15);">
                                    Đặt thuê
                                </button>
                            </div>

                        </div>
                    </div>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', itemHtml);
        });

        calculateCartTotals();
    }

    function calculateCartTotals() {
        let totalRent = 0;
        let totalDeposit = 0;
        let totalQty = cart.length;

        cart.forEach(item => {
            totalRent += item.price * item.duration;
            totalDeposit += item.deposit;
        });

        const grandTotal = totalRent + totalDeposit;
        const formatter = new Intl.NumberFormat('vi-VN');

        document.getElementById('summary-total-qty').innerText = `${totalQty} sản phẩm`;
        document.getElementById('summary-total-rent').innerText = formatter.format(totalRent) + ' đ';
        document.getElementById('summary-total-deposit').innerText = '+ ' + formatter.format(totalDeposit) + ' đ';
        document.getElementById('summary-grand-total').innerText = formatter.format(grandTotal) + ' đ';
    }

    function adjustItemDuration(productId, change) {
        let itemIndex = cart.findIndex(item => item.productId === productId);
        if (itemIndex > -1) {
            cart[itemIndex].duration += change;
            if (cart[itemIndex].duration < 1) cart[itemIndex].duration = 1;
            
            localStorage.setItem('uterent_cart', JSON.stringify(cart));
            loadCart();
        }
    }

    function deleteCartItem(productId) {
        if (confirm("Bạn có chắc chắn muốn xóa sản phẩm này khỏi giỏ hàng?")) {
            cart = cart.filter(item => item.productId !== productId);
            localStorage.setItem('uterent_cart', JSON.stringify(cart));
            
            // Sync with navbar layout badge
            if (typeof updateLayoutCartBadge === 'function') {
                updateLayoutCartBadge();
            }

            loadCart();
        }
    }

    async function checkoutCartAll() {
        if (cart.length === 0) {
            alert("Giỏ hàng rỗng!");
            return;
        }

        if (!confirm("Bạn có chắc chắn muốn đặt thuê tất cả sản phẩm trong giỏ hàng?\nHệ thống sẽ tạm khóa tổng số tiền thuê và cọc trong ví ký quỹ để bảo vệ giao dịch.")) {
            return;
        }

        // Structure checkout model data
        const checkoutData = cart.map(item => ({
            productId: item.productId,
            rentalUnit: item.unit,
            duration: item.duration,
            startDate: item.startDate
        }));

        try {
            const response = await fetch('/Product/CheckoutCart', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify(checkoutData)
            });

            const result = await response.json();

            if (result.success) {
                alert("🎉 " + result.message);
                
                // Clear cart on success
                localStorage.removeItem('uterent_cart');
                if (typeof updateLayoutCartBadge === 'function') {
                    updateLayoutCartBadge();
                }

                // Redirect to renter dashboard to check orders
                window.location.href = '/Home/RenterDashboard';
            } else {
                alert("❌ Giao dịch thất bại: " + result.message + "\nVui lòng nạp thêm tiền vào ví để đảm bảo số dư ký quỹ!");
            }
        } catch (e) {
            console.error("Lỗi khi thanh toán giỏ hàng:", e);
            alert("❌ Lỗi kết nối hệ thống. Vui lòng thử lại!");
        }
    }

    async function checkoutSingleItem(productId) {
        let itemIndex = cart.findIndex(item => item.productId === productId);
        if (itemIndex === -1) return;

        const item = cart[itemIndex];

        if (!confirm(`Bạn có chắc chắn muốn đặt thuê sản phẩm "${item.name}"?\nHệ thống sẽ tạm khóa khoản tiền thuê và tiền cọc của sản phẩm này trong ví ký quỹ.`)) {
            return;
        }

        // Structure single checkout data array
        const checkoutData = [{
            productId: item.productId,
            rentalUnit: item.unit,
            duration: item.duration,
            startDate: item.startDate
        }];

        try {
            const response = await fetch('/Product/CheckoutCart', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify(checkoutData)
            });

            const result = await response.json();

            if (result.success) {
                alert("🎉 " + result.message);
                
                // Remove only this product from cart
                cart = cart.filter(x => x.productId !== productId);
                localStorage.setItem('uterent_cart', JSON.stringify(cart));
                
                if (typeof updateLayoutCartBadge === 'function') {
                    updateLayoutCartBadge();
                }

                // Redirect to renter dashboard to check orders
                window.location.href = '/Home/RenterDashboard';
            } else {
                alert("❌ Đặt thuê thất bại: " + result.message + "\nVui lòng kiểm tra số dư ví ký quỹ!");
            }
        } catch (e) {
            console.error("Lỗi khi đặt thuê lẻ:", e);
            alert("❌ Lỗi kết nối hệ thống. Vui lòng thử lại!");
        }
    }

    // Load cart on DOM load
    window.addEventListener('DOMContentLoaded', loadCart);
</script>

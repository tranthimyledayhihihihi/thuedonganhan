@{
    ViewData["Title"] = "Giỏ hàng ký quỹ";
    var userName = Context.Session.GetString("UserName");
    var isLoggedIn = !string.IsNullOrEmpty(userName);
}

<div class="lm-page-wrapper">
    <div class="lm-cart-header">
        <h1 class="lm-cart-title">Giỏ hàng của bạn</h1>
        <p class="lm-cart-subtitle">Lựa chọn phong cách, sống bền vững.</p>
    </div>

    <!-- Empty State -->
    <div id="cart-empty-state" style="display: none;" class="lm-empty-state">
        <div class="lm-empty-icon">
            <i class="fas fa-shopping-bag"></i>
        </div>
        <h2>Giỏ hàng của bạn đang trống</h2>
        <p>Khám phá hàng trăm thiết bị công nghệ, học tập hữu ích dành riêng cho sinh viên UTE và bắt đầu thuê ngay hôm nay!</p>
        <a href="/Product" class="lm-btn-primary" style="display: inline-flex; width: auto; padding: 16px 32px; text-decoration: none; align-items: center; gap: 8px;">
            <i class="fas fa-arrow-left"></i> Quay lại cửa hàng
        </a>
    </div>

    <!-- Cart Layout Grid -->
    <div id="cart-layout-grid" class="lm-cart-grid">

        <div class="lm-cart-left">
            <div id="cart-items-container" class="lm-items-list"></div>

            <div class="lm-suggestions-section">
                <h3 class="lm-sugg-title">Gợi ý phụ kiện đi kèm</h3>
                <div class="lm-sugg-grid">
                    <div class="lm-sugg-card">
                        <div class="lm-sugg-img">
                            <img src="https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?w=200" alt="Hộp bảo vệ">
                        </div>
                        <h4>Hộp bảo vệ chống sốc</h4>
                        <p>+50.000đ/ngày</p>
                        <button class="lm-btn-sugg">Thêm vào</button>
                    </div>
                    <div class="lm-sugg-card">
                        <div class="lm-sugg-img">
                            <img src="https://images.unsplash.com/photo-1611186871348-b1ce696e52c9?w=200" alt="Trạm sạc">
                        </div>
                        <h4>Trạm sạc di động 500W</h4>
                        <p>+120.000đ/ngày</p>
                        <button class="lm-btn-sugg">Thêm vào</button>
                    </div>
                    <div class="lm-sugg-card">
                        <div class="lm-sugg-img">
                            <img src="https://images.unsplash.com/photo-1512790182412-b19e6d62bc39?w=200" alt="Chân máy">
                        </div>
                        <h4>Chân máy chuyên nghiệp</h4>
                        <p>+80.000đ/ngày</p>
                        <button class="lm-btn-sugg">Thêm vào</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Panel: Summary -->
        <div class="lm-cart-right">
            <div class="lm-summary-card">
                <h3>Tóm tắt đơn hàng</h3>

                <div class="lm-summary-rows">
                    <div class="lm-summary-row">
                        <span>Tổng tiền thuê <small id="summary-total-qty" style="color: #6b7280; font-size: 0.8rem; margin-left: 4px;">(0 món)</small></span>
                        <strong id="summary-total-rent">0đ</strong>
                    </div>
                    <div class="lm-summary-row">
                        <span>
                            Tiền cọc (Hoàn lại 100%)
                            <i class="fas fa-question-circle" title="Toàn bộ tiền cọc sẽ được hệ thống tạm giữ an toàn trong ví bảo vệ và hoàn trả ngay khi trả đồ nguyên vẹn." style="cursor: help; color: #9ca3af; font-size: 0.8rem;"></i>
                        </span>
                        <strong id="summary-total-deposit">0đ</strong>
                    </div>
                    <div class="lm-summary-row">
                        <span>Phí dịch vụ</span>
                        <strong>Miễn phí</strong>
                    </div>
                </div>

                <div class="lm-summary-total">
                    <span>Tổng cộng</span>
                    <strong id="summary-grand-total">0đ</strong>
                </div>

                @if (isLoggedIn)
                {
                    <button type="button" onclick="checkoutCartAll()" class="lm-btn-primary">
                        <i class="fas fa-shopping-bag"></i> Tiến hành đặt thuê tất cả
                    </button>
                }
                else
                {
                    <a href="/Account/Login?returnUrl=/Product/Cart" class="lm-btn-primary" style="display: flex; justify-content: center; align-items: center; gap: 8px; text-decoration: none;">
                        <i class="fas fa-sign-in-alt"></i> Đăng nhập để thanh toán
                    </a>
                }

                <div class="lm-trust-badge">
                    <i class="fas fa-leaf"></i>
                    <p>Bằng việc thuê đồ, bạn đã giúp giảm thiểu rác thải ra môi trường. <strong>UTE Rent</strong> giữ tiền thuê &amp; cọc an toàn — chủ nhà chỉ nhận tiền sau khi bạn xác nhận thành công.</p>
                </div>
                <div class="lm-shipping-text">
                    Giao hàng miễn phí cho đơn từ 2.000.000đ
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .lm-page-wrapper {
        background-color: #faf9f6;
        color: #1f2937;
        padding: 40px 20px 80px 20px;
        font-family: 'Inter', sans-serif;
        min-height: 100vh;
    }

    /* Header */
    .lm-cart-header {
        max-width: 1200px;
        margin: 0 auto 40px auto;
    }

    .lm-cart-title {
        font-size: 2.5rem;
        font-weight: 800;
        color: #111827;
        margin-bottom: 8px;
    }

    .lm-cart-subtitle {
        color: #6b7280;
        font-size: 1.05rem;
    }

    /* Layout Grid */
    .lm-cart-grid {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1.8fr 1fr;
        gap: 40px;
        align-items: start;
    }

    /* Left Panel */
    .lm-items-list {
        display: flex;
        flex-direction: column;
        gap: 24px;
        margin-bottom: 40px;
    }

    .lm-cart-item {
        background: #ffffff;
        border-radius: 24px;
        padding: 24px;
        display: flex;
        gap: 24px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
        border: 1px solid #f3f4f6;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .lm-cart-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 24px rgba(0,0,0,0.06);
        }

    .lm-item-img {
        width: 140px;
        height: 140px;
        border-radius: 16px;
        object-fit: cover;
        background: #f8f9fa;
        flex-shrink: 0;
    }

    .lm-item-info {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .lm-item-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 8px;
    }

    .lm-item-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #111827;
        text-decoration: none;
        transition: color 0.2s;
    }

        .lm-item-title:hover {
            color: #4f6356;
        }

    .lm-item-total {
        font-size: 1.1rem;
        font-weight: 700;
        color: #111827;
        white-space: nowrap;
    }

    .lm-item-date {
        font-size: 0.88rem;
        color: #6b7280;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 12px;
        flex-wrap: wrap;
    }

    .lm-date-input {
        padding: 4px 10px;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        font-size: 0.82rem;
        font-weight: 600;
        color: #111827;
        outline: none;
        background: #f9fafb;
        transition: border-color 0.2s;
    }

        .lm-date-input:focus {
            border-color: #4f6356;
        }

    .lm-item-sub {
        font-size: 0.8rem;
        color: #9ca3af;
        margin-bottom: 16px;
    }

        .lm-item-sub strong {
            color: #6b7280;
        }

    .lm-item-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: auto;
        padding-top: 12px;
        border-top: 1px solid #f3f4f6;
    }

    .lm-price-badge {
        background: #ffedd5;
        color: #c2410c;
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 700;
    }

    .lm-item-actions {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .lm-qty-controls {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #f3f4f6;
        padding: 6px 12px;
        border-radius: 20px;
    }

        .lm-qty-controls button {
            background: none;
            border: none;
            color: #4b5563;
            cursor: pointer;
            font-size: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            transition: 0.2s;
        }

            .lm-qty-controls button:hover {
                background: #e5e7eb;
                color: #111827;
            }

        .lm-qty-controls span {
            font-weight: 700;
            font-size: 0.95rem;
            min-width: 20px;
            text-align: center;
            color: #111827;
        }

    .lm-delete-btn {
        background: none;
        border: none;
        color: #9ca3af;
        cursor: pointer;
        font-size: 1.15rem;
        transition: 0.2s;
        padding: 4px;
    }

        .lm-delete-btn:hover {
            color: #ef4444;
        }

    .lm-checkout-single-btn {
        background: #4f6356;
        color: #fff;
        border: none;
        padding: 8px 20px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        transition: 0.2s;
        white-space: nowrap;
    }

        .lm-checkout-single-btn:hover {
            background: #3e4f44;
            transform: translateY(-1px);
        }

    /* Suggestions Section */
    .lm-suggestions-section {
        margin-top: 8px;
    }

    .lm-sugg-title {
        font-size: 1.1rem;
        font-weight: 700;
        margin-bottom: 20px;
        color: #111827;
    }

    .lm-sugg-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .lm-sugg-card {
        background: #ffffff;
        border-radius: 24px;
        padding: 24px 16px;
        text-align: center;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
        border: 1px solid #f3f4f6;
    }

    .lm-sugg-img {
        width: 80px;
        height: 80px;
        margin: 0 auto 16px auto;
        border-radius: 50%;
        overflow: hidden;
        background: #f8f9fa;
    }

        .lm-sugg-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .lm-sugg-card h4 {
        font-size: 0.9rem;
        font-weight: 700;
        color: #111827;
        margin-bottom: 8px;
        line-height: 1.4;
    }

    .lm-sugg-card p {
        font-size: 0.85rem;
        color: #6b7280;
        margin-bottom: 16px;
        font-weight: 500;
    }

    .lm-btn-sugg {
        background: #4f6356;
        color: white;
        border: none;
        padding: 8px 24px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
        transition: 0.2s;
    }

        .lm-btn-sugg:hover {
            background: #3e4f44;
        }

    /* Right Panel */
    .lm-summary-card {
        background: #ebe9e0;
        border-radius: 24px;
        padding: 32px;
        position: sticky;
        top: 100px;
    }

        .lm-summary-card h3 {
            font-size: 1.25rem;
            font-weight: 800;
            color: #111827;
            margin-bottom: 24px;
        }

    .lm-summary-rows {
        display: flex;
        flex-direction: column;
        gap: 16px;
        margin-bottom: 24px;
        padding-bottom: 24px;
        border-bottom: 1px solid #dcdad1;
    }

    .lm-summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.95rem;
        color: #4b5563;
    }

        .lm-summary-row strong {
            color: #111827;
            font-weight: 700;
        }

    .lm-summary-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 32px;
    }

        .lm-summary-total span {
            font-size: 1.1rem;
            font-weight: 800;
            color: #111827;
        }

        .lm-summary-total strong {
            font-size: 1.5rem;
            font-weight: 800;
            color: #111827;
        }

    .lm-btn-primary {
        width: 100%;
        background: #4f6356;
        color: #fff;
        border: none;
        padding: 18px;
        border-radius: 16px;
        font-size: 1.05rem;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .lm-btn-primary:hover {
            background: #3e4f44;
            transform: translateY(-1px);
        }

    .lm-trust-badge {
        background: #f4f3ec;
        border-radius: 16px;
        padding: 16px;
        display: flex;
        gap: 12px;
        align-items: flex-start;
        margin-bottom: 16px;
    }

        .lm-trust-badge i {
            color: #4f6356;
            font-size: 1.1rem;
            margin-top: 2px;
            flex-shrink: 0;
        }

        .lm-trust-badge p {
            font-size: 0.78rem;
            color: #4b5563;
            line-height: 1.6;
            margin: 0;
        }

    .lm-shipping-text {
        text-align: center;
        font-size: 0.8rem;
        color: #6b7280;
        font-weight: 500;
    }

    /* Empty state */
    .lm-empty-state {
        text-align: center;
        padding: 80px 20px;
        background: #fff;
        border-radius: 24px;
        max-width: 1200px;
        margin: 0 auto;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
    }

    .lm-empty-icon {
        font-size: 4rem;
        color: #d1d5db;
        margin-bottom: 24px;
    }

    .lm-empty-state h2 {
        font-size: 1.8rem;
        font-weight: 800;
        margin-bottom: 12px;
        color: #111827;
    }

    .lm-empty-state p {
        color: #6b7280;
        max-width: 500px;
        margin: 0 auto 32px auto;
        line-height: 1.6;
    }

    /* Responsive */
    @@media (max-width: 992px) {
        .lm-cart-grid {
            grid-template-columns: 1fr;
        }

        .lm-sugg-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .lm-summary-card {
            position: static;
        }
    }

    @@media (max-width: 600px) {
        .lm-cart-item {
            flex-direction: column;
        }

        .lm-item-img {
            width: 100%;
            height: 200px;
        }

        .lm-sugg-grid {
            grid-template-columns: 1fr;
        }

        .lm-cart-title {
            font-size: 1.75rem;
        }

        .lm-item-bottom {
            flex-direction: column;
            gap: 12px;
            align-items: flex-start;
        }
    }
</style>

<script>
    let cart = [];

    function loadCart() {
        try {
            cart = JSON.parse(localStorage.getItem('uterent_cart') || '[]');
        } catch (e) {
            console.error("Lỗi khi đọc giỏ hàng:", e);
            cart = [];
        }

        const emptyState = document.getElementById('cart-empty-state');
        const grid = document.getElementById('cart-layout-grid');
        const container = document.getElementById('cart-items-container');

        if (cart.length === 0) {
            emptyState.style.display = 'block';
            grid.style.display = 'none';
            return;
        }

        emptyState.style.display = 'none';
        grid.style.display = 'grid';
        container.innerHTML = '';

        cart.forEach((item) => {
            let unitText = "ngày";
            if (item.unit === 'Hour') unitText = "giờ";
            if (item.unit === 'Week') unitText = "tuần";
            if (item.unit === 'Month') unitText = "tháng";

            const itemRentTotal = item.price * item.duration;
            const itemTotal = itemRentTotal + item.deposit;
            const formatter = new Intl.NumberFormat('vi-VN');

            // Format date readable
            let dateStr = "Chưa chọn ngày";
            if (item.startDate) {
                const dateObj = new Date(item.startDate);
                if (!isNaN(dateObj.getTime())) {
                    dateStr = `${String(dateObj.getDate()).padStart(2, '0')}/${String(dateObj.getMonth() + 1).padStart(2, '0')}/${dateObj.getFullYear()} lúc ${String(dateObj.getHours()).padStart(2, '0')}:${String(dateObj.getMinutes()).padStart(2, '0')}`;
                }
            }

            const itemHtml = `
                <div class="lm-cart-item" id="cart-item-${item.productId}">
                    <img src="${item.imageUrl}" alt="${item.name}" class="lm-item-img"
                         onerror="this.src='https://via.placeholder.com/140x140/8B5E3C/ffffff?text=Product'" />

                    <div class="lm-item-info">
                        <div class="lm-item-top">
                            <a href="/Product/Details/${item.productId}" class="lm-item-title">${item.name}</a>
                            <button type="button" class="lm-delete-btn" onclick="deleteCartItem(${item.productId})" title="Xóa">
                                <i class="far fa-trash-alt"></i>
                            </button>
                        </div>

                        <div class="lm-item-date">
                            <i class="far fa-calendar-alt" style="color: #4f6356;"></i>
                            <span>Nhận đồ lúc:</span>
                            <input type="datetime-local" class="lm-date-input"
                                   value="${item.startDate || ''}"
                                   onchange="updateCartItemDate(${item.productId}, this.value)" />
                        </div>

                        <div class="lm-item-sub">
                            Tiền thuê: <strong>${formatter.format(itemRentTotal)}đ</strong>
                            &nbsp;|&nbsp;
                            Tiền cọc: <strong>+${formatter.format(item.deposit)}đ</strong>
                        </div>

                        <div class="lm-item-bottom">
                            <span class="lm-price-badge">${formatter.format(item.price)}đ / ${unitText}</span>

                            <div class="lm-item-actions">
                                <div class="lm-qty-controls">
                                    <button type="button" onclick="adjustItemDuration(${item.productId}, -1)"><i class="fas fa-minus"></i></button>
                                    <span>${item.duration} ${unitText}</span>
                                    <button type="button" onclick="adjustItemDuration(${item.productId}, 1)"><i class="fas fa-plus"></i></button>
                                </div>
                                <div class="lm-item-total">${formatter.format(itemTotal)}đ</div>
                                <button type="button" class="lm-checkout-single-btn" onclick="checkoutSingleItem(${item.productId})">
                                    Đặt thuê
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', itemHtml);
        });

        calculateCartTotals();
    }

    function calculateCartTotals() {
        let totalRent = 0;
        let totalDeposit = 0;
        let totalQty = cart.length;

        cart.forEach(item => {
            totalRent += item.price * item.duration;
            totalDeposit += item.deposit;
        });

        const grandTotal = totalRent + totalDeposit;
        const formatter = new Intl.NumberFormat('vi-VN');

        document.getElementById('summary-total-qty').innerText = `(${totalQty} món)`;
        document.getElementById('summary-total-rent').innerText = formatter.format(totalRent) + 'đ';
        document.getElementById('summary-total-deposit').innerText = formatter.format(totalDeposit) + 'đ';
        document.getElementById('summary-grand-total').innerText = formatter.format(grandTotal) + 'đ';
    }

    function adjustItemDuration(productId, change) {
        let itemIndex = cart.findIndex(item => item.productId === productId);
        if (itemIndex > -1) {
            cart[itemIndex].duration += change;
            if (cart[itemIndex].duration < 1) cart[itemIndex].duration = 1;
            localStorage.setItem('uterent_cart', JSON.stringify(cart));
            loadCart();
        }
    }

    function updateCartItemDate(productId, newDate) {
        let itemIndex = cart.findIndex(item => item.productId === productId);
        if (itemIndex > -1) {
            cart[itemIndex].startDate = newDate;
            localStorage.setItem('uterent_cart', JSON.stringify(cart));
            calculateCartTotals();
        }
    }

    function deleteCartItem(productId) {
        if (confirm("Bạn có chắc chắn muốn xóa sản phẩm này khỏi giỏ hàng?")) {
            cart = cart.filter(item => item.productId !== productId);
            localStorage.setItem('uterent_cart', JSON.stringify(cart));
            if (typeof updateLayoutCartBadge === 'function') updateLayoutCartBadge();
            loadCart();
        }
    }

    async function checkoutCartAll() {
        if (cart.length === 0) { alert("Giỏ hàng rỗng!"); return; }

        if (!confirm("Bạn có chắc chắn muốn đặt thuê tất cả sản phẩm trong giỏ hàng?\nHệ thống sẽ tạm khóa tổng số tiền thuê và cọc trong ví ký quỹ để bảo vệ giao dịch.")) return;

        const checkoutData = cart.map(item => ({
            productId: item.productId,
            rentalUnit: item.unit,
            duration: item.duration,
            startDate: item.startDate
        }));

        try {
            const response = await fetch('/Product/CheckoutCart', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                body: JSON.stringify(checkoutData)
            });

            const result = await response.json();

            if (result.success) {
                alert("🎉 " + result.message);
                localStorage.removeItem('uterent_cart');
                if (typeof updateLayoutCartBadge === 'function') updateLayoutCartBadge();
                window.location.href = '/Home/RenterDashboard';
            } else {
                alert("❌ Giao dịch thất bại: " + result.message + "\nVui lòng nạp thêm tiền vào ví để đảm bảo số dư ký quỹ!");
            }
        } catch (e) {
            console.error("Lỗi khi thanh toán giỏ hàng:", e);
            alert("❌ Lỗi kết nối hệ thống. Vui lòng thử lại!");
        }
    }

    async function checkoutSingleItem(productId) {
        let itemIndex = cart.findIndex(item => item.productId === productId);
        if (itemIndex === -1) return;

        const item = cart[itemIndex];

        if (!confirm(`Bạn có chắc chắn muốn đặt thuê sản phẩm "${item.name}"?\nHệ thống sẽ tạm khóa khoản tiền thuê và tiền cọc của sản phẩm này trong ví ký quỹ.`)) return;

        const checkoutData = [{
            productId: item.productId,
            rentalUnit: item.unit,
            duration: item.duration,
            startDate: item.startDate
        }];

        try {
            const response = await fetch('/Product/CheckoutCart', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                body: JSON.stringify(checkoutData)
            });

            const result = await response.json();

            if (result.success) {
                alert("🎉 " + result.message);
                cart = cart.filter(x => x.productId !== productId);
                localStorage.setItem('uterent_cart', JSON.stringify(cart));
                if (typeof updateLayoutCartBadge === 'function') updateLayoutCartBadge();
                window.location.href = '/Home/RenterDashboard';
            } else {
                alert("❌ Đặt thuê thất bại: " + result.message + "\nVui lòng kiểm tra số dư ví ký quỹ!");
            }
        } catch (e) {
            console.error("Lỗi khi đặt thuê lẻ:", e);
            alert("❌ Lỗi kết nối hệ thống. Vui lòng thử lại!");
        }
    }

    window.addEventListener('DOMContentLoaded', loadCart);
</script>

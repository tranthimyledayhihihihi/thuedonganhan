</style>

<script>
    let currentUnit = 'Day';
    let currentPrice = @(Model?.PricePerDay ?? 0);
    const depositAmount = @(Model?.Deposit ?? 0);

    // Dynamic calendar state
    let currentMonthDate = new Date();
    let bookedRanges = [];
    let selectedStartDate = null;
    let selectedEndDate = null;

    function changeImage(src, element) {
        document.getElementById('mainImage').src = src;
        
        document.querySelectorAll('.thumbnail').forEach(thumb => {
            thumb.classList.remove('active');
        });
        if (element) {
            element.classList.add('active');
        } else if (window.event) {
            window.event.target.classList.add('active');
        }
    }

    function selectPackage(unit, price) {
        const card = document.getElementById('pkg-' + unit);
        if (card.classList.contains('disabled')) {
            return; // ignore clicks on disabled packages
        }

        // Remove active class from all package cards
        document.querySelectorAll('.rental-package-card').forEach(c => c.classList.remove('active'));
        
        // Add active to selected
        card.classList.add('active');

        // Update state
        currentUnit = unit;
        currentPrice = price;

        // Update hidden form input
        document.getElementById('rentalUnit').value = unit;

        // Update labels
        let labelText = "Số ngày thuê";
        let unitText = "ngày";
        if (unit === 'Hour') {
            labelText = "Số giờ thuê";
            unitText = "giờ";
        } else if (unit === 'Week') {
            labelText = "Số tuần thuê";
            unitText = "tuần";
        } else if (unit === 'Month') {
            labelText = "Số tháng thuê";
            unitText = "tháng";
        }

        document.getElementById('durationLabel').innerText = labelText;

        // Auto-adapt selection duration if range is already selected
        if (selectedStartDate && selectedEndDate) {
            let diffTime = Math.abs(selectedEndDate - selectedStartDate);
            let diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;
            
            let finalDuration = 1;
            if (unit === 'Hour') {
                finalDuration = Math.ceil(diffTime / (1000 * 60 * 60)) + 24;
            } else if (unit === 'Week') {
                finalDuration = Math.ceil(diffDays / 7);
            } else if (unit === 'Month') {
                let months = (selectedEndDate.getFullYear() - selectedStartDate.getFullYear()) * 12 + (selectedEndDate.getMonth() - selectedStartDate.getMonth());
                finalDuration = months || 1;
            } else {
                finalDuration = diffDays;
            }
            document.getElementById('rentalDuration').value = finalDuration;
            document.getElementById('duration').value = finalDuration;
        }

        updateCalculations();
    }

    function adjustDuration(change) {
        const input = document.getElementById('rentalDuration');
        let val = parseInt(input.value) || 1;
        val += change;
        if (val < 1) val = 1;
        input.value = val;
        updateDurationInput(val);
    }

    function updateDurationInput(val) {
        let cleanVal = parseInt(val) || 1;
        if (cleanVal < 1) cleanVal = 1;
        
        document.getElementById('duration').value = cleanVal;
        
        // If range is selected but user manually adjusts duration, reset the end date to sync with duration
        if (selectedStartDate && selectedEndDate) {
            selectedEndDate = null;
            renderCalendar();
        }
        
        updateCalculations();
    }

    function updateCalculations() {
        const duration = parseInt(document.getElementById('duration').value) || 1;
        const totalRent = currentPrice * duration;
        const grandTotal = totalRent + depositAmount;

        let unitText = "ngày";
        if (currentUnit === 'Hour') unitText = "giờ";
        if (currentUnit === 'Week') unitText = "tuần";
        if (currentUnit === 'Month') unitText = "tháng";

        const formatter = new Intl.NumberFormat('vi-VN');

        // Update summary box
        document.getElementById('summaryUnitPrice').innerText = formatter.format(currentPrice) + ' đ/' + unitText;
        document.getElementById('summaryDuration').innerText = 'x ' + duration + ' ' + unitText;
        document.getElementById('summaryRentTotal').innerText = formatter.format(totalRent) + ' đ';
        document.getElementById('summaryGrandTotal').innerText = formatter.format(grandTotal) + ' đ';
    }

    // Dynamic Calendar Logic
    function fetchBookedDates() {
        const productId = @Model?.ProductId;
        fetch('/Product/GetBookedDates/' + productId)
            .then(res => res.json())
            .then(res => {
                if (res && res.success && res.data) {
                    bookedRanges = res.data.map(d => ({
                        start: new Date(d.startDate),
                        end: new Date(d.endDate)
                    }));
                }
                renderCalendar();
            })
            .catch(err => {
                console.error("Lỗi khi tải lịch:", err);
                renderCalendar();
            });
    }

    function renderCalendar() {
        const container = document.getElementById('calendarDaysContainer');
        if (!container) return;
        container.innerHTML = '';

        const year = currentMonthDate.getFullYear();
        const month = currentMonthDate.getMonth();

        // Update Title: e.g. "Tháng 5, 2026"
        document.getElementById('calendarMonthTitle').innerText = `Tháng ${month + 1}, ${year}`;

        // Get first day of month and day of week (0-6 where 0 is Sun, 1 is Mon...)
        const firstDay = new Date(year, month, 1);
        let startDayIndex = firstDay.getDay(); 
        
        // Shift index to make Monday the first column (0: T2, 1: T3... 6: CN)
        let shift = (startDayIndex === 0) ? 6 : (startDayIndex - 1);

        // Render empty cells
        for (let i = 0; i < shift; i++) {
            const emptyCell = document.createElement('div');
            emptyCell.className = 'day-cell-empty';
            emptyCell.style.visibility = 'hidden';
            container.appendChild(emptyCell);
        }

        // Get total days in month
        const daysInMonth = new Date(year, month + 1, 0).getDate();

        // Current real date
        const todayDate = new Date();
        const todayMidnight = new Date();
        todayMidnight.setHours(0, 0, 0, 0);

        for (let d = 1; d <= daysInMonth; d++) {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'day-btn';
            btn.innerText = d;

            const checkDate = new Date(year, month, d, 12, 0, 0);
            const checkDateEnd = new Date(year, month, d, 23, 59, 59, 999);

            // Is past?
            const isPast = (checkDateEnd < todayMidnight);

            // Is today?
            const isToday = (d === todayDate.getDate() && month === todayDate.getMonth() && year === todayDate.getFullYear());

            // Is booked?
            const isBooked = bookedRanges.some(range => {
                let s = new Date(range.start); s.setHours(0, 0, 0, 0);
                let e = new Date(range.end); e.setHours(23, 59, 59, 999);
                let c = new Date(year, month, d, 12, 0, 0);
                return (c >= s && c <= e);
            });

            // Check if day is selected or within selected range
            let isSelected = false;
            let isRangeSelected = false;

            if (selectedStartDate && !selectedEndDate) {
                isSelected = (d === selectedStartDate.getDate() && month === selectedStartDate.getMonth() && year === selectedStartDate.getFullYear());
            } else if (selectedStartDate && selectedEndDate) {
                let checkTime = checkDate.getTime();
                let startTime = new Date(selectedStartDate).setHours(0, 0, 0, 0);
                let endTime = new Date(selectedEndDate).setHours(23, 59, 59, 999);

                if (checkTime >= startTime && checkTime <= endTime) {
                    let startDay = selectedStartDate.getDate() === d && selectedStartDate.getMonth() === month && selectedStartDate.getFullYear() === year;
                    let endDay = selectedEndDate.getDate() === d && selectedEndDate.getMonth() === month && selectedEndDate.getFullYear() === year;
                    
                    if (startDay || endDay) {
                        isSelected = true;
                    } else {
                        isRangeSelected = true;
                    }
                }
            }

            if (isBooked) {
                btn.classList.add('booked');
                btn.disabled = true;
            } else if (isPast) {
                btn.classList.add('past');
                btn.disabled = true;
            } else {
                btn.classList.add('available');
                if (isSelected) {
                    btn.classList.add('selected');
                } else if (isRangeSelected) {
                    btn.classList.add('range-selected');
                } else if (isToday) {
                    btn.classList.add('today');
                }

                // Click event listener
                btn.addEventListener('click', () => {
                    handleDateClick(year, month, d);
                });
            }

            container.appendChild(btn);
        }
    }

    function checkBookingBetween(start, end) {
        let hasBooking = false;
        let temp = new Date(start);
        while (temp <= end) {
            if (bookedRanges.some(range => {
                let rs = new Date(range.start); rs.setHours(0, 0, 0, 0);
                let re = new Date(range.end); re.setHours(23, 59, 59, 999);
                let rc = new Date(temp); rc.setHours(12, 0, 0, 0);
                return (rc >= rs && rc <= re);
            })) {
                hasBooking = true;
                break;
            }
            temp.setDate(temp.getDate() + 1);
        }
        return hasBooking;
    }

    function handleDateClick(year, month, day) {
        let clickedDate = new Date(year, month, day, 12, 0, 0);

        if (!selectedStartDate) {
            selectedStartDate = clickedDate;
            selectedEndDate = null;
        } else if (selectedStartDate && !selectedEndDate) {
            if (clickedDate < selectedStartDate) {
                selectedStartDate = clickedDate;
            } else {
                if (checkBookingBetween(selectedStartDate, clickedDate)) {
                    alert("Khoảng thời gian này đã có ngày được đặt! Vui lòng chọn khoảng khác.");
                    return;
                }
                selectedEndDate = clickedDate;
            }
        } else if (selectedStartDate && selectedEndDate) {
            if (clickedDate < selectedStartDate) {
                selectedStartDate = clickedDate;
                selectedEndDate = null;
            } else {
                if (checkBookingBetween(selectedStartDate, clickedDate)) {
                    alert("Khoảng thời gian này đã có ngày được đặt! Vui lòng chọn khoảng khác.");
                    return;
                }
                selectedEndDate = clickedDate;
            }
        }

        // Set Start Date in form input
        const y = selectedStartDate.getFullYear();
        const m = String(selectedStartDate.getMonth() + 1).padStart(2, '0');
        const d = String(selectedStartDate.getDate()).padStart(2, '0');
        document.getElementById('startDate').value = `${y}-${m}-${d}T12:00`;

        // Calculate duration based on range
        let finalDuration = 1;
        if (selectedStartDate && selectedEndDate) {
            let diffTime = Math.abs(selectedEndDate - selectedStartDate);
            let diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;

            if (currentUnit === 'Hour') {
                finalDuration = Math.ceil(diffTime / (1000 * 60 * 60)) + 24;
            } else if (currentUnit === 'Week') {
                finalDuration = Math.ceil(diffDays / 7);
            } else if (currentUnit === 'Month') {
                let months = (selectedEndDate.getFullYear() - selectedStartDate.getFullYear()) * 12 + (selectedEndDate.getMonth() - selectedStartDate.getMonth());
                finalDuration = months || 1;
            } else {
                finalDuration = diffDays;
            }
        }

        document.getElementById('rentalDuration').value = finalDuration;
        document.getElementById('duration').value = finalDuration;

        updateCalculations();
        renderCalendar();
    }

    function prevMonth() {
        currentMonthDate.setMonth(currentMonthDate.getMonth() - 1);
        renderCalendar();
    }

    function nextMonth() {
        currentMonthDate.setMonth(currentMonthDate.getMonth() + 1);
        renderCalendar();
    }

    const isLoggedIn = @(ViewBag.IsLoggedIn == true ? "true" : "false");

    function addToCart() {
        // Chặn nếu chưa đăng nhập
        if (!isLoggedIn) {
            window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
            return;
        }

        const productId = @Model?.ProductId;
        const productName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.ProductName));
        const imageUrl = "@(Model?.ImageUrl ?? "/images/default-product.png")";
        const duration = parseInt(document.getElementById('duration').value) || 1;
        const startDate = document.getElementById('startDate').value;

        let cart = JSON.parse(localStorage.getItem('uterent_cart') || '[]');
        
        // Filter out old entries for the same product to allow replacing it with the new configuration
        cart = cart.filter(item => item.productId !== productId);

        cart.push({
            productId: productId,
            name: productName,
            imageUrl: imageUrl,
            price: currentPrice,
            unit: currentUnit,
            duration: duration,
            deposit: depositAmount,
            startDate: startDate
        });

        localStorage.setItem('uterent_cart', JSON.stringify(cart));
        
        // Update layout cart badge instantly
        if (typeof updateLayoutCartBadge === 'function') {
            updateLayoutCartBadge();
        }

        alert("🛒 Đã thêm sản phẩm \"" + productName + "\" vào giỏ hàng của bạn!");
    }

    // Initialize calculations and dynamic calendar on load
    window.addEventListener('DOMContentLoaded', (event) => {
        // Pre-select Day or first available package
        const initialUnit = 'Day';
        const initialPrice = @(Model?.PricePerDay ?? 0);
        selectPackage(initialUnit, initialPrice);

        // Fetch and load calendar days dynamically from DB
        fetchBookedDates();
    });
</script>

@model WEB.Models.ProductViewModel

@{
    ViewData["Title"] = Model?.ProductName ?? "Chi tiết sản phẩm";

    var categoryName = Model?.Category?.CategoryName?.ToLower() ?? "";
    var productName = Model?.ProductName?.ToLower() ?? "";

    // 1. Xử lý huy hiệu danh mục
    var categoryBadge = Model?.Category?.CategoryName ?? "SẢN PHẨM";
    if (categoryName.Contains("trang phục") || categoryName.Contains("áo dài") || productName.Contains("áo dài") || productName.Contains("lễ phục"))
    {
        categoryBadge = "TRANG PHỤC";
    }
    else if (categoryName.Contains("thiết bị") || categoryName.Contains("điện tử") || productName.Contains("máy ảnh") || productName.Contains("loa") || productName.Contains("sony") || productName.Contains("chiếu"))
    {
        categoryBadge = "THIẾT BỊ";
    }

    // 2. LOGIC ẢNH THÔNG MINH
    var displayImages = new List<string>();
    var mainImageUrl = Model?.ImageUrl;

    bool isPlaceholder = string.IsNullOrEmpty(mainImageUrl) || mainImageUrl.Contains("unsplash.com");

    if (isPlaceholder)
    {
        if (productName.Contains("áo dài") || categoryName.Contains("áo dài")) mainImageUrl = "/images/aodai.png";
        else if (productName.Contains("lễ phục") || productName.Contains("tốt nghiệp")) mainImageUrl = "/images/dototnghiep.png";
        else if (productName.Contains("vest") || productName.Contains("suit")) mainImageUrl = "/images/vestnam.png";
        else if (productName.Contains("tai nghe") || productName.Contains("headphone") || productName.Contains("sony wh-1000xm4")) mainImageUrl = "/images/tainghe.png";
        else if (productName.Contains("máy chiếu") || productName.Contains("projector") || categoryName.Contains("trình chiếu")) mainImageUrl = "/images/maychieu.png";
        else if (productName.Contains("guitar") || productName.Contains("đàn") || categoryName.Contains("nhạc cụ")) mainImageUrl = "/images/guitar.png";
        else if (productName.Contains("xe đạp") || productName.Contains("giant") || productName.Contains("bike")) mainImageUrl = "/images/xedap.png";
        else if (productName.Contains("ipad") || productName.Contains("tablet")) mainImageUrl = "/images/ipad.png";
        else if (productName.Contains("macbook") || productName.Contains("laptop")) mainImageUrl = "/images/mac.png";
        else if (productName.Contains("máy ảnh") || productName.Contains("camera") || categoryName.Contains("máy ảnh")) mainImageUrl = "/images/mayanh.png";
        else if (categoryName.Contains("sách") || categoryName.Contains("giáo trình") || productName.Contains("sách")) mainImageUrl = "/images/giaitich1.png";
    }

    if (!string.IsNullOrEmpty(mainImageUrl))
    {
        displayImages.Add(mainImageUrl);
    }

    if (Model?.ProductImages != null && Model.ProductImages.Any())
    {
        foreach (var img in Model.ProductImages)
        {
            if (!string.IsNullOrEmpty(img) && !displayImages.Contains(img))
            {
                displayImages.Add(img);
            }
        }
    }

    if (isPlaceholder)
    {
        if (productName.Contains("áo dài") || categoryName.Contains("áo dài"))
        {
            var extra = new List<string> {
                "https://down-vn.img.susercontent.com/file/sg-11134201-7rauq-machlz7wuvyp42.webp",
                "https://down-vn.img.susercontent.com/file/vn-11134207-7ra0g-m6s3efkjxflk0a.webp",
                "https://down-vn.img.susercontent.com/file/vn-11134207-7ras8-mc2z1eac8bjmba.webp",
                "https://down-vn.img.susercontent.com/file/vn-11134207-7ras8-mc2z1l1oc86q49.webp"
            };
            foreach (var img in extra) { if (!displayImages.Contains(img)) displayImages.Add(img); }
        }
        else if (productName.Contains("lễ phục") || categoryName.Contains("lễ phục") || productName.Contains("tốt nghiệp"))
        {
            var extra = new List<string> {
                "https://images.unsplash.com/photo-1523050854058-8df90110c9f1?w=800",
                "https://images.unsplash.com/photo-1541339907198-e08756dedf3f?w=800",
                "https://images.unsplash.com/photo-1525921429624-479b6c294591?w=800",
                "https://images.unsplash.com/photo-1589156280159-27698a70f29e?w=800"
            };
            foreach (var img in extra) { if (!displayImages.Contains(img)) displayImages.Add(img); }
        }
        else if (productName.Contains("vest") || productName.Contains("suit"))
        {
            var extra = new List<string> {
                "https://images.unsplash.com/photo-1507679799987-c73779587ccf?w=800",
                "https://images.unsplash.com/photo-1594938298603-c8148c4dae35?w=800",
                "https://images.unsplash.com/photo-1593032465175-481ac7f401a0?w=800",
                "https://images.unsplash.com/photo-1598808503746-f34c53b20ef3?w=800"
            };
            foreach (var img in extra) { if (!displayImages.Contains(img)) displayImages.Add(img); }
        }
        else if (productName.Contains("macbook") || productName.Contains("laptop"))
        {
            var extra = new List<string> {
                "https://images.unsplash.com/photo-1517336714731-489689fd1ca8?w=800",
                "https://images.unsplash.com/photo-1611186871348-b1ce696e52c9?w=800",
                "https://images.unsplash.com/photo-1496181130204-755241544e3f?w=800",
                "https://images.unsplash.com/photo-1525547719571-a2d4ac8945e2?w=800"
            };
            foreach (var img in extra) { if (!displayImages.Contains(img)) displayImages.Add(img); }
        }
        else if (productName.Contains("ipad") || productName.Contains("tablet"))
        {
            var extra = new List<string> {
                "https://images.unsplash.com/photo-1544244015-0df4b3ffc6b0?w=800",
                "https://images.unsplash.com/photo-1589739900243-4b52cd9b104e?w=800",
                "https://images.unsplash.com/photo-1511385348-a52b4a160dc2?w=800",
                "https://images.unsplash.com/photo-1611532736597-de2d4265fba3?w=800"
            };
            foreach (var img in extra) { if (!displayImages.Contains(img)) displayImages.Add(img); }
        }
        else if (productName.Contains("máy ảnh") || productName.Contains("camera") || categoryName.Contains("máy ảnh"))
        {
            var extra = new List<string> {
                "https://images.unsplash.com/photo-1502920917128-1aa500764cbd?w=800",
                "https://images.unsplash.com/photo-1516035069371-29a1b244cc32?w=800",
                "https://images.unsplash.com/photo-1512790182412-b19e6d62bc39?w=800",
                "https://images.unsplash.com/photo-1495707902641-75cac588d2e9?w=800"
            };
            foreach (var img in extra) { if (!displayImages.Contains(img)) displayImages.Add(img); }
        }
        else if (productName.Contains("xe đạp") || productName.Contains("giant") || productName.Contains("bike"))
        {
            var extra = new List<string> {
                "https://images.unsplash.com/photo-1485965120184-e220f721d03e?w=800",
                "https://images.unsplash.com/photo-1532298229144-0ec0c57515c7?w=800",
                "https://images.unsplash.com/photo-1576435468114-7104e373c08d?w=800",
                "https://images.unsplash.com/photo-1507035895480-2b3156c31fc8?w=800"
            };
            foreach (var img in extra) { if (!displayImages.Contains(img)) displayImages.Add(img); }
        }
        else
        {
            var extra = new List<string> {
                "https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?w=800",
                "https://images.unsplash.com/photo-1506880018603-83d5b814b5a6?w=800",
                "https://images.unsplash.com/photo-1497633762265-9d179a990aa6?w=800",
                "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=800"
            };
            foreach (var img in extra) { if (!displayImages.Contains(img)) displayImages.Add(img); }
        }
    }

    // 3. Logic Đánh Giá Động
    var reviews = new List<dynamic>();
    if (productName.Contains("áo dài") || categoryName.Contains("áo dài"))
    {
        reviews.Add(new { UserName = "Hoàng Yến", Avatar = "https://ui-avatars.com/api/?name=Hoang+Yen&background=10b981&color=fff", Comment = "Áo dài form rất chuẩn, thơm tho sạch sẽ." });
        reviews.Add(new { UserName = "Thu Thảo", Avatar = "https://ui-avatars.com/api/?name=Thu+Thao&background=3b82f6&color=fff", Comment = "Chị chủ cho thuê siêu nhiệt tình, đồ đẹp xuất sắc!" });
    }
    else if (productName.Contains("vest") || productName.Contains("suit"))
    {
        reviews.Add(new { UserName = "Tuấn Anh", Avatar = "https://ui-avatars.com/api/?name=Tuan+Anh&background=f59e0b&color=fff", Comment = "Vest cực kỳ tôn dáng, mặc đi phỏng vấn rất tự tin." });
        reviews.Add(new { UserName = "Đình Phong", Avatar = "https://ui-avatars.com/api/?name=Dinh+Phong&background=10b981&color=fff", Comment = "Thủ tục nhanh gọn, kèm luôn cả cà vạt. 5 sao!" });
    }
    else if (productName.Contains("máy ảnh") || productName.Contains("camera"))
    {
        reviews.Add(new { UserName = "Nhật Minh", Avatar = "https://ui-avatars.com/api/?name=Nhat+Minh&background=10b981&color=fff", Comment = "Máy ảnh hoạt động hoàn hảo, lens trong veo không xước." });
        reviews.Add(new { UserName = "Khánh Vy", Avatar = "https://ui-avatars.com/api/?name=Khanh+Vy&background=ec4899&color=fff", Comment = "Chụp ảnh kỷ yếu lớp ra màu siêu đẹp, pin cực trâu." });
    }
    else
    {
        reviews.Add(new { UserName = "Minh Anh", Avatar = "https://ui-avatars.com/api/?name=Minh+Anh&background=2563eb&color=fff", Comment = "Sản phẩm đúng như mô tả, chất lượng rất tốt." });
        reviews.Add(new { UserName = "Thúy Trang", Avatar = "https://ui-avatars.com/api/?name=Thuy+Trang&background=c084fc&color=fff", Comment = "Giao nhận đúng giờ, chủ đồ hỗ trợ rất nhiệt tình. Rất hài lòng!" });
    }
}

<!-- Rent confirm overlay -->
<div id="rentConfirmOverlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.55); z-index:9999; align-items:center; justify-content:center;">
    <div style="background:#fff; border-radius:24px; padding:40px 36px; max-width:400px; width:90%; text-align:center; box-shadow:0 20px 50px rgba(0,0,0,0.2);">
        <div style="width:64px;height:64px;background:#e9ecea;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;">
            <i class="fas fa-clock" style="font-size:1.8rem;color:#4f6356;"></i>
        </div>
        <h3 style="font-size:1.25rem;font-weight:800;color:#111827;margin:0 0 12px;">Đặt thuê thành công!</h3>
        <p style="color:#4b5563;font-size:0.95rem;line-height:1.6;margin:0 0 8px;">
            Đơn hàng của bạn đang được gửi đến chủ đồ.<br>
            <strong style="color:#4f6356;">Vui lòng chờ chủ đồ xác nhận.</strong>
        </p>
        <p style="color:#9ca3af;font-size:0.8rem;margin:0;">Bạn sẽ được chuyển trang trong giây lát...</p>
        <div style="margin-top:20px; height:4px; background:#e5e7eb; border-radius:4px; overflow:hidden;">
            <div style="height:100%; background:#4f6356; border-radius:4px; animation: rentProgress 2.2s linear forwards;"></div>
        </div>
    </div>
</div>

<div class="lm-page-wrapper">
    <div class="lm-main-grid">

        <div class="lm-gallery">
            <div class="lm-main-image-box">
                <img src="@displayImages[0]" alt="@Model?.ProductName" id="mainImage" />
            </div>

            <div class="lm-thumbnails">
                @for (int i = 0; i < Math.Min(4, displayImages.Count); i++)
                {
                    <img src="@displayImages[i]" class="lm-thumb @(i == 0 ? "active" : "")" alt="Thumbnail @i" />
                }
            </div>
        </div>

        <div class="lm-info-section">
            <div class="lm-category">@categoryBadge</div>
            <h1 class="lm-title">@Model?.ProductName</h1>

            <div class="lm-rating">
                <div class="stars">
                    <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
                </div>
                <span>(Đánh giá 5.0)</span>
            </div>

            <p class="lm-short-desc">
                @(string.IsNullOrEmpty(Model?.Description) ? "Sản phẩm đang sẵn sàng để cho thuê. Liên hệ để biết thêm chi tiết." : (Model.Description.Length > 200 ? Model.Description.Substring(0, 200) + "..." : Model.Description))
            </p>

            <div class="lm-specs-grid">
                <div class="lm-spec-item">
                    <i class="fas fa-map-marker-alt"></i>
                    <div>
                        <strong>Vị trí</strong>
                        <span>@(string.IsNullOrEmpty(Model?.Location) ? "Đang cập nhật" : Model?.Location)</span>
                    </div>
                </div>
                <div class="lm-spec-item">
                    <i class="fas fa-shield-alt"></i>
                    <div>
                        <strong>Tiền cọc (Hoàn lại)</strong>
                        <span>@Model?.Deposit.ToString("N0")đ</span>
                    </div>
                </div>
                <div class="lm-spec-item">
                    <i class="fas fa-tags"></i>
                    <div>
                        <strong>Danh mục</strong>
                        <span>@Model?.Category?.CategoryName</span>
                    </div>
                </div>
                <div class="lm-spec-item">
                    <i class="fas fa-check-circle"></i>
                    <div>
                        <strong>Tình trạng</strong>
                        <span>Hoạt động tốt</span>
                    </div>
                </div>
            </div>

            <!-- RENTAL PACKAGES - Giống bài 1 nhưng style LendModern -->
            <div class="lm-rental-packages">
                <label class="lm-packages-label">
                    <i class="fas fa-cubes"></i> Chọn gói thuê
                </label>
                <div class="lm-packages-grid">
                    <!-- Gói Giờ -->
                    <div class="lm-package-card @(Model?.PricePerHour.HasValue == true && Model.PricePerHour.Value > 0 ? "" : "disabled")"
                         id="pkg-Hour"
                         data-unit="Hour"
                         data-price="@(Model?.PricePerHour ?? 0)">
                        <span class="lm-package-icon"><i class="fas fa-bolt"></i></span>
                        <div class="lm-package-title">Theo giờ</div>
                        <div class="lm-package-price">
                            @(Model?.PricePerHour.HasValue == true && Model.PricePerHour.Value > 0
                                                        ? Model.PricePerHour.Value.ToString("N0") + "đ"
                                                        : "N/A")
                        </div>
                    </div>

                    <!-- Gói Ngày (mặc định) -->
                    <div class="lm-package-card active"
                         id="pkg-Day"
                         data-unit="Day"
                         data-price="@(Model?.PricePerDay ?? 0)">
                        <span class="lm-package-icon"><i class="fas fa-calendar-day"></i></span>
                        <div class="lm-package-title">Theo ngày</div>
                        <div class="lm-package-price">@Model?.PricePerDay.ToString("N0")đ</div>
                    </div>

                    <!-- Gói Tuần -->
                    <div class="lm-package-card @(Model?.PricePerWeek.HasValue == true && Model.PricePerWeek.Value > 0 ? "" : "disabled")"
                         id="pkg-Week"
                         data-unit="Week"
                         data-price="@(Model?.PricePerWeek ?? 0)">
                        <span class="lm-package-icon"><i class="fas fa-calendar-week"></i></span>
                        <div class="lm-package-title">Theo tuần</div>
                        <div class="lm-package-price">
                            @(Model?.PricePerWeek.HasValue == true && Model.PricePerWeek.Value > 0
                                                        ? Model.PricePerWeek.Value.ToString("N0") + "đ"
                                                        : "N/A")
                        </div>
                    </div>

                    <!-- Gói Tháng -->
                    <div class="lm-package-card @(Model?.PricePerMonth.HasValue == true && Model.PricePerMonth.Value > 0 ? "" : "disabled")"
                         id="pkg-Month"
                         data-unit="Month"
                         data-price="@(Model?.PricePerMonth ?? 0)">
                        <span class="lm-package-icon"><i class="fas fa-calendar-alt"></i></span>
                        <div class="lm-package-title">Theo tháng</div>
                        <div class="lm-package-price">
                            @(Model?.PricePerMonth.HasValue == true && Model.PricePerMonth.Value > 0
                                                        ? Model.PricePerMonth.Value.ToString("N0") + "đ"
                                                        : "N/A")
                        </div>
                    </div>
                </div>
            </div>

            <!-- FORM THUÊ -->
            <div class="lm-booking-box">
                <form id="rentForm" asp-action="Rent" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model?.ProductId" />
                    <input type="hidden" id="rentalUnit" name="rentalUnit" value="Day" />
                    <input type="hidden" id="duration" name="duration" value="1" />

                    <!-- Duration Picker -->
                    <div class="lm-duration-section">
                        <label id="durationLabel" class="lm-duration-label">
                            <i class="fas fa-hourglass-half"></i> Số ngày thuê
                        </label>
                        <div class="lm-duration-controls">
                            <button type="button" class="lm-duration-btn" onclick="adjustDuration(-1)">−</button>
                            <input type="number" id="rentalDuration" class="lm-duration-input" value="1" min="1" step="1" onchange="updateDurationFromInput()" />
                            <button type="button" class="lm-duration-btn" onclick="adjustDuration(1)">+</button>
                            <span id="durationUnitText" class="lm-duration-unit">ngày</span>
                        </div>
                    </div>

                    <!-- Date Picker -->
                    <div class="lm-date-picker-grid">
                        <div class="lm-date-input">
                            <label><i class="far fa-calendar-alt"></i> Ngày bắt đầu</label>
                            <input type="datetime-local" id="startDate" name="startDate" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                        </div>
                    </div>

                    <!-- Checkout Summary -->
                    <div class="lm-summary-box">
                        <div class="lm-summary-title">Tóm tắt thanh toán ký quỹ</div>
                        <div class="lm-summary-row">
                            <span>Giá gói thuê:</span>
                            <strong id="summaryUnitPrice">@Model?.PricePerDay.ToString("N0") đ</strong>
                        </div>
                        <div class="lm-summary-row">
                            <span>Thời lượng thuê:</span>
                            <strong id="summaryDuration">x 1 ngày</strong>
                        </div>
                        <div class="lm-summary-row lm-summary-divider">
                            <span>Thành tiền thuê:</span>
                            <strong id="summaryRentTotal" style="color: #111827;">@Model?.PricePerDay.ToString("N0") đ</strong>
                        </div>
                        <div class="lm-summary-row">
                            <span>Tiền đặt cọc (hoàn 100%):</span>
                            <strong>+ @Model?.Deposit.ToString("N0") đ</strong>
                        </div>
                        <div class="lm-summary-row lm-summary-total">
                            <span>Tổng cộng tạm giữ:</span>
                            <strong id="summaryGrandTotal" style="color: #4f6356; font-size: 1.3rem;">
                                @((Model?.PricePerDay + Model?.Deposit ?? 0).ToString("N0")) đ
                            </strong>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="lm-action-buttons" style="display: flex; flex-direction: column; gap: 10px;">
                        @if (ViewBag.IsOwner == true)
                        {
                            <button type="button" class="lm-btn-disabled" disabled>SẢN PHẨM CỦA BẠN</button>
                        }
                        else if (ViewBag.IsLoggedIn == true)
                        {
                            <button type="submit" class="lm-btn-primary">
                                <i class="fas fa-credit-card"></i> THUÊ NGAY KÝ QUỸ
                            </button>
                            <button type="button" class="lm-btn-outline-primary" onclick="addToCart()">
                                <i class="fas fa-shopping-cart"></i> THÊM VÀO GIỎ HÀNG
                            </button>
                            <a href="/Message?receiverId=@Model?.OwnerId&productId=@Model?.ProductId" class="lm-btn-outline-primary" style="display: flex; justify-content: center; align-items: center; text-decoration: none; border-color: #4f6356; color: #4f6356;">
                                <i class="far fa-comments"></i> NHẮN TIN VỚI CHỦ ĐỒ
                            </a>
                        }
                        else
                        {
                            <a href="/Account/Login?returnUrl=@Context.Request.Path" class="lm-btn-primary" style="display: flex; justify-content: center; align-items: center; text-decoration: none;">
                                ĐĂNG NHẬP ĐỂ THUÊ
                            </a>
                            <a href="/Account/Login?returnUrl=@Context.Request.Path" class="lm-btn-outline-primary" style="display: flex; justify-content: center; align-items: center; text-decoration: none;">
                                ĐĂNG NHẬP ĐỂ THÊM VÀO GIỎ
                            </a>
                            <a href="/Account/Login?returnUrl=@Context.Request.Path" class="lm-btn-outline-primary" style="display: flex; justify-content: center; align-items: center; text-decoration: none; border-color: #4f6356; color: #4f6356;">
                                ĐĂNG NHẬP ĐỂ NHẮN TIN
                            </a>
                        }
                    </div>

                    <div class="lm-safe-text">
                        <i class="fas fa-shield-alt"></i> Tiền cọc sẽ được hoàn 100% khi trả đồ
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="lm-section">
        <h2 class="lm-section-title">Chi tiết sản phẩm</h2>
        <div class="lm-long-desc">
            @if (!string.IsNullOrEmpty(Model?.Description))
            {
                <p>@Html.Raw(Model.Description.Replace("\n", "<br/>"))</p>
            }
            else
            {
                <p>Chủ sản phẩm chưa cập nhật mô tả chi tiết cho sản phẩm này.</p>
            }
        </div>
    </div>

    <div class="lm-section">
        <h2 class="lm-section-title">Đánh giá từ người thuê</h2>
        <div class="lm-reviews-grid">
            @foreach (var r in reviews)
            {
                <div class="lm-review-card">
                    <div class="lm-review-header">
                        <img src="@r.Avatar" alt="@r.UserName" class="lm-review-avatar" />
                        <div>
                            <div class="lm-review-name">@r.UserName</div>
                            <div class="lm-review-date">Đã thuê thành công</div>
                        </div>
                    </div>
                    <div class="lm-rating" style="margin-bottom: 8px;">
                        <div class="stars" style="font-size: 0.8rem;">
                            <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
                        </div>
                    </div>

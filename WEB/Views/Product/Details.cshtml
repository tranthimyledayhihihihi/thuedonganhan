<script>
    // State
    let currentUnit = 'Day';
    let currentPrice = @(Model?.PricePerDay ?? 0);
    const depositAmount = @(Model?.Deposit ?? 0);

    // Elements
    const rentalUnitInput = document.getElementById('rentalUnit');
    const durationInput = document.getElementById('duration');
    const rentalDurationInput = document.getElementById('rentalDuration');
    const durationLabel = document.getElementById('durationLabel');
    const durationUnitText = document.getElementById('durationUnitText');

    // Select Package
    function selectPackage(unit, price) {
        const card = document.getElementById('pkg-' + unit);
        if (card.classList.contains('disabled')) return;

        // Remove active class from all
        document.querySelectorAll('.lm-package-card').forEach(c => c.classList.remove('active'));

        // Add active to selected
        card.classList.add('active');

        // Update state
        currentUnit = unit;
        currentPrice = price;

        // Update hidden input
        rentalUnitInput.value = unit;

        // Update UI text
        let labelText = "Số ngày thuê";
        let unitText = "ngày";
        if (unit === 'Hour') {
            labelText = "Số giờ thuê";
            unitText = "giờ";
        } else if (unit === 'Week') {
            labelText = "Số tuần thuê";
            unitText = "tuần";
        } else if (unit === 'Month') {
            labelText = "Số tháng thuê";
            unitText = "tháng";
        }

        durationLabel.innerHTML = `<i class="fas fa-hourglass-half"></i> ${labelText}`;
        durationUnitText.innerText = unitText;

        // Reset duration to 1 when switching package
        rentalDurationInput.value = 1;
        durationInput.value = 1;

        updateCalculations();
    }

    // Adjust duration
    function adjustDuration(change) {
        let val = parseInt(rentalDurationInput.value) || 1;
        val += change;
        if (val < 1) val = 1;
        rentalDurationInput.value = val;
        durationInput.value = val;
        updateCalculations();
    }

    function updateDurationFromInput() {
        let val = parseInt(rentalDurationInput.value) || 1;
        if (val < 1) val = 1;
        rentalDurationInput.value = val;
        durationInput.value = val;
        updateCalculations();
    }

    // Update summary calculations
    function updateCalculations() {
        const duration = parseInt(durationInput.value) || 1;
        const totalRent = currentPrice * duration;
        const grandTotal = totalRent + depositAmount;

        let unitText = "ngày";
        if (currentUnit === 'Hour') unitText = "giờ";
        if (currentUnit === 'Week') unitText = "tuần";
        if (currentUnit === 'Month') unitText = "tháng";

        const formatter = new Intl.NumberFormat('vi-VN');

        document.getElementById('summaryUnitPrice').innerHTML = formatter.format(currentPrice) + ' đ/' + unitText;
        document.getElementById('summaryDuration').innerHTML = 'x ' + duration + ' ' + unitText;
        document.getElementById('summaryRentTotal').innerHTML = formatter.format(totalRent) + ' đ';
        document.getElementById('summaryGrandTotal').innerHTML = formatter.format(grandTotal) + ' đ';
    }

    // Thumbnail click
    document.addEventListener('DOMContentLoaded', function() {
        const mainImage = document.getElementById('mainImage');
        const thumbnails = document.querySelectorAll('.lm-thumb');

        thumbnails.forEach(thumb => {
            thumb.addEventListener('click', function() {
                mainImage.style.opacity = '0.5';
                setTimeout(() => {
                    mainImage.src = this.src;
                    mainImage.style.opacity = '1';
                }, 150);
                thumbnails.forEach(t => t.classList.remove('active'));
                this.classList.add('active');
            });
        });

        // Package click handlers
        document.querySelectorAll('.lm-package-card').forEach(card => {
            card.addEventListener('click', function() {
                if (this.classList.contains('disabled')) return;
                const unit = this.dataset.unit;
                const price = parseFloat(this.dataset.price);
                selectPackage(unit, price);
            });
        });

        // Initialize
        selectPackage('Day', @(Model?.PricePerDay ?? 0));
    });

    // Rent form: intercept submit and show confirmation overlay
    document.getElementById('rentForm').addEventListener('submit', function(e) {
        e.preventDefault();
        const overlay = document.getElementById('rentConfirmOverlay');
        overlay.style.display = 'flex';
        setTimeout(() => { this.submit(); }, 2200);
    });

    // Add to cart function
    const isLoggedIn = @(ViewBag.IsLoggedIn == true ? "true" : "false");

    function addToCart() {
        if (!isLoggedIn) {
            window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
            return;
        }

        const productId = @Model?.ProductId;
        const productName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.ProductName));
        const imageUrl = "@Html.Raw(displayImages.FirstOrDefault() ?? "/images/mayanh.png")";
        const duration = parseInt(durationInput.value) || 1;
        const startDate = document.getElementById('startDate').value;
        const depositAmountVal = @(Model?.Deposit ?? 0);

        let cart = JSON.parse(localStorage.getItem('uterent_cart') || '[]');

        cart = cart.filter(item => item.productId !== productId);

        cart.push({
            productId: productId,
            name: productName,
            imageUrl: imageUrl,
            price: currentPrice,
            unit: currentUnit,
            duration: duration,
            deposit: depositAmountVal,
            startDate: startDate
        });

        localStorage.setItem('uterent_cart', JSON.stringify(cart));

        if (typeof updateLayoutCartBadge === 'function') {
            updateLayoutCartBadge();
        }

        alert("🛒 Đã thêm sản phẩm \"" + productName + "\" vào giỏ hàng của bạn!");
    }
</script>
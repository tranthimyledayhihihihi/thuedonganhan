<script>
    // Xử lý price tags
    document.querySelectorAll('.price-tag').forEach(tag => {
        tag.addEventListener('click', function(e) {
            e.preventDefault();
            const text = this.textContent.trim();
            let minPrice = '';
            let maxPrice = '';
            
            if (text === 'Dưới 10k') { minPrice = 0; maxPrice = 10000; }
            else if (text === '10k - 50k') { minPrice = 10000; maxPrice = 50000; }
            else if (text === '50k - 100k') { minPrice = 50000; maxPrice = 100000; }
            else if (text === 'Trên 100k') { minPrice = 100000; maxPrice = ''; }
            
            document.querySelector('input[name="minPrice"]').value = minPrice;
            document.querySelector('input[name="maxPrice"]').value = maxPrice;
            
            document.getElementById('filterForm').submit();
        });
    });
    
    // Auto-submit when typing prices and pressing Enter, or focus out
    document.querySelectorAll('input[name="minPrice"], input[name="maxPrice"]').forEach(input => {
        input.addEventListener('change', function() {
            document.getElementById('filterForm').submit();
        });
    });
</script>

<style>
    .price-tag.active {
        background: #eff6ff;
        border-color: var(--primary-blue);
        color: var(--primary-blue);
        font-weight: 600;
    }
</style>

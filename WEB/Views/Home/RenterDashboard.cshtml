<script>
    function filterTab(el, cat) {
        document.querySelectorAll('.lm-rtab').forEach(function(t){ t.classList.remove('active'); });
        el.classList.add('active');
        document.querySelectorAll('.lm-product-card').forEach(function(c){
            if (cat === 'all' || c.dataset.cat === cat) {
                c.style.display = '';
            } else {
                c.style.display = 'none';
            }
        });
    }
</script>
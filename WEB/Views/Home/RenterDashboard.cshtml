@{
    ViewData["Title"] = "Người thuê - Đơn của tôi";
    var allProducts = ViewBag.AllProducts as List<WEB.Models.ProductViewModel> ?? new List<WEB.Models.ProductViewModel>();
    var myRentals = ViewBag.MyRentals as List<WEB.Models.RentalViewModel> ?? new List<WEB.Models.RentalViewModel>();
    var userName = Context.Session.GetString("UserName") ?? "Sinh viên UTE";

    var activeRentals = myRentals.Where(r => r.Status == "Pending" || r.Status == "Confirmed" || r.Status == "InProgress" || r.Status == "Active").ToList();
    var historyRentals = myRentals.Where(r => r.Status == "Returned" || r.Status == "Completed" || r.Status == "Cancelled").ToList();
}

@functions {
    public string GetPerfectCardImage(WEB.Models.ProductViewModel product)
    {
        if (product == null) return "/images/placeholder.png";
        var cardImageUrl = product.ImageUrl;
        bool isPlaceholder = string.IsNullOrEmpty(cardImageUrl) || cardImageUrl.Contains("unsplash.com");
        if (!isPlaceholder) return cardImageUrl;

        var pName = product.ProductName?.ToLower() ?? "";
        var cName = product.Category?.CategoryName?.ToLower() ?? "";

        if (pName.Contains("áo dài") || cName.Contains("áo dài")) return "/images/aodai.png";
        if (pName.Contains("lễ phục") || pName.Contains("tốt nghiệp")) return "/images/dototnghiep.png";
        if (pName.Contains("vest") || pName.Contains("suit")) return "/images/vestnam.png";
        if (pName.Contains("tai nghe") || pName.Contains("headphone") || cName.Contains("âm thanh") || pName.Contains("sony wh-1000xm4")) return "/images/tainghe.png";
        if (pName.Contains("máy chiếu") || pName.Contains("projector") || cName.Contains("trình chiếu")) return "/images/maychieu.png";
        if (pName.Contains("guitar") || pName.Contains("đàn") || cName.Contains("nhạc cụ")) return "/images/guitar.png";
        if (pName.Contains("xe đạp") || pName.Contains("giant") || pName.Contains("bike")) return "/images/xedap.png";
        if (pName.Contains("ipad") || pName.Contains("tablet")) return "/images/ipad.png";
        if (pName.Contains("macbook") || pName.Contains("laptop")) return "/images/mac.png";
        if (pName.Contains("máy ảnh") || pName.Contains("camera") || cName.Contains("máy ảnh")) return "/images/mayanh.png";
        if (pName.Contains("xe máy") || pName.Contains("wave") || cName.Contains("xe cộ")) return "https://images.unsplash.com/photo-1558981806-ec527fa84c39?w=800";
        if (cName.Contains("sách") || cName.Contains("giáo trình") || pName.Contains("sách")) return "/images/giaitich1.png";

        return cardImageUrl;
    }
}

<div class="lm-app-layout">
    <aside class="lm-sidebar">
        <div class="lm-sidebar-brand">
            <div class="lm-sidebar-avatar">
                <img src="https://ui-avatars.com/api/?name=@userName&background=8b5a3c&color=fff" alt="@userName" />
            </div>
            <div class="lm-sidebar-user-info">
                <div class="lm-sidebar-label">Trung tâm điều khiển</div>
                <div class="lm-sidebar-sub">Xin chào, @userName</div>
            </div>
        </div>

        <nav class="lm-sidebar-nav">
            <a href="/" class="lm-snav-item"><i class="fas fa-home"></i><span>Trang chủ</span></a>
            <a href="/Home/RenterDashboard" class="lm-snav-item active"><i class="fas fa-shopping-bag"></i><span>Người thuê</span></a>
            <a href="/Home/OwnerDashboard" class="lm-snav-item"><i class="fas fa-store"></i><span>Người cho thuê</span></a>
        </nav>

        <div class="lm-sidebar-footer">
            <a href="/Post/Create" class="lm-btn-add-post">
                <i class="fas fa-plus"></i> Đăng sản phẩm mới
            </a>
        </div>
    </aside>

    <main class="lm-main">

        <div class="lm-hero">
            <div class="lm-hero-content">
                <h1>Chào mừng trở lại, @userName!</h1>
                <p>Hôm nay bạn cần tìm thuê thiết bị gì cho đồ án hay muốn chia sẻ vật dụng để kiếm thêm thu nhập?</p>
                <div class="lm-hero-actions">
                    <a href="/Product" class="lm-btn-hero-outline">Khám phá đồ thuê</a>
                    <a href="/Home/OwnerDashboard" class="lm-btn-hero-outline">Quản lý đồ của tôi</a>
                </div>
            </div>
            <div class="lm-hero-deco"><i class="fab fa-envira"></i></div>
        </div>

        <div class="lm-container">
            <div class="lm-header-section">
                <h2 class="lm-page-title">Đơn thuê của tôi</h2>
                <div class="lm-controls">
                    <div class="lm-tabs">
                        <button class="lm-tab active">Tất cả</button>
                        <button class="lm-tab">Đang thuê</button>
                        <button class="lm-tab">Đã trả</button>
                    </div>
                    <div class="lm-search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" placeholder="Tìm kiếm đơn hàng..." />
                    </div>
                </div>
            </div>

            <div class="lm-grid-layout">

                <div class="lm-main-col">
                    <div class="lm-section-header">
                        <h3>Đơn thuê hiện tại</h3>
                        <span class="lm-badge lm-badge-light-green">@activeRentals.Count ĐANG HOẠT ĐỘNG</span>
                    </div>

                    <div class="lm-cards-list">
                        @if (activeRentals.Any())
                        {
                            foreach (var rental in activeRentals)
                            {
                                var daysLeft = (rental.EndDate - DateTime.Now).Days;
                                var timeLeftStr = daysLeft >= 0 ? $"Còn {daysLeft} ngày" : "Quá hạn";
                                var isOverdue = daysLeft < 0;

                                var statusText = rental.Status == "Pending" ? "Chờ xác nhận" :
                                (rental.Status == "Confirmed" ? "Chờ giao" :
                                (rental.Status == "InProgress" ? "Chờ bạn nhận" : "Đang thuê"));
                                var statusBadgeClass = rental.Status == "Pending" ? "lm-badge-yellow" : "lm-badge-green";

                                <div class="lm-card active-rental-card">
                                    <div class="lm-card-img">
                                        <img src="@GetPerfectCardImage(rental.Product)" alt="@(rental.Product?.ProductName)" />
                                    </div>
                                    <div class="lm-card-info">
                                        <div class="lm-card-top-row">
                                            <h4 class="lm-item-name">@(rental.Product?.ProductName ?? "Sản phẩm")</h4>
                                            <div class="lm-time-indicator @(isOverdue ? "overdue" : "")">
                                                <i class="far fa-clock"></i> @timeLeftStr
                                            </div>
                                        </div>
                                        <p class="lm-item-desc">Chủ đồ: @(rental.Product?.Owner?.FullName ?? "Đang cập nhật") | <i class="fas fa-map-marker-alt"></i> @(rental.Product?.Location ?? "Chưa rõ")</p>

                                        <div class="lm-card-meta">
                                            <span class="lm-badge @statusBadgeClass">@statusText</span>
                                            <span class="lm-order-id">#LM-@rental.RentalId.ToString("D5")</span>
                                            <span class="lm-order-price">@rental.TotalPrice.ToString("N0")đ</span>
                                        </div>

                                        <div class="lm-card-actions">
                                            @if (rental.Status == "Pending" || rental.Status == "Confirmed")
                                            {
                                                <form asp-controller="Home" asp-action="CancelRental" method="post" style="margin:0;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="rentalId" value="@rental.RentalId" />
                                                    <button type="submit" class="lm-btn lm-btn-danger" onclick="return confirm('Xác nhận hủy đơn? Tiền sẽ được hoàn lại.');">Hủy đơn</button>
                                                </form>
                                            }
                                            else if (rental.Status == "InProgress")
                                            {
                                                <form asp-controller="Home" asp-action="ReceiveRental" method="post" style="margin:0;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="rentalId" value="@rental.RentalId" />
                                                    <button type="submit" class="lm-btn lm-btn-primary"><i class="fas fa-check"></i> Đã nhận đồ</button>
                                                </form>
                                                <a href="/Complaint/Create?rentalId=@rental.RentalId" class="lm-btn lm-btn-warning" title="Khiếu nại"><i class="fas fa-exclamation-triangle"></i></a>
                                            }
                                            else if (rental.Status == "Active")
                                            {
                                                <form asp-controller="Home" asp-action="ReturnRental" method="post" style="margin:0;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="rentalId" value="@rental.RentalId" />
                                                    <button type="submit" class="lm-btn lm-btn-primary"><i class="fas fa-undo"></i> Trả đồ cho chủ</button>
                                                </form>
                                                <a href="/Complaint/Create?rentalId=@rental.RentalId" class="lm-btn lm-btn-warning" title="Khiếu nại"><i class="fas fa-exclamation-triangle"></i></a>
                                            }

                                            <a href="/Product/Details/@rental.ProductId" class="lm-btn-icon" title="Xem chi tiết">
                                                <i class="fas fa-ellipsis-h"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="lm-empty-state">
                                <p>Bạn không có đơn thuê nào đang hoạt động.</p>
                            </div>
                        }
                    </div>

                    <div class="lm-section-header" style="margin-top: 2.5rem;">
                        <h3>Lịch sử thuê đồ</h3>
                        <a href="#" class="lm-view-all">Xem tất cả</a>
                    </div>

                    <div class="lm-cards-list">
                        @if (historyRentals.Any())
                        {
                            foreach (var rental in historyRentals)
                            {
                                var totalDays = (rental.EndDate - rental.StartDate).Days;
                                if (totalDays <= 0) totalDays = 1;
                                var isCompleted = rental.Status == "Completed" || rental.Status == "Returned";

                                <div class="lm-card history-rental-card">
                                    <div class="lm-card-img-small">
                                        <img src="@GetPerfectCardImage(rental.Product)" alt="@(rental.Product?.ProductName)" />
                                    </div>
                                    <div class="lm-history-info">
                                        <h4 class="lm-item-name">@(rental.Product?.ProductName ?? "Sản phẩm")</h4>
                                        <p class="lm-item-date">Đã trả: @rental.EndDate.ToString("dd/MM/yyyy") | @totalDays ngày</p>
                                    </div>

                                    <div class="lm-history-price-col">
                                        <div class="lm-price">@rental.TotalPrice.ToString("N0")đ</div>
                                        <span class="lm-badge @(isCompleted ? "lm-badge-light-green" : "lm-badge-gray")">
                                            @(isCompleted ? "HOÀN THÀNH" : "ĐÃ HỦY")
                                        </span>
                                    </div>

                                    <div class="lm-history-actions">
                                        <a href="/Product/Details/@rental.ProductId" class="lm-btn-outline">Chi tiết</a>
                                        <a href="/Product/Details/@rental.ProductId" class="lm-btn-brown">Thuê lại</a>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="lm-empty-state">
                                <p>Chưa có lịch sử thuê đồ.</p>
                            </div>
                        }
                    </div>

                    <div class="lm-pagination-row">
                        <span class="lm-showing-text">Hiển thị @myRentals.Count đơn thuê</span>
                        <div class="lm-pagination-controls">
                            <button disabled><i class="fas fa-chevron-left"></i></button>
                            <button><i class="fas fa-chevron-right"></i></button>
                        </div>
                    </div>

                </div>

                <div class="lm-side-col">
                    <div class="lm-impact-widget">
                        <div class="lm-impact-header">
                            <div class="lm-impact-icon"><i class="fab fa-envira"></i></div>
                            <h3>Tác động tích cực</h3>
                        </div>
                        <p class="lm-impact-text">Bạn đã giúp giảm thiểu <strong>12.5kg CO2</strong> bằng cách sử dụng dịch vụ thuê chung thay vì mua mới trong tháng này.</p>
                        <div class="lm-progress-container">
                            <div class="lm-progress-bar"><div class="lm-progress-fill" style="width: 65%;"></div></div>
                            <span class="lm-progress-label">65% mục tiêu tháng của bạn</span>
                        </div>
                    </div>
                </div>

            </div> <div class="lm-recommend-section">
                <div class="lm-recommend-header">
                    <div>
                        <h2 class="lm-section-title">Gợi ý dành riêng cho bạn</h2>
                        <p class="lm-section-sub">Dựa trên các tìm kiếm và ngành học của bạn</p>
                    </div>
                    <div class="lm-recommend-tabs">
                        <button class="lm-rtab active" onclick="filterTab(this,'all')">Tất cả</button>
                        <button class="lm-rtab" onclick="filterTab(this,'Điện tử')">Điện tử</button>
                        <button class="lm-rtab" onclick="filterTab(this,'Giáo trình')">Giáo trình</button>
                    </div>
                </div>

                @{
                    var featured = allProducts.FirstOrDefault();
                    var rest = allProducts.Skip(1).Take(4).ToList();
                }

                @if (allProducts.Any())
                {
                    <div class="lm-recommend-grid">
                        <div class="lm-product-card featured-card" data-cat="@(featured.Category?.CategoryName ?? "Khác")">
                            <div class="card-img-wrapper">
                                <span class="hot-badge">Hot Item</span>
                                <a href="/Product/Details/@featured.ProductId">
                                    <img src="@featured.ImageUrl" alt="@featured.ProductName" onerror="this.src='https://via.placeholder.com/600x380/dbeafe/2563eb?text=Product'">
                                </a>
                            </div>
                            <div class="card-body">
                                <div class="card-cat">@(featured.Category?.CategoryName?.ToUpper() ?? "KHÁC")</div>
                                <div class="card-rating"><i class="fas fa-star"></i> 4.9 (12 đánh giá)</div>
                                <a href="/Product/Details/@featured.ProductId" class="card-link">
                                    <h3 class="card-title">@featured.ProductName</h3>
                                </a>
                                <p class="card-desc">@(featured.Description?.Length > 80 ? featured.Description.Substring(0, 80) + "..." : featured.Description)</p>
                                <div class="card-footer">
                                    <div class="card-price">@featured.PricePerDay.ToString("N0")đ <span>/ngày</span></div>
                                    <a href="/Product/Details/@featured.ProductId" class="lm-btn-primary lm-btn-sm">Thuê ngay</a>
                                </div>
                            </div>
                        </div>

                        <div class="small-cards-grid">
                            @foreach (var product in rest)
                            {
                                <div class="lm-product-card small-card" data-cat="@(product.Category?.CategoryName ?? "Khác")">
                                    <div class="card-img-wrapper">
                                        <a href="/Product/Details/@product.ProductId">
                                            <img src="@product.ImageUrl" alt="@product.ProductName" onerror="this.src='https://via.placeholder.com/200x140/e2e8f0/94a3b8?text=No'">
                                        </a>
                                    </div>
                                    <div class="card-body">
                                        <div class="card-cat">@(product.Category?.CategoryName?.ToUpper() ?? "KHÁC")</div>
                                        <a href="/Product/Details/@product.ProductId" class="card-link">
                                            <h4 class="card-title-sm">@product.ProductName</h4>
                                        </a>
                                        <div class="card-footer-sm">
                                            <div class="card-price-sm">@product.PricePerDay.ToString("N0")đ<span>/ngày</span></div>
                                            <a href="/Product/Details/@product.ProductId" class="card-save-btn"><i class="far fa-bookmark"></i></a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="lm-view-more-container">
                        <a href="/Product" class="lm-btn-outline-more">Xem thêm sản phẩm <i class="fas fa-chevron-down"></i></a>
                    </div>
                }
                else
                {
                    <div class="lm-empty-state" style="padding: 3rem;">
                        <i class="fas fa-box-open" style="font-size: 2.5rem; color:#d0d0d0; margin-bottom:15px;"></i>
                        <p style="font-size: 1.1rem; color: var(--text-main); font-weight:600;">Chưa có sản phẩm nào</p>
                        <p>Hãy quay lại sau để xem các sản phẩm mới nhé.</p>
                    </div>
                }
            </div>

        </div>
    </main>
</div>

<style>
    :root {
        --bg-body: #f7f5f2;
        --card-bg: #ffffff;
        --text-main: #2b3a30;
        --text-muted: #8b9690;
        --primary-green: #3f5947;
        --primary-green-hover: #324738;
        --primary-brown: #8b5a3c;
        --primary-brown-hover: #734a30;
        --border-color: #f0ebe1;
        --sidebar-width: 240px;
        --badge-green-bg: #e6f0e9;
        --badge-green-text: #2f5c3f;
        --badge-yellow-bg: #fdf3e7;
        --badge-yellow-text: #b86e24;
        --badge-light-green: #dcfce7;
        --badge-light-green-text: #16a34a;
        --badge-gray: #f1f5f9;
        --badge-gray-text: #64748b;
        --widget-bg: #fdf1e5;
    }

    .lm-app-layout {
        display: flex;
        min-height: 100vh;
        background-color: var(--bg-body);
        font-family: 'Inter', sans-serif;
    }

    /* === SIDEBAR === */
    .lm-sidebar {
        width: var(--sidebar-width);
        background: #fff;
        border-right: 1px solid var(--border-color);
        position: sticky;
        top: 70px;
        height: calc(100vh - 70px);
        display: flex;
        flex-direction: column;
        padding-top: 1rem;
        z-index: 40;
    }

    .lm-sidebar-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 0 1.5rem 1.5rem;
        border-bottom: 1px solid var(--border-color);
        margin-bottom: 1rem;
    }

    .lm-sidebar-avatar img {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        object-fit: cover;
    }

    .lm-sidebar-label {
        font-size: 0.75rem;
        color: var(--primary-green);
        font-weight: 700;
        text-transform: uppercase;
    }

    .lm-sidebar-sub {
        font-size: 0.8rem;
        color: var(--text-muted);
    }

    .lm-sidebar-nav {
        flex: 1;
        padding: 0 1rem;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .lm-snav-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 15px;
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
        border-radius: 12px;
        transition: all 0.2s;
    }

        .lm-snav-item i {
            width: 20px;
            font-size: 1.1rem;
        }

        .lm-snav-item:hover {
            background: #fcfaf6;
            color: var(--text-main);
        }

        .lm-snav-item.active {
            background: var(--badge-green-bg);
            color: var(--badge-green-text);
        }

    .lm-sidebar-footer {
        padding: 1.5rem;
        border-top: 1px solid var(--border-color);
    }

    .lm-btn-add-post {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: var(--primary-brown);
        color: white;
        padding: 12px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        transition: 0.2s;
    }

        .lm-btn-add-post:hover {
            background: var(--primary-brown-hover);
        }

    /* === MAIN CONTENT === */
    .lm-main {
        flex: 1;
        padding-bottom: 3rem;
        min-width: 0;
    }

    /* Hero Banner */
    .lm-hero {
        background: var(--primary-green);
        padding: 3rem 4rem;
        position: relative;
        overflow: hidden;
    }

    .lm-hero-content {
        position: relative;
        z-index: 2;
        max-width: 600px;
    }

    .lm-hero h1 {
        font-size: 1.8rem;
        color: white;
        margin-bottom: 10px;
        font-weight: 700;
    }

    .lm-hero p {
        color: rgba(255,255,255,0.8);
        font-size: 0.95rem;
        margin-bottom: 20px;
        line-height: 1.5;
    }

    .lm-hero-actions {
        display: flex;
        gap: 15px;
    }

    .lm-btn-hero-outline {
        border: 1px solid rgba(255,255,255,0.4);
        color: white;
        padding: 10px 20px;
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s;
    }

        .lm-btn-hero-outline:hover {
            background: rgba(255,255,255,0.1);
            border-color: white;
        }

    .lm-hero-deco {
        position: absolute;
        right: 5%;
        top: 50%;
        transform: translateY(-50%);
        font-size: 12rem;
        color: rgba(255,255,255,0.05);
        z-index: 1;
    }

    /* Container chung */
    .lm-container {
        padding: 2rem 3rem;
        max-width: 1200px;
    }

    /* Header Phần Đơn Thuê */
    .lm-page-title {
        font-size: 1.8rem;
        font-weight: 800;
        color: var(--text-main);
        margin-bottom: 20px;
    }

    .lm-controls {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 15px;
        margin-bottom: 30px;
    }

    .lm-tabs {
        display: flex;
        gap: 20px;
    }

    .lm-tab {
        background: none;
        border: none;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--text-muted);
        cursor: pointer;
        padding-bottom: 10px;
        position: relative;
    }

        .lm-tab.active {
            color: var(--text-main);
        }

            .lm-tab.active::after {
                content: '';
                position: absolute;
                bottom: -16px;
                left: 0;
                width: 100%;
                height: 3px;
                background-color: var(--primary-brown);
                border-radius: 3px 3px 0 0;
            }

    .lm-search-box {
        position: relative;
        width: 250px;
    }

        .lm-search-box i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 0.85rem;
        }

        .lm-search-box input {
            width: 100%;
            padding: 10px 15px 10px 38px;
            border-radius: 50px;
            border: 1px solid #e0e0e0;

<script>
    async function updateRentalStatus(rentalId, status) {
        if (!confirm(`Bạn có chắc chắn muốn chuyển trạng thái đơn thuê sang: ${status == 'Active' ? 'Đang hoạt động (Bàn giao đồ)' : (status == 'Completed' ? 'Hoàn thành (Trả đồ & Giải ngân ví ký quỹ)' : 'Đã hủy đơn')}?`)) {
            return;
        }

        try {
            const response = await fetch(`/api/Rental/${rentalId}/status`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer @Context.Session.GetString("JWTToken")'
                },
                body: JSON.stringify(status)
            });

            const result = await response.json();
            if (response.ok && result.success) {
                alert(result.message || "Cập nhật trạng thái thành công!");
                // Cập nhật lại số dư navbar nếu có
                if (typeof fetchNavbarWalletBalance === 'function') {
                    await fetchNavbarWalletBalance();
                }
                location.reload();
            } else {
                alert(result.message || "Không thể cập nhật trạng thái đơn thuê!");
            }
        } catch (e) {
            console.error("Lỗi khi cập nhật trạng thái: ", e);
            alert("Lỗi kết nối máy chủ, vui lòng thử lại!");
        }
    }
</script>

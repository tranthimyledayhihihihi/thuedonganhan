@model WEB.Models.RentalViewModel
@{
    ViewData["Title"] = "Chi tiết đơn thuê";
    var rental = Model;
    var product = rental.Product;
    var renter = rental.Renter;

    var statusText = rental.Status == "Pending" ? "Đang chờ chủ đồ xác nhận đơn" :
                    (rental.Status == "Confirmed" ? "Đã xác nhận đơn - Chờ bàn giao đồ" :
                    (rental.Status == "Active" ? "Khách hàng đang thuê đồ" :
                    (rental.Status == "Completed" ? "Đơn thuê đã hoàn thành thành công" :
                    (rental.Status == "Cancelled" ? "Đơn thuê đã bị hủy" : rental.Status))));

    var statusBadgeText = rental.Status == "Pending" ? "CHỜ XÁC NHẬN" :
                         (rental.Status == "Confirmed" ? "CHỜ BÀN GIAO" :
                         (rental.Status == "Active" ? "ĐANG THUÊ" :
                         (rental.Status == "Completed" ? "HOÀN THÀNH" : rental.Status.ToUpper())));

    var statusBadgeClass = rental.Status == "Pending" ? "lm-badge-yellow" :
                          (rental.Status == "Confirmed" ? "lm-badge-blue" :
                          (rental.Status == "Active" ? "lm-badge-green" :
                          (rental.Status == "Completed" ? "lm-badge-light-green" : "lm-badge-gray")));

    var daysUntilReturn = (rental.EndDate - DateTime.Now).Days;
    var duration = (rental.EndDate - rental.StartDate).Days;
    if (duration == 0) duration = 1;

    var insuranceFee = 250000m;
    var shippingFee = 0m;
    var totalAmount = rental.TotalPrice + rental.DepositAmount + insuranceFee + shippingFee;
}

<div class="lm-app-layout">
    <aside class="lm-sidebar">
        <div class="lm-sidebar-brand">
            <div class="lm-sidebar-avatar">
                <img src="https://ui-avatars.com/api/?name=Admin&background=8b5a3c&color=fff" alt="Admin" />
            </div>
            <div class="lm-sidebar-user-info">
                <div class="lm-sidebar-label">Trung tâm điều khiển</div>
                <div class="lm-sidebar-sub">Quản lý Cửa hàng</div>
            </div>
        </div>

        <nav class="lm-sidebar-nav">
            <a href="/" class="lm-snav-item"><i class="fas fa-home"></i><span>Trang chủ</span></a>
            <a href="/Home/RenterDashboard" class="lm-snav-item"><i class="fas fa-shopping-bag"></i><span>Người thuê</span></a>
            <a href="/Home/OwnerDashboard" class="lm-snav-item active"><i class="fas fa-store"></i><span>Người cho thuê</span></a>
        </nav>

        <div class="lm-sidebar-footer">
            <a href="/Post/Create" class="lm-btn-add-post">
                <i class="fas fa-plus"></i> Đăng sản phẩm mới
            </a>
        </div>
    </aside>

    <main class="lm-main">
        <div class="lm-container">

            <div class="lm-page-header">
                <div class="lm-breadcrumbs">
                    <a href="/Home/OwnerDashboard">Người cho thuê</a>
                    <span class="lm-sep"><i class="fas fa-chevron-right"></i></span>
                    <span class="lm-current">Đơn hàng #RT-@rental.RentalId</span>
                </div>
                <div class="lm-header-flex">
                    <h1 class="lm-page-title">Chi tiết đơn thuê</h1>
                    <div class="lm-header-actions">
                        <button class="lm-btn-icon-outline" title="In hóa đơn"><i class="fas fa-print"></i></button>
                    </div>
                </div>
            </div>

            <div class="lm-detail-grid">
                <div class="lm-dg-left">

                    <div class="lm-status-banner">
                        <div class="lm-sb-content">
                            <span class="lm-badge @statusBadgeClass" style="margin-bottom: 15px;">
                                <i class="fas fa-circle" style="font-size: 8px;"></i> @statusBadgeText
                            </span>
                            <h2 class="lm-sb-title">@statusText</h2>
                            <p class="lm-sb-sub">
                                @if (rental.Status == "Active" || rental.Status == "Confirmed")
                                {
                                    <text>Hạn trả đồ trong @daysUntilReturn ngày (@rental.EndDate.ToString("dd/MM/yyyy"))</text>
                                }
                                else
                                {
                                    <text>Cập nhật lần cuối: @rental.CreatedAt.ToString("dd/MM/yyyy HH:mm")</text>
                                }
                            </p>
                        </div>

                        <div class="lm-sb-actions">
                            @if (rental.Status == "Pending")
                            {
                                <form asp-controller="Home" asp-action="ConfirmRental" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="rentalId" value="@rental.RentalId" />
                                    <button type="submit" class="lm-btn-primary"><i class="fas fa-check"></i> Xác nhận đơn</button>
                                </form>
                                <form asp-controller="Home" asp-action="CancelRental" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="rentalId" value="@rental.RentalId" />
                                    <button type="submit" class="lm-btn-danger"><i class="fas fa-times"></i> Từ chối</button>
                                </form>
                            }
                            else if (rental.Status == "Confirmed")
                            {
                                <form asp-controller="Home" asp-action="ConfirmDelivery" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="rentalId" value="@rental.RentalId" />
                                    <button type="submit" class="lm-btn-primary"><i class="fas fa-truck"></i> Xác nhận đã giao</button>
                                </form>
                                <form asp-controller="Home" asp-action="CancelRental" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="rentalId" value="@rental.RentalId" />
                                    <button type="submit" class="lm-btn-danger"><i class="fas fa-times"></i> Hủy đơn</button>
                                </form>
                            }
                            else if (rental.Status == "Active")
                            {
                                <div class="lm-info-alert">
                                    <i class="fas fa-info-circle"></i> Khách hàng đang dùng đồ. Chờ khách bấm "Đã trả đồ" trên hệ thống.
                                </div>
                            }
                            else if (rental.Status == "Returned")
                            {
                                <form asp-controller="Home" asp-action="ConfirmReturn" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="rentalId" value="@rental.RentalId" />
                                    <button type="submit" class="lm-btn-primary" style="background-color: #16a34a;"><i class="fas fa-check-double"></i> Nhận đồ & Hoàn cọc</button>
                                </form>
                            }
                            else if (rental.Status == "Completed")
                            {
                                <div class="lm-success-alert">
                                    <i class="fas fa-check-circle"></i> Đơn đã hoàn thành & Ví được cộng tiền!
                                </div>
                            }
                            else if (rental.Status == "Cancelled")
                            {
                                <div class="lm-error-alert">
                                    <i class="fas fa-times-circle"></i> Đơn đã bị hủy & Tiền hoàn lại cho khách!
                                </div>
                            }
                        </div>
                    </div>

                    <div class="lm-info-row">
                        <div class="lm-card">
                            <div class="lm-customer-header">
                                <div class="lm-c-avatar">@(renter?.FullName?.Substring(0, 2).ToUpper() ?? "KH")</div>
                                <div>
                                    <div class="lm-c-name">@(renter?.FullName ?? "Khách hàng")</div>
                                    <div class="lm-c-type">Thành viên thân thiết</div>
                                </div>
                            </div>
                            <div class="lm-customer-contact">
                                <div><i class="fas fa-phone-alt"></i> @(renter?.PhoneNumber ?? "+84 905 123 456")</div>
                                <div><i class="fas fa-map-marker-alt"></i> @(renter?.Email ?? "Đà Nẵng")</div>
                            </div>
                        </div>

                        <div class="lm-card">
                            <h3 class="lm-card-title-sm">LỊCH SỬ THUÊ (NGẮN GỌN)</h3>
                            <div class="lm-stat-line">
                                <span>Tổng đơn hàng</span>
                                <span class="lm-text-green">12 đơn</span>
                            </div>
                            <div class="lm-stat-line">
                                <span>Tỉ lệ trả đúng hạn</span>
                                <span class="lm-text-green">98%</span>
                            </div>
                            <div class="lm-stat-line">
                                <span>Đánh giá khách</span>
                                <span class="lm-stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></span>
                            </div>
                        </div>
                    </div>

                    <div class="lm-card lm-product-detail-card">
                        <div class="lm-pdc-img">
                            <img src="@(product?.ImageUrl)" alt="@(product?.ProductName)" onerror="this.src='https://via.placeholder.com/300x400/e2e8f0/94a3b8?text=No+Image'">
                        </div>
                        <div class="lm-pdc-info">
                            <div class="lm-pdc-header">
                                <span class="lm-cat-tag">@(product?.Category?.CategoryName ?? "SẢN PHẨM")</span>
                                <div class="lm-pdc-price">
                                    <span class="val">@((product?.PricePerDay ?? 0).ToString("N0"))đ</span>
                                    <span class="unit">/ ngày</span>
                                </div>
                            </div>
                            <h3 class="lm-pdc-name">@(product?.ProductName ?? "Sản phẩm")</h3>
                            <p class="lm-pdc-id">Mã SP: #PRD-@product?.ProductId</p>

                            <div class="lm-specs-grid">
                                <div class="lm-spec-box">
                                    <div class="lbl">SỐ LƯỢNG THUÊ</div>
                                    <div class="val">1 sản phẩm</div>
                                </div>
                                <div class="lm-spec-box">
                                    <div class="lbl">TÌNH TRẠNG</div>
                                    <div class="val">Tốt (95%)</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="lm-card">
                        <h3 class="lm-card-title">Lịch trình thuê</h3>
                        <div class="lm-timeline">
                            <div class="lm-tl-item">
                                <div class="lm-tl-icon active"><i class="fas fa-arrow-right"></i></div>
                                <div class="lm-tl-content">
                                    <div class="lbl">NGÀY BẮT ĐẦU</div>
                                    <div class="val">@rental.StartDate.ToString("dd Tháng MM, yyyy")</div>
                                    <div class="desc">Bàn giao tại địa chỉ của khách hàng.</div>
                                </div>
                            </div>

                            <div class="lm-tl-duration">
                                <i class="far fa-clock"></i> Tổng thời gian thuê: @(duration) ngày
                            </div>

                            <div class="lm-tl-item">
                                <div class="lm-tl-icon"><i class="fas fa-arrow-left"></i></div>
                                <div class="lm-tl-content">
                                    <div class="lbl">NGÀY TRẢ DỰ KIẾN</div>
                                    <div class="val">@rental.EndDate.ToString("dd Tháng MM, yyyy")</div>
                                    <div class="desc">Kiểm tra kỹ tình trạng sản phẩm khi nhận lại.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="lm-dg-right">

                    <div class="lm-card">
                        <h3 class="lm-card-title">Tóm tắt thanh toán</h3>

                        <div class="lm-bill-row">
                            <span>Giá thuê (@(duration) ngày)</span>
                            <span class="val">@rental.TotalPrice.ToString("N0")đ</span>
                        </div>
                        <div class="lm-bill-row">
                            <span>Tiền đặt cọc</span>
                            <span class="val">@rental.DepositAmount.ToString("N0")đ</span>
                        </div>
                        <div class="lm-bill-row">
                            <span>Phí bảo hiểm đồ</span>
                            <span class="val">@insuranceFee.ToString("N0")đ</span>
                        </div>
                        <div class="lm-bill-row">
                            <span>Phí vận chuyển</span>
                            <span class="val">0đ</span>
                        </div>

                        <div class="lm-bill-total">
                            <span>TỔNG CỘNG</span>
                            <span class="total-val">@totalAmount.ToString("N0")đ</span>
                        </div>

                        <div class="lm-payment-status">
                            <div class="head"><i class="fas fa-check-circle"></i> Đã thanh toán 100%</div>
                            <div class="desc">Chuyển khoản Vietcombank lúc @rental.CreatedAt.ToString("HH:mm - dd/MM/yyyy"). Tiền đang được giữ trong ví hệ thống.</div>
                        </div>
                    </div>

                    <div class="lm-card">
                        <div class="lm-card-header-flex">
                            <h3 class="lm-card-title">Lịch sử & Ghi chú</h3>
                            <a href="#" class="lm-link-brown">Thêm</a>
                        </div>

                        <div class="lm-notes-list">
                            <div class="lm-note-item">
                                <div class="dot active"></div>
                                <div class="time">@rental.StartDate.ToString("dd/MM - HH:mm")</div>
                                <div class="title">Đã chuẩn bị đồ xong</div>
                                <div class="desc">"Đã đóng gói cẩn thận, dán tem niêm phong."</div>
                            </div>
                            <div class="lm-note-item">
                                <div class="dot"></div>
                                <div class="time">@rental.CreatedAt.ToString("dd/MM - HH:mm")</div>
                                <div class="title">Hệ thống ghi nhận đơn</div>
                                <div class="desc">Chờ chủ đồ duyệt yêu cầu.</div>
                            </div>
                        </div>

                        <textarea class="lm-textarea" placeholder="Thêm ghi chú riêng cho đơn hàng này..."></textarea>
                    </div>

                    <div class="lm-support-banner">
                        <h4>Cần hỗ trợ?</h4>
                        <p>Nếu khách hàng làm hỏng đồ hoặc có tranh chấp, vui lòng liên hệ Admin để được giải quyết.</p>
                        <a href="#" class="lm-btn-outline-white">Kết nối Admin <i class="fas fa-headset"></i></a>
                    </div>

                </div>
            </div>
        </div>
    </main>
</div>

<style>
    :root {
        --bg-body: #f7f5f2;
        --card-bg: #ffffff;
        --text-main: #2b3a30;
        --text-muted: #8b9690;
        --primary-green: #3f5947;
        --primary-green-hover: #324738;
        --primary-brown: #8b5a3c;
        --primary-brown-hover: #734a30;
        --border-color: #f0ebe1;
        --sidebar-width: 240px;
        --badge-green-bg: #e6f0e9;
        --badge-green-text: #2f5c3f;
        --badge-yellow-bg: #fdf3e7;
        --badge-yellow-text: #b86e24;
        --badge-blue-bg: #e0f2fe;
        --badge-blue-text: #0284c7;
        --badge-light-green: #dcfce7;
        --badge-light-green-text: #16a34a;
        --badge-gray: #f1f5f9;
        --badge-gray-text: #64748b;
    }

    .lm-app-layout {
        display: flex;
        min-height: 100vh;
        background-color: var(--bg-body);
        font-family: 'Inter', sans-serif;
    }

    /* === SIDEBAR (Dùng chung với trang trước) === */
    .lm-sidebar {
        width: var(--sidebar-width);
        background: #fff;
        border-right: 1px solid var(--border-color);
        position: sticky;
        top: 70px;
        height: calc(100vh - 70px);
        display: flex;
        flex-direction: column;
        padding-top: 1rem;
        z-index: 40;
    }

    .lm-sidebar-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 0 1.5rem 1.5rem;
        border-bottom: 1px solid var(--border-color);
        margin-bottom: 1rem;
    }

    .lm-sidebar-avatar img {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        object-fit: cover;
    }

    .lm-sidebar-label {
        font-size: 0.75rem;
        color: var(--primary-green);
        font-weight: 700;
        text-transform: uppercase;
    }

    .lm-sidebar-sub {
        font-size: 0.8rem;
        color: var(--text-muted);
    }

    .lm-sidebar-nav {
        flex: 1;
        padding: 0 1rem;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .lm-snav-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 15px;
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
        border-radius: 12px;
        transition: 0.2s;
    }

        .lm-snav-item i {
            width: 20px;
            font-size: 1.1rem;
        }

        .lm-snav-item:hover {
            background: #fcfaf6;
            color: var(--text-main);
        }

        .lm-snav-item.active {
            background: var(--badge-green-bg);
            color: var(--badge-green-text);
        }

    .lm-sidebar-footer {
        padding: 1.5rem;
        border-top: 1px solid var(--border-color);
    }

    .lm-btn-add-post {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: var(--primary-brown);
        color: white;
        padding: 12px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        transition: 0.2s;
    }

        .lm-btn-add-post:hover {
            background: var(--primary-brown-hover);
        }

    /* === MAIN AREA === */
    .lm-main {
        flex: 1;
        padding: 2rem 0 4rem;
        min-width: 0;
    }

    .lm-container {
        padding: 0 3rem;
        max-width: 1200px;
        margin: 0 auto;
    }

    /* Header */
    .lm-page-header {
        margin-bottom: 2rem;
    }

    .lm-breadcrumbs {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-bottom: 10px;
        font-weight: 500;
    }

        .lm-breadcrumbs a {
            color: var(--primary-brown);
            text-decoration: none;
        }

    .lm-sep {
        margin: 0 8px;
        font-size: 0.75rem;
    }

    .lm-current {
        color: var(--text-main);
        font-weight: 600;
    }

    .lm-header-flex {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .lm-page-title {
        font-size: 2rem;
        font-weight: 800;
        color: var(--text-main);
        margin: 0;
    }

    .lm-btn-icon-outline {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        border: 1px solid var(--border-color);
        background: white;
        color: var(--text-muted);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        transition: 0.2s;
    }

        .lm-btn-icon-outline:hover {
            border-color: var(--primary-green);
            color: var(--primary-green);
        }

    /* Grid */
    .lm-detail-grid {
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: 25px;
        align-items: start;
    }

    .lm-dg-left {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .lm-dg-right {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    /* Cards */
    .lm-card {
        background: white;
        border-radius: 20px;
        padding: 25px;
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    }

    .lm-card-title {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--text-main);
        margin-bottom: 20px;
    }

    .lm-card-title-sm {
        font-size: 0.8rem;
        font-weight: 800;
        color: var(--text-muted);
        letter-spacing: 0.5px;
        margin-bottom: 15px;
        text-transform: uppercase;
    }

    /* Status Banner */
    .lm-status-banner {
        background: var(--badge-green-bg);
        border-radius: 24px;
        padding: 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border: 1px solid #dce8df;
    }

    .lm-sb-title {
        font-size: 1.6rem;
        font-weight: 800;
        color: var(--primary-green);
        margin: 0 0 5px 0;
    }

    .lm-sb-sub {
        font-size: 0.95rem;
        color: var(--primary-green);
        opacity: 0.8;
        margin: 0;
    }

    .lm-sb-actions {
        display: flex;
        gap: 10px;
    }

    /* Buttons */
    .lm-btn-primary {
        padding: 12px 20px;
        background: var(--primary-green);
        color: white;
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: 0.2s;
    }

        .lm-btn-primary:hover {
            background: var(--primary-green-hover);
            transform: translateY(-2px);
        }

    .lm-btn-danger {
        padding: 12px 20px;
        background: #fee2e2;
        color: #dc2626;
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: 0.2s;
    }

        .lm-btn-danger:hover {
            background: #fecaca;
        }

    /* Alerts */
    .lm-info-alert {
        background: #e0f2fe;
        color: #0284c7;
        padding: 12px 20px;
        border-radius: 12px;
        font-size: 0.9rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .lm-success-alert {
        background: #dcfce7;
        color: #16a34a;
        padding: 12px 20px;
        border-radius: 12px;
        font-size: 0.9rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .lm-error-alert {
        background: #fee2e2;
        color: #dc2626;
        padding: 12px 20px;
        border-radius: 12px;
        font-size: 0.9rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* Badges */
    .lm-badge {
        padding: 6px 12px;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }


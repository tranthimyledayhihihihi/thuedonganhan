@{
    ViewData["Title"] = "Trang chủ";
    var allProducts = ViewBag.AllProducts as List<WEB.Models.ProductViewModel> ?? new List<WEB.Models.ProductViewModel>();
    var myProducts = ViewBag.MyProducts as List<WEB.Models.ProductViewModel> ?? new List<WEB.Models.ProductViewModel>();
    var jwtToken = Context.Session.GetString("JWTToken");
    var userName = Context.Session.GetString("UserName");
    var hasSession = !string.IsNullOrEmpty(jwtToken);
    var mode = (ViewBag.Mode ?? "home").ToString();

    System.Diagnostics.Debug.WriteLine($"[INDEX] Current Mode: {mode}, HasSession: {hasSession}");
}

@functions {
    public string GetPerfectCardImage(WEB.Models.ProductViewModel product)
    {
        var cardImageUrl = product.ImageUrl;
        bool isPlaceholder = string.IsNullOrEmpty(cardImageUrl) || cardImageUrl.Contains("unsplash.com");
        if (!isPlaceholder) return cardImageUrl;

        var pName = product.ProductName?.ToLower() ?? "";
        var cName = product.Category?.CategoryName?.ToLower() ?? "";

        if (pName.Contains("áo dài") || cName.Contains("áo dài")) return "/images/aodai.png";
        if (pName.Contains("lễ phục") || pName.Contains("tốt nghiệp")) return "/images/dototnghiep.png";
        if (pName.Contains("vest") || pName.Contains("suit")) return "/images/vestnam.png";
        if (pName.Contains("tai nghe") || pName.Contains("headphone") || cName.Contains("âm thanh") || pName.Contains("sony wh-1000xm4")) return "/images/tainghe.png";
        if (pName.Contains("máy chiếu") || pName.Contains("projector") || cName.Contains("trình chiếu")) return "/images/maychieu.png";
        if (pName.Contains("guitar") || pName.Contains("đàn") || cName.Contains("nhạc cụ")) return "/images/guitar.png";
        if (pName.Contains("xe đạp") || pName.Contains("giant") || pName.Contains("bike")) return "/images/xedap.png";
        if (pName.Contains("ipad") || pName.Contains("tablet")) return "/images/ipad.png";
        if (pName.Contains("macbook") || pName.Contains("laptop")) return "/images/mac.png";
        if (pName.Contains("máy ảnh") || pName.Contains("camera") || cName.Contains("máy ảnh")) return "/images/mayanh.png";
        if (pName.Contains("xe máy") || pName.Contains("wave") || cName.Contains("xe cộ")) return "https://images.unsplash.com/photo-1558981806-ec527fa84c39?w=800";
        if (cName.Contains("sách") || cName.Contains("giáo trình") || pName.Contains("sách")) return "/images/giaitich1.png";

        return cardImageUrl;
    }
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:wght@300;400;500;600&display=swap');

    :root {
        --primary: #8B5E3C;
        --primary-light: #C4956A;
        --primary-dark: #5C3D22;
        --accent: #E8B89A;
        --bg: #F7F4F0;
        --bg-warm: #EFE9E1;
        --surface: #FFFFFF;
        --text-primary: #1A1208;
        --text-secondary: #6B5B4E;
        --text-muted: #A89585;
        --success: #5C8A5A;
        --border: #E0D5C9;
        --shadow: 0 4px 24px rgba(90,60,30,0.08);

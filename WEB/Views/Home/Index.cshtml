                            {
                                <span class="badge-status available" style="position: absolute; top: 1rem; left: 1rem; background: var(--success); color: white; padding: 0.25rem 0.75rem; border-radius: 20px; font-size: 0.75rem; font-weight: 600; z-index: 2;">Sẵn sàng</span>
                            }
                            else
                            {
                                <span class="badge-status rented" style="position: absolute; top: 1rem; left: 1rem; background: var(--text-secondary); color: white; padding: 0.25rem 0.75rem; border-radius: 20px; font-size: 0.75rem; font-weight: 600; z-index: 2;">Đang thuê</span>
                            }
                            

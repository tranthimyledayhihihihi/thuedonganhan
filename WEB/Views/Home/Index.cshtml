        </section>

        <section class="products-section-home">
            <div class="section-header-home">
                <div>
                    <h2>Đồ dùng nổi bật</h2>
                    <p>Sản phẩm được ưa chuộng nhất trong cộng đồng UTE</p>
                </div>

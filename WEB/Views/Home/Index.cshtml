                    <p style="color: #94a3b8; text-align: center; padding: 3rem;">📊 Biểu đồ sẽ hiển thị ở đây</p>
                </div>
            </div>

            <div class="section-header-flex">
                <div>
                    <h2>Danh sách đang đăng</h2>
                </div>
                <a href="/Product" class="link-view-all">Xem tất cả →</a>
            </div>

            @if (myProducts.Any())
            {
                <div class="product-grid-3">
                    @foreach (var product in myProducts.Take(3))
                    {
                        <div class="product-card-owner">
                            @if (!product.IsApproved)
                            {
                                <span class="badge-status pending" style="background: #fef3c7; color: #d97706; border: 1px solid #fde68a;">Chờ duyệt</span>
                            }
                            else if (product.IsAvailable)
                            {
                                <span class="badge-status available">Sẵn sàng</span>
                            }
                            else
                            {
                                <span class="badge-status rented">Đang thuê</span>
                            }
                            <img src="@GetPerfectCardImage(product)" alt="@product.ProductName" class="product-img" onerror="this.src='https://via.placeholder.com/400x300/667eea/ffffff?text=Product'">
                            <div class="product-body">
                                <div class="product-category">@(product.Category?.CategoryName ?? "Khác")</div>
                                <h3 class="product-name">@product.ProductName</h3>
                                <div class="product-footer-flex">
                                    <div class="product-price-box">
                                        <span class="price-main">@product.PricePerDay.ToString("N0")đ</span>
                                        <span class="price-unit">/ngày</span>
                                    </div>
                                    <div class="product-actions-inline">
                                        <a href="/Post/Edit/@product.ProductId" class="btn-icon-action" title="Sửa">✏️</a>
                                        <button class="btn-icon-action" onclick="deleteProduct(@product.ProductId)" title="Xóa">🗑️</button>
                                    </div>
                                </div>
                            </div>

    .dashboard-content {
        flex: 1;
        padding: 2.5rem;
        overflow-y: auto;
    }

    .page-title {
        font-family: var(--font-display);
        font-size: 1.6rem;
        margin-bottom: 0.35rem;
    }

    .page-subtitle {
        color: var(--text-muted);
        font-size: 0.9rem;
        margin-bottom: 2rem;
    }

    .filter-tabs {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1.75rem;
    }

    .filter-tab {
        padding: 0.5rem 1.25rem;
        border-radius: 40px;
        border: 1.5px solid var(--border);
        background: transparent;
        font-family: var(--font-body);
        font-size: 0.85rem;
        color: var(--text-secondary);
        cursor: pointer;
        transition: all 0.15s;
    }

        .filter-tab.active, .filter-tab:hover {
            background: var(--primary);
            border-color: var(--primary);
            color: #fff;
        }

    /* ========== OWNER STATS ========== */
    .stats-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.25rem;
        margin-bottom: 2rem;
    }

    .stat-box {
        background: var(--surface);
        border-radius: var(--radius);
        padding: 1.5rem;
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: 1rem;
        box-shadow: var(--shadow);
    }

    .stat-icon {
        font-size: 2rem;
        width: 56px;
        height: 56px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .stat-icon.blue {
            background: #EFF6FF;
        }

        .stat-icon.purple {
            background: #F5F3FF;
        }

        .stat-icon.yellow {
            background: #FFFBEB;
        }

    .stat-info .stat-label {
        font-size: 0.78rem;
        color: var(--text-muted);
        margin-bottom: 0.25rem;
    }

    .stat-info .stat-value {
        font-family: var(--font-display);
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--text-primary);
    }

    .stat-badge {
        font-size: 0.7rem;
        font-weight: 600;
        background: #DCFCE7;
        color: #16a34a;
        padding: 0.15rem 0.5rem;
        border-radius: 8px;
        display: inline-block;
        margin-top: 0.25rem;
    }

    .chart-box {
        background: var(--surface);
        border-radius: var(--radius);
        padding: 1.5rem;
        border: 1px solid var(--border);
        margin-bottom: 2rem;
    }

    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

        .chart-header h3 {
            font-family: var(--font-display);
            font-size: 1.1rem;
        }

    .chart-select {
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0.35rem 0.75rem;
        font-family: var(--font-body);
        font-size: 0.85rem;
        color: var(--text-secondary);
        outline: none;
        cursor: pointer;
    }

    .chart-placeholder {
        height: 140px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .section-header-flex {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

        .section-header-flex h2 {
            font-family: var(--font-display);
            font-size: 1.25rem;
        }

    .product-card-modern, .product-card-owner {
        background: var(--surface);
        border-radius: var(--radius);
        overflow: hidden;
        position: relative;
        box-shadow: var(--shadow);
        border: 1px solid var(--border);
        transition: transform 0.2s, box-shadow 0.2s;
        display: flex;
        flex-direction: column;
    }

        .product-card-modern:hover, .product-card-owner:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
        }

    .btn-favorite {
        position: absolute;
        top: 0.85rem;
        right: 0.85rem;
        background: rgba(255,255,255,0.9);
        border: none;
        border-radius: 50%;
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 1rem;
        z-index: 3;
        transition: background 0.15s, transform 0.15s;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

        .btn-favorite:hover {
            background: #fff;
            transform: scale(1.1);
        }

    .product-actions-inline {
        display: flex;
        gap: 0.5rem;
    }

    .btn-icon-action {
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 8px;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 0.9rem;
        text-decoration: none;
        transition: background 0.15s;
    }

        .btn-icon-action:hover {
            background: var(--bg-warm);
        }

    .add-more-box {
        background: var(--bg);
        border: 2px dashed var(--border);
        border-radius: var(--radius);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        text-align: center;
        cursor: pointer;
        transition: border-color 0.2s, background 0.2s;
        min-height: 200px;
        text-decoration: none;
        color: var(--text-secondary);
    }

        .add-more-box:hover {
            border-color: var(--primary);
            background: #FDF6F1;
        }

    .add-icon {
        font-size: 2rem;
        margin-bottom: 0.5rem;
    }

    .add-more-box h4 {
        font-weight: 700;
        margin-bottom: 0.35rem;
        color: var(--text-primary);
    }

    .add-more-box p {
        font-size: 0.82rem;
        color: var(--text-muted);
    }

    /* ========== FOOTER ========== */
    .site-footer {
        background: #1A0E05;
        color: rgba(255,255,255,0.75);
        padding: 4rem 5% 2rem;
        margin-top: 3rem;
    }

    .footer-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1.5fr;
        gap: 2.5rem;
        margin-bottom: 3rem;
    }

    @@media (max-width: 800px) {
        .footer-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 480px) {
        .footer-grid {
            grid-template-columns: 1fr;
        }
    }

    .footer-brand .logo {
        font-family: var(--font-display);
        font-size: 1.5rem;
        color: #fff;
        font-weight: 700;
        margin-bottom: 1rem;
        display: block;
    }

    .footer-brand p {
        font-size: 0.875rem;
        line-height: 1.7;
        color: rgba(255,255,255,0.6);
        max-width: 280px;
    }

    .footer-social {
        display: flex;
        gap: 0.75rem;
        margin-top: 1.25rem;
    }

    .social-btn {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(255,255,255,0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        text-decoration: none;
        transition: background 0.15s;
    }

        .social-btn:hover {
            background: var(--primary);
        }

    .footer-col h4 {
        font-family: var(--font-display);
        font-size: 0.95rem;
        color: #fff;
        margin-bottom: 1rem;
        font-weight: 600;
    }

    .footer-col ul {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

        .footer-col ul li a {
            font-size: 0.85rem;
            color: rgba(255,255,255,0.6);
            text-decoration: none;
            transition: color 0.15s;
        }

            .footer-col ul li a:hover {
                color: var(--accent);
            }

    .footer-contact {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .contact-item {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        font-size: 0.85rem;
        color: rgba(255,255,255,0.6);
    }

        .contact-item .icon {
            font-size: 1rem;
            flex-shrink: 0;
            margin-top: 0.05em;
        }

    .footer-bottom {
        border-top: 1px solid rgba(255,255,255,0.1);
        padding-top: 1.5rem;
        text-align: center;
        font-size: 0.8rem;
        color: rgba(255,255,255,0.4);
    }

    /* ========== TEXT CENTER ========== */
    .text-center {
        text-align: center;
    }

    .btn-view-more {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--primary);
        text-decoration: none;
        border: 1.5px solid var(--primary);
        padding: 0.65rem 1.75rem;
        border-radius: 40px;
        transition: background 0.2s, color 0.2s;
    }

        .btn-view-more:hover {
            background: var(--primary);
            color: #fff;
        }

    /* ========== RESPONSIVE ========== */
    @@media (max-width: 768px) {
        .hero-content {
            padding: 3.5rem 5%;
        }

        .stats-section-home {
            flex-direction: column;
            margin: 1rem 4%;
        }

        .stat-item-home {
            border-right: none;
            border-bottom: 1px solid var(--border);
            padding: 1.25rem;
        }

            .stat-item-home:last-child {
                border-bottom: none;
            }

        .search-container-home {
            border-radius: 20px;
            padding: 1rem;
            flex-direction: column;
        }

        .search-input-group {
            padding: 0;
        }

        .products-section-home, .categories-section, .cta-section {
            padding: 2rem 4%;
        }

        .cta-box {
            padding: 2.5rem 1.5rem;
        }

        .dashboard-layout {
            flex-direction: column;
        }

        .sidebar-left {
            width: 100%;
            border-right: none;
            border-bottom: 1px solid var(--border);
            padding: 1.25rem;
            flex-direction: row;
            align-items: center;
            overflow-x: auto;
        }

        .sidebar-welcome {
            display: none;
        }

        .stats-row {
            grid-template-columns: 1fr;
        }

        .testimonial-grid {
            grid-template-columns: 1fr;
        }

        .footer-grid {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
    }

    /* ========== CHAT WIDGET ========== */
    .chat-widget {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 1000;
        font-family: var(--font-body);
    }

    .chat-toggle {
        background: var(--primary);
        color: #fff;
        border: none;
        border-radius: 50px;
        padding: 0.85rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        box-shadow: var(--shadow-md);
        transition: transform 0.2s, background 0.2s;
    }

        .chat-toggle:hover {
            transform: translateY(-2px);
            background: var(--primary-dark);
        }

    .chat-box {
        position: absolute;
        bottom: 70px;
        right: 0;
        width: 340px;
        background: var(--surface);
        border-radius: var(--radius);
        box-shadow: 0 12px 40px rgba(90,60,30,0.2);
        border: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        transition: opacity 0.3s, transform 0.3s;
        transform-origin: bottom right;
    }

        .chat-box.hidden {
            opacity: 0;
            pointer-events: none;
            transform: scale(0.95) translateY(10px);
        }

    .chat-header {
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: #fff;
        padding: 1.2rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .chat-header h4 {
            font-family: var(--font-display);
            font-size: 1.1rem;
            margin: 0;
        }

    .chat-close {
        background: rgba(255,255,255,0.2);
        border: none;
        color: #fff;
        cursor: pointer;
        font-size: 0.9rem;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s;
    }

        .chat-close:hover {
            background: rgba(255,255,255,0.4);
        }

    .chat-messages {
        height: 320px;
        padding: 1.25rem;
        overflow-y: auto;
        background: var(--bg);
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .message {
        padding: 0.75rem 1rem;
        border-radius: 16px;
        font-size: 0.9rem;
        max-width: 85%;
        line-height: 1.4;
    }

    .bot-message {
        background: #fff;
        align-self: flex-start;
        color: var(--text-primary);
        border: 1px solid var(--border);
        border-bottom-left-radius: 4px;
    }

    .user-message {
        background: var(--primary-light);
        align-self: flex-end;
        color: #fff;
        border-bottom-right-radius: 4px;
    }

    .chat-input-area {
        display: flex;
        padding: 1rem;
        border-top: 1px solid var(--border);
        background: var(--surface);
        gap: 0.5rem;
    }

        .chat-input-area input {
            flex: 1;
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 0.6rem 1rem;
            outline: none;
            font-family: var(--font-body);
            font-size: 0.9rem;
            color: var(--text-primary);
        }

            .chat-input-area input:focus {
                border-color: var(--primary);
            }

        .chat-input-area button {
            background: var(--primary);
            color: #fff;
            border: none;
            border-radius: 20px;
            padding: 0 1.25rem;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.9rem;
            transition: background 0.2s;
        }

            .chat-input-area button:hover {
                background: var(--primary-dark);
            }
</style>

@if (mode == "renter")
{
    <div class="dashboard-layout">
        <aside class="sidebar-left">
            <div class="sidebar-welcome">
                <div class="welcome-icon">👋</div>
                <h3>Trung tâm điều khiển</h3>
                <p>Chào mừng bạn quay lại!</p>
            </div>
            <nav class="sidebar-menu">
                <a href="/?mode=renter" class="menu-item active">
                    <i class="icon">🛒</i>
                    <span>Người thuê</span>
                </a>
                <a href="/?mode=owner" class="menu-item">
                    <i class="icon">📦</i>
                    <span>Người cho thuê</span>
                </a>
                <a href="/Post/Create" class="menu-item">
                    <i class="icon">➕</i>
                    <span>Đăng sản phẩm mới</span>
                </a>
            </nav>
        </aside>

        <main class="dashboard-content">
            <h2 class="page-title">Gợi ý dành riêng cho bạn</h2>
            <p class="page-subtitle">Dựa trên các tiêu chí và ngành học của bạn</p>

            <div class="filter-tabs">
                <button class="filter-tab active" onclick="filterTab(this, 'all')">Tất cả</button>
                <button class="filter-tab" onclick="filterTab(this, 'Điện tử')">Điện tử</button>
                <button class="filter-tab" onclick="filterTab(this, 'Giáo trình')">Giáo trình</button>
            </div>

            @if (allProducts.Any())
            {
                <div class="product-grid-3">
                    @foreach (var product in allProducts.Take(6))
                    {
                        <div class="product-card-modern filter-item" data-cat="@(product.Category?.CategoryName ?? "Khác")">
                            @if (product.IsAvailable)
                            {
                                <span class="badge-status available">Sẵn sàng</span>
                            }
                            else
                            {
                                <span class="badge-status rented">Đang thuê</span>
                            }
                            <button class="btn-favorite">♡</button>
                            <img src="@GetPerfectCardImage(product)" alt="@product.ProductName" class="product-img"
                                 onerror="this.src='https://via.placeholder.com/400x300/8B5E3C/ffffff?text=Product'">
                            <div class="product-body">
                                <div class="product-category">@(product.Category?.CategoryName ?? "Khác")</div>
                                <h3 class="product-name">@product.ProductName</h3>
                                <div class="product-footer-flex">
                                    <div class="product-price-box">
                                        <span class="price-main">@product.PricePerDay.ToString("N0")đ</span>
                                        <span class="price-unit">/ngày</span>
                                    </div>
                                    <a href="/Product/Details/@product.ProductId" class="btn-rent">Thuê ngay</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-box">
                    <span class="empty-icon">📦</span>
                    <h3>Chưa có sản phẩm nào</h3>
                    <p>Hãy quay lại sau để xem các sản phẩm mới</p>
                </div>
            }

            <div class="text-center" style="margin-top: 2rem;">
                <a href="/Product" class="btn-view-more">Xem thêm sản phẩm →</a>
            </div>
        </main>
    </div>
}
else if (mode == "owner")
{
    <div class="dashboard-layout">
        <aside class="sidebar-left">
            <div class="sidebar-welcome">
                <div class="welcome-icon">👋</div>
                <h3>Trung tâm điều khiển</h3>
                <p>Chào mừng bạn quay lại!</p>
            </div>
            <nav class="sidebar-menu">
                <a href="/?mode=renter" class="menu-item">
                    <i class="icon">🛒</i>
                    <span>Người thuê</span>
                </a>
                <a href="/?mode=owner" class="menu-item active">
                    <i class="icon">📦</i>
                    <span>Người cho thuê</span>
                </a>
                <a href="/Post/Create" class="menu-item">
                    <i class="icon">➕</i>
                    <span>Đăng sản phẩm mới</span>
                </a>
            </nav>
        </aside>

        <main class="dashboard-content">
            <div class="stats-row">
                <div class="stat-box">
                    <div class="stat-icon blue">💰</div>
                    <div class="stat-info">
                        <div class="stat-label">Doanh thu tháng này</div>
                        <div class="stat-value">@((myProducts.Sum(p => p.PricePerDay) * 30).ToString("N0"))đ</div>
                        <span class="stat-badge">+15%</span>
                    </div>
                </div>
                <div class="stat-box">
                    <div class="stat-icon purple">📦</div>
                    <div class="stat-info">
                        <div class="stat-label">Sản phẩm đang cho thuê</div>
                        <div class="stat-value">@myProducts.Count.ToString("00")</div>
                    </div>
                </div>
                <div class="stat-box">
                    <div class="stat-icon yellow">⭐</div>
                    <div class="stat-info">
                        <div class="stat-label">Đánh giá trung bình</div>
                        <div class="stat-value">4.8 ⭐</div>
                    </div>
                </div>
            </div>

            <div class="chart-box">
                <div class="chart-header">
                    <h3>Biểu đồ doanh thu</h3>
                    <select class="chart-select">
                        <option>7 ngày qua</option>
                        <option>30 ngày qua</option>
                    </select>
                </div>
                <div class="chart-placeholder">
                    <p style="color:#A89585;text-align:center;">📊 Biểu đồ sẽ hiển thị ở đây</p>
                </div>
            </div>

            <div class="section-header-flex">
                <h2>Danh sách đang đăng</h2>
                <a href="/Product" class="link-view-all">Xem tất cả →</a>
            </div>

            @if (myProducts.Any())
            {
                <div class="product-grid-3">
                    @foreach (var product in myProducts.Take(3))
                    {
                        <div class="product-card-owner filter-item" data-cat="@(product.Category?.CategoryName ?? "Khác")">
                            @if (!product.IsApproved)
                            {
                                <span class="badge-status pending">Chờ duyệt</span>
                            }
                            else if (product.IsAvailable)
                            {
                                <span class="badge-status available">Sẵn sàng</span>
                            }
                            else
                            {
                                <span class="badge-status rented">Đang thuê</span>
                            }
                            <img src="@GetPerfectCardImage(product)" alt="@product.ProductName" class="product-img"
                                 onerror="this.src='https://via.placeholder.com/400x300/8B5E3C/ffffff?text=Product'">
                            <div class="product-body">
                                <div class="product-category">@(product.Category?.CategoryName ?? "Khác")</div>
                                <h3 class="product-name">@product.ProductName</h3>
                                <div class="product-footer-flex">
                                    <div class="product-price-box">
                                        <span class="price-main">@product.PricePerDay.ToString("N0")đ</span>
                                        <span class="price-unit">/ngày</span>
                                    </div>
                                    <div class="product-actions-inline">
                                        <a href="/Post/Edit/@product.ProductId" class="btn-icon-action" title="Sửa">✏️</a>
                                        <button class="btn-icon-action" onclick="deleteProduct(@product.ProductId)" title="Xóa">🗑️</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    <a href="/Post/Create" class="add-more-box">
                        <div class="add-icon">➕</div>
                        <h4>Thêm mới</h4>
                        <p>Đăng thêm đồ dùng để tăng thu nhập</p>
                    </a>
                </div>
            }
            else
            {
                <div class="empty-box">
                    <span class="empty-icon">📦</span>
                    <h3>Bạn chưa có sản phẩm nào</h3>
                    <p>Bắt đầu cho thuê đồ dùng của bạn</p>
                    <a href="/Post/Create" class="btn-primary">Đăng sản phẩm đầu tiên</a>
                </div>
            }
        </main>
    </div>
}
else
{
    <div class="home-layout">

        <section class="hero-section">
            <div class="hero-content">
                @if (hasSession)
                {
                    <h1 class="hero-title">
                        Trải nghiệm đồ dùng cao cấp —<br />
                        <em>không cần sở hữu</em>

@{
    ViewData["Title"] = "Trang chủ";
    var allProducts = ViewBag.AllProducts as List<WEB.Models.ProductViewModel> ?? new List<WEB.Models.ProductViewModel>();
    var myProducts = ViewBag.MyProducts as List<WEB.Models.ProductViewModel> ?? new List<WEB.Models.ProductViewModel>();
    var jwtToken = Context.Session.GetString("JWTToken");
    var userName = Context.Session.GetString("UserName");
    var hasSession = !string.IsNullOrEmpty(jwtToken);
    var mode = (ViewBag.Mode ?? "home").ToString();
    
    // Debug: Log mode value
    System.Diagnostics.Debug.WriteLine($"[INDEX] Current Mode: {mode}, HasSession: {hasSession}");
}

@functions {
    public string GetPerfectCardImage(WEB.Models.ProductViewModel product)
    {
        var cardImageUrl = product.ImageUrl;
        
        // We only override if it's a seed placeholder (contains unsplash or is null/empty)
        bool isPlaceholder = string.IsNullOrEmpty(cardImageUrl) || cardImageUrl.Contains("unsplash.com");
        if (!isPlaceholder)
        {
            return cardImageUrl;
        }

        var pName = product.ProductName?.ToLower() ?? "";
        var cName = product.Category?.CategoryName?.ToLower() ?? "";

        // Perfect overrides for mock data placeholders
        if (pName.Contains("áo dài") || cName.Contains("áo dài"))
        {
            return "/images/aodai.png";
        }
        if (pName.Contains("lễ phục") || pName.Contains("tốt nghiệp"))
        {
            return "/images/dototnghiep.png";
        }
        if (pName.Contains("vest") || pName.Contains("suit"))
        {
            return "/images/vestnam.png";
        }
        if (pName.Contains("tai nghe") || pName.Contains("headphone") || cName.Contains("âm thanh") || pName.Contains("sony wh-1000xm4"))
        {
            return "/images/tainghe.png";
        }
        if (pName.Contains("máy chiếu") || pName.Contains("projector") || cName.Contains("trình chiếu"))
        {
            return "/images/maychieu.png";
        }
        if (pName.Contains("guitar") || pName.Contains("đàn") || cName.Contains("nhạc cụ"))
        {
            return "/images/guitar.png";
        }
        if (pName.Contains("xe đạp") || pName.Contains("giant") || pName.Contains("bike"))
        {
            return "/images/xedap.png";
        }
        if (pName.Contains("ipad") || pName.Contains("tablet"))
        {
            return "/images/ipad.png";
        }
        if (pName.Contains("macbook") || pName.Contains("laptop"))
        {
            return "/images/mac.png";
        }
        if (pName.Contains("máy ảnh") || pName.Contains("camera") || cName.Contains("máy ảnh"))
        {
            return "/images/mayanh.png";
        }
        if (pName.Contains("xe máy") || pName.Contains("wave") || cName.Contains("xe cộ"))
        {
            return "https://images.unsplash.com/photo-1558981806-ec527fa84c39?w=800";
        }
        if (cName.Contains("sách") || cName.Contains("giáo trình") || pName.Contains("sách"))
        {
            return "/images/giaitich1.png";
        }

        return cardImageUrl;
    }
}

<link rel="stylesheet" href="~/css/home-styles.css" asp-append-version="true" />

@if (mode == "renter")
{
    <!-- ========== TRANG NGƯỜI THUÊ - CÓ SIDEBAR ========== -->
    <div class="dashboard-layout">
        <aside class="sidebar-left">
            <div class="sidebar-welcome">
                <div class="welcome-icon">👋</div>
                <h3>Trung tâm điều khiển</h3>
                <p>Chào mừng bạn quay lại!</p>
            </div>
            <nav class="sidebar-menu">
                <a href="/?mode=renter" class="menu-item active">
                    <i class="icon">🛒</i>
                    <span>Người thuê</span>
                </a>
                <a href="/?mode=owner" class="menu-item">
                    <i class="icon">📦</i>
                    <span>Người cho thuê</span>
                </a>
                <a href="/Post/Create" class="menu-item">
                    <i class="icon">➕</i>
                    <span>Đăng sản phẩm mới</span>
                </a>
            </nav>
        </aside>

        <main class="dashboard-content">
            <h2 class="page-title">Gợi ý dành riêng cho bạn</h2>
            <p class="page-subtitle">Dựa trên các tiêu chí và ngành học của bạn</p>
            
            <div class="filter-tabs">
                <button class="filter-tab active">Tất cả</button>
                <button class="filter-tab">Điện tử</button>
                <button class="filter-tab">Giáo trình</button>
            </div>

            @if (allProducts.Any())
            {
                <div class="product-grid-3">
                    @foreach (var product in allProducts.Take(6))
                    {
                        <div class="product-card-modern">
                            @if (product.IsAvailable)
                            {
                                <span class="badge-status available">Sẵn sàng</span>
                            }
                            else
                            {
                                <span class="badge-status rented">Đang thuê</span>
                            }
                            <button class="btn-favorite">♡</button>
                            <img src="@GetPerfectCardImage(product)" alt="@product.ProductName" class="product-img" onerror="this.src='https://via.placeholder.com/400x300/667eea/ffffff?text=Product'">
                            <div class="product-body">
                                <div class="product-category">@(product.Category?.CategoryName ?? "Khác")</div>
                                <h3 class="product-name">@product.ProductName</h3>
                                <div class="product-footer-flex">
                                    <div class="product-price-box">
                                        <span class="price-main">@product.PricePerDay.ToString("N0")đ</span>
                                        <span class="price-unit">/ngày</span>
                                    </div>
                                    <a href="/Product/Details/@product.ProductId" class="btn-rent">Thuê ngay</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-box">
                    <div class="empty-icon">📦</div>
                    <h3>Chưa có sản phẩm nào</h3>
                    <p>Hãy quay lại sau để xem các sản phẩm mới</p>
                </div>
            }
            
            <div class="text-center" style="margin-top: 2rem;">
                <a href="/Product" class="btn-view-more">Xem thêm sản phẩm →</a>
            </div>
        </main>
    </div>
}
else if (mode == "owner")
{
    <!-- ========== TRANG NGƯỜI CHO THUÊ - CÓ SIDEBAR ========== -->
    <div class="dashboard-layout">
        <aside class="sidebar-left">
            <div class="sidebar-welcome">
                <div class="welcome-icon">👋</div>
                <h3>Trung tâm điều khiển</h3>
                <p>Chào mừng bạn quay lại!</p>
            </div>
            <nav class="sidebar-menu">
                <a href="/?mode=renter" class="menu-item">
                    <i class="icon">🛒</i>
                    <span>Người thuê</span>
                </a>
                <a href="/?mode=owner" class="menu-item active">
                    <i class="icon">📦</i>
                    <span>Người cho thuê</span>
                </a>
                <a href="/Post/Create" class="menu-item">
                    <i class="icon">➕</i>
                    <span>Đăng sản phẩm mới</span>
                </a>
            </nav>
        </aside>

        <main class="dashboard-content">
            <div class="stats-row">
                <div class="stat-box">
                    <div class="stat-icon blue">💰</div>
                    <div class="stat-info">
                        <div class="stat-label">Doanh thu tháng này</div>
                        <div class="stat-value">@((myProducts.Sum(p => p.PricePerDay) * 30).ToString("N0"))đ</div>
                        <span class="stat-badge new">+15%</span>
                    </div>
                </div>
                <div class="stat-box">
                    <div class="stat-icon purple">📦</div>
                    <div class="stat-info">
                        <div class="stat-label">Sản phẩm đang cho thuê</div>
                        <div class="stat-value">@myProducts.Count.ToString("00")</div>
                    </div>
                </div>
                <div class="stat-box">
                    <div class="stat-icon yellow">⭐</div>
                    <div class="stat-info">
                        <div class="stat-label">Đánh giá trung bình</div>
                        <div class="stat-value">4.8 ⭐</div>
                    </div>
                </div>
            </div>

            <div class="chart-box">
                <div class="chart-header">
                    <h3>Biểu đồ doanh thu</h3>

                    }
                    <div class="add-more-box">
                        <div class="add-icon">➕</div>
                        <h4>Thêm mới</h4>
                        <p>Đăng thêm đồ dùng để tăng thu nhập</p>
                    </div>
                </div>
            }
            else
            {
                <div class="empty-box">
                    <div class="empty-icon">📦</div>
                    <h3>Bạn chưa có sản phẩm nào</h3>
                    <p>Bắt đầu cho thuê đồ dùng của bạn</p>
                    <a href="/Post/Create" class="btn-primary">Đăng sản phẩm đầu tiên</a>
                </div>
            }
        </main>
    </div>
}
else
{
    <!-- ========== TRANG CHỦ - KHÔNG CÓ SIDEBAR ========== -->
    <div class="home-layout">
        <section class="hero-section">
            <div class="hero-content">
                @if (hasSession)
                {
                    <h1 class="hero-title">
                        Thuê đồ thông minh,<br />
                        <span class="text-gradient">tiết kiệm cùng sinh viên</span>
                    </h1>
                    <p class="hero-subtitle">Chào mừng @userName quay trở lại!</p>
                    <p class="hero-desc">Thuê dùng các thiết bị học tập với giá từ chỉ 20.000đ/ngày</p>
                }
                else
                {
                    <h1 class="hero-title">
                        Thuê đồ thông minh,<br />
                        <span class="text-gradient">tiết kiệm cùng sinh viên</span>
                    </h1>
                    <p class="hero-desc">Tìm nhanh các thiết bị công nghệ và đồ dùng học tập<br />Thuê dùng với giá từ 20.000đ/ngày</p>
                }
                <div class="hero-buttons">
                    @if (hasSession)
                    {
                        <a href="/Product" class="btn-hero-primary">Tiếp tục khám phá</a>
                        <a href="/?mode=renter" class="btn-hero-secondary">Đăng tin ngay</a>
                    }
                    else
                    {
                        <a href="/Product" class="btn-hero-primary">Khám phá ngay</a>
                        <a href="/Account/Register" class="btn-hero-secondary">Đăng ký miễn phí</a>
                    }
                </div>
            </div>
        </section>

        <section class="search-section-home">
            <form action="/Product" method="get" class="search-container-home">
                <div class="search-input-group">
                    <span class="search-icon">🔍</span>
                    <input type="text" name="keyword" placeholder="Tìm kiếm đồ dùng..." class="search-input-home" />
                </div>
                <select name="categoryIds" class="search-select">
                    <option value="">Tất cả danh mục</option>
                    <option value="1">Điện tử</option>
                    <option value="2">Học tập</option>
                    <option value="3">Sách & Giáo trình</option>
                    <option value="5">Thời trang</option>
                </select>
                <select name="maxPrice" class="search-select">
                    <option value="">Tất cả giá</option>
                    <option value="50000">Dưới 50k/ngày</option>
                    <option value="100000">Dưới 100k/ngày</option>
                </select>
                <button type="submit" class="btn-search">Lọc</button>

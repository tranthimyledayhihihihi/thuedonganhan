@{
    ViewData["Title"] = "Người cho thuê - Bảng điều khiển";
    var myProducts = ViewBag.MyProducts as List<WEB.Models.ProductViewModel> ?? new List<WEB.Models.ProductViewModel>();
    var myRentals = ViewBag.MyRentals as List<WEB.Models.RentalViewModel> ?? new List<WEB.Models.RentalViewModel>();
    var userName = Context.Session.GetString("UserName") ?? "Sinh viên";

    var totalProducts = myProducts.Count;
    var rentedProducts = myProducts.Count(p => !p.IsAvailable);
    var availableProducts = myProducts.Count(p => p.IsAvailable);
    var totalRevenue = myProducts.Sum(p => p.PricePerDay) * 30;
}

@functions {
    public string GetPerfectCardImage(WEB.Models.ProductViewModel product)
    {
        if (product == null) return "/images/placeholder.png";
        var cardImageUrl = product.ImageUrl;

        bool isPlaceholder = string.IsNullOrEmpty(cardImageUrl) || cardImageUrl.Contains("unsplash.com");
        if (!isPlaceholder) return cardImageUrl;

        var pName = product.ProductName?.ToLower() ?? "";
        var cName = product.Category?.CategoryName?.ToLower() ?? "";

        if (pName.Contains("áo dài") || cName.Contains("áo dài")) return "/images/aodai.png";
        if (pName.Contains("lễ phục") || pName.Contains("tốt nghiệp")) return "/images/dototnghiep.png";
        if (pName.Contains("vest") || pName.Contains("suit")) return "/images/vestnam.png";
        if (pName.Contains("tai nghe") || pName.Contains("headphone") || cName.Contains("âm thanh") || pName.Contains("sony wh-1000xm4")) return "/images/tainghe.png";
        if (pName.Contains("máy chiếu") || pName.Contains("projector") || cName.Contains("trình chiếu")) return "/images/maychieu.png";
        if (pName.Contains("guitar") || pName.Contains("đàn") || cName.Contains("nhạc cụ")) return "/images/guitar.png";
        if (pName.Contains("xe đạp") || pName.Contains("giant") || pName.Contains("bike")) return "/images/xedap.png";
        if (pName.Contains("ipad") || pName.Contains("tablet")) return "/images/ipad.png";
        if (pName.Contains("macbook") || pName.Contains("laptop")) return "/images/mac.png";
        if (pName.Contains("máy ảnh") || pName.Contains("camera") || cName.Contains("máy ảnh")) return "/images/mayanh.png";
        if (pName.Contains("xe máy") || pName.Contains("wave") || cName.Contains("xe cộ")) return "https://images.unsplash.com/photo-1558981806-ec527fa84c39?w=800";
        if (cName.Contains("sách") || cName.Contains("giáo trình") || pName.Contains("sách")) return "/images/giaitich1.png";

        return cardImageUrl;
    }
}

<div class="lm-app-layout">
    <aside class="lm-sidebar">
        <div class="lm-sidebar-brand">
            <div class="lm-sidebar-avatar">
                <img src="https://ui-avatars.com/api/?name=@userName&background=8b5a3c&color=fff" alt="@userName" />
            </div>
            <div class="lm-sidebar-user-info">
                <div class="lm-sidebar-label">Trung tâm điều khiển</div>
                <div class="lm-sidebar-sub">Xin chào, @userName</div>
            </div>
        </div>

        <nav class="lm-sidebar-nav">
            <a href="/" class="lm-snav-item"><i class="fas fa-home"></i><span>Trang chủ</span></a>
            <a href="/Home/RenterDashboard" class="lm-snav-item"><i class="fas fa-shopping-bag"></i><span>Người thuê</span></a>
            <a href="/Home/OwnerDashboard" class="lm-snav-item active"><i class="fas fa-store"></i><span>Người cho thuê</span></a>
        </nav>

        <div class="lm-sidebar-footer">
            <a href="/Post/Create" class="lm-btn-add-post">
                <i class="fas fa-plus"></i> Đăng sản phẩm mới
            </a>
        </div>
    </aside>

    <main class="lm-main">
        <div class="lm-container">

            <div class="lm-header-section">
                <h1 class="lm-page-title">Quản lý Cửa hàng</h1>
                <p class="lm-page-subtitle">Theo dõi doanh thu, đơn hàng và các sản phẩm bạn đang cho thuê.</p>
            </div>

            <div class="lm-stats-row">
                <div class="lm-stat-card">
                    <div class="lm-stat-icon" style="background:#e6f0e9; color:#2f5c3f;"><i class="fas fa-wallet"></i></div>
                    <div class="lm-stat-body">
                        <div class="lm-stat-label">Doanh thu dự kiến tháng</div>
                        <div class="lm-stat-value">@totalRevenue.ToString("N0")đ</div>
                        <span class="lm-stat-badge lm-badge-light-green"><i class="fas fa-arrow-up"></i> 12%</span>
                    </div>
                </div>
                <div class="lm-stat-card">
                    <div class="lm-stat-icon" style="background:#fdf3e7; color:#b86e24;"><i class="fas fa-box-open"></i></div>
                    <div class="lm-stat-body">
                        <div class="lm-stat-label">Sản phẩm đang cho thuê</div>
                        <div class="lm-stat-value" style="color:#b86e24;">@rentedProducts / @totalProducts</div>
                    </div>
                </div>
                <div class="lm-stat-card">
                    <div class="lm-stat-icon" style="background:#f1f5f9; color:#64748b;"><i class="fas fa-star"></i></div>
                    <div class="lm-stat-body">
                        <div class="lm-stat-label">Đánh giá trung bình</div>
                        <div class="lm-stat-value">4.8 <i class="fas fa-star" style="color:#f59e0b;font-size:1.1rem;"></i></div>
                    </div>
                </div>
            </div>

            <div class="lm-chart-promo-row">
                <div class="lm-chart-card">
                    <div class="lm-chart-header">
                        <span class="lm-chart-title">Biểu đồ doanh thu</span>
                        <select class="lm-chart-select">
                            <option>7 ngày qua</option>
                            <option>30 ngày qua</option>
                        </select>
                    </div>
                    <div class="lm-chart-wrapper">
                        <canvas id="revenueChart"></canvas>
                    </div>
                </div>

                <div class="lm-promo-card">
                    <div class="lm-promo-icon"><i class="fas fa-gem"></i></div>
                    <h3 class="lm-promo-title">Chủ đồ Kim Cương</h3>
                    <p class="lm-promo-desc">Bạn chỉ còn 2 lượt cho thuê nữa để đạt mốc Kim Cương và nhận ưu đãi giảm 2% phí dịch vụ nền tảng.</p>
                    <a href="#" class="lm-btn-promo">Xem chi tiết</a>
                </div>
            </div>

            <div class="lm-section-header" style="margin-top: 3rem;">
                <h2>Đơn thuê khách đặt</h2>
                <div class="lm-tabs">
                    <button class="lm-tab active">Tất cả</button>
                    <button class="lm-tab">Chờ xử lý</button>
                    <button class="lm-tab">Đang thuê</button>
                </div>
            </div>

            <div class="lm-cards-list">
                @if (myRentals.Any())
                {
                    foreach (var rental in myRentals)
                    {
                        var statusClass = rental.Status == "Pending" ? "lm-badge-yellow" :
                        (rental.Status == "Confirmed" ? "lm-badge-blue" :
                        (rental.Status == "InProgress" ? "lm-badge-orange" :
                        (rental.Status == "Active" ? "lm-badge-green" :
                        (rental.Status == "Returned" ? "lm-badge-teal" : "lm-badge-gray"))));

                        var statusText = rental.Status == "Pending" ? "Chờ xác nhận" :
                        (rental.Status == "Confirmed" ? "Chờ giao" :
                        (rental.Status == "InProgress" ? "Chờ khách nhận" :
                        (rental.Status == "Active" ? "Đang thuê" :
                        (rental.Status == "Returned" ? "Khách đã trả" :
                        (rental.Status == "Completed" ? "Hoàn thành" : rental.Status)))));

                        <div class="lm-card rental-owner-card">
                            <div class="lm-card-img-small">
                                <img src="@GetPerfectCardImage(rental.Product)" alt="@(rental.Product?.ProductName)" />
                            </div>

                            <div class="lm-rental-info">
                                <h4 class="lm-item-name">@(rental.Product?.ProductName ?? "Sản phẩm")</h4>
                                <p class="lm-item-desc">Khách hàng: <strong>@(rental.Renter?.FullName ?? "Khách")</strong> | ID: #RT-@rental.RentalId</p>
                                <div class="lm-meta-row">
                                    <span class="lm-badge @statusClass">@statusText</span>
                                    <span class="lm-text-sm"><i class="far fa-calendar-alt"></i> @rental.StartDate.ToString("dd/MM") - @rental.EndDate.ToString("dd/MM")</span>
                                    <span class="lm-price-sm">@rental.TotalPrice.ToString("N0")đ</span>
                                </div>
                            </div>

                            <div class="lm-rental-actions">
                                @if (rental.Status == "Pending")
                                {
                                    <form asp-controller="Home" asp-action="ConfirmRental" method="post" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="rentalId" value="@rental.RentalId" />
                                        <button type="submit" class="lm-btn lm-btn-primary">Duyệt đơn</button>
                                    </form>
                                    <form asp-controller="Home" asp-action="CancelRental" method="post" style="margin:0;" onsubmit="return confirm('Bạn có chắc chắn muốn từ chối đơn này?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="rentalId" value="@rental.RentalId" />
                                        <button type="submit" class="lm-btn lm-btn-danger">Từ chối</button>
                                    </form>
                                }
                                else if (rental.Status == "Confirmed")
                                {
                                    <form asp-controller="Home" asp-action="ConfirmDelivery" method="post" style="margin:0;" onsubmit="return confirm('Xác nhận đã giao hàng cho khách?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="rentalId" value="@rental.RentalId" />
                                        <button type="submit" class="lm-btn lm-btn-blue"><i class="fas fa-truck"></i> Đã giao hàng</button>
                                    </form>
                                }
                                else if (rental.Status == "Returned" || rental.Status == "Active")
                                {
                                    <form asp-controller="Home" asp-action="ConfirmReturn" method="post" style="margin:0;" onsubmit="return confirm('Xác nhận đã nhận lại đồ an toàn?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="rentalId" value="@rental.RentalId" />
                                        <button type="submit" class="lm-btn lm-btn-primary"><i class="fas fa-check-double"></i> Xác nhận hoàn thành</button>
                                    </form>
                                }

                                @if (rental.Status == "Active" || rental.Status == "Returned")
                                {
                                    <a href="/Complaint/Create?rentalId=@rental.RentalId" class="lm-btn lm-btn-warning" title="Khiếu nại"><i class="fas fa-exclamation-triangle"></i></a>
                                }

                                <a href="/Home/OwnerRentalDetails/@rental.RentalId" class="lm-btn-icon" title="Chi tiết"><i class="fas fa-chevron-right"></i></a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="lm-empty-state">
                        <p>Hiện chưa có khách hàng nào đặt thuê đồ của bạn.</p>
                    </div>
                }
            </div>

            <div class="lm-section-header" style="margin-top: 4rem;">
                <h2>Kho đồ của tôi</h2>
                <a href="/Product" class="lm-view-all">Quản lý tất cả</a>
            </div>

            <div class="lm-products-grid">
                @if (myProducts.Any())
                {
                    @foreach (var product in myProducts.Take(3))
                    {
                        <div class="lm-product-card">
                            <div class="card-img-wrapper">
                                @if (!product.IsApproved)
                                {
                                    <span class="status-tag tag-yellow">Chờ duyệt</span>
                                }
                                else if (product.IsAvailable)
                                {
                                    <span class="status-tag tag-green">Sẵn sàng</span>
                                }
                                else
                                {
                                    <span class="status-tag tag-orange">Đang thuê</span>
                                }
                                <img src="@GetPerfectCardImage(product)" alt="@product.ProductName" onerror="this.src='https://via.placeholder.com/300x200/e2e8f0/94a3b8?text=No'">
                            </div>
                            <div class="card-body">
                                <div class="card-cat">@(product.Category?.CategoryName ?? "Khác")</div>
                                <h4 class="card-title-sm">@product.ProductName</h4>
                                <div class="card-footer-sm">
                                    <div class="card-price-sm">@product.PricePerDay.ToString("N0")đ<span>/ngày</span></div>
                                    <button class="lm-btn-icon-small"><i class="fas fa-pen"></i></button>
                                </div>
                            </div>
                        </div>
                    }
                }

                <div class="lm-product-card add-new-card">
                    <a href="/Post/Create" class="add-new-content">
                        <div class="add-icon"><i class="fas fa-plus"></i></div>
                        <h4>Thêm món đồ mới</h4>
                        <p>Chia sẻ vật dụng nhàn rỗi để kiếm thêm thu nhập mỗi tháng.</p>
                    </a>
                </div>
            </div>

        </div>
    </main>
</div>

<style>
    :root {
        --bg-body: #f7f5f2;
        --card-bg: #ffffff;
        --text-main: #2b3a30;
        --text-muted: #8b9690;
        --primary-green: #4a6754;
        --primary-green-hover: #3b5243;
        --primary-brown: #8b5a3c;
        --primary-brown-hover: #734a30;
        --border-color: #f0ebe1;
        --sidebar-width: 240px;
        --badge-green-bg: #e6f0e9;
        --badge-green-text: #2f5c3f;
        --badge-yellow-bg: #fdf3e7;
        --badge-yellow-text: #b86e24;
        --badge-light-green: #dcfce7;
        --badge-light-green-text: #16a34a;
        --badge-blue-bg: #e0f2fe;
        --badge-blue-text: #0284c7;
        --badge-orange-bg: #ffedd5;
        --badge-orange-text: #c2410c;
        --badge-teal-bg: #ccfbf1;
        --badge-teal-text: #0f766e;
        --badge-gray: #f1f5f9;
        --badge-gray-text: #64748b;
    }

    .lm-app-layout {
        display: flex;
        min-height: 100vh;
        background-color: var(--bg-body);
        font-family: 'Inter', sans-serif;
    }

    /* === SIDEBAR === */
    .lm-sidebar {
        width: var(--sidebar-width);
        background: #fff;
        border-right: 1px solid var(--border-color);
        /* ĐỔI TỪ FIXED SANG STICKY */
        position: sticky;
        top: 70px; /* Khoảng cách chừa ra cho thanh Header Navbar ở trên cùng của bạn */
        height: calc(100vh - 70px); /* Chiều cao = màn hình trừ đi Header */
        display: flex;
        flex-direction: column;
        padding-top: 1rem;
        z-index: 40;
        /* Đã xóa left, bottom */
    }

    .lm-sidebar-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 0 1.5rem 1.5rem;
        border-bottom: 1px solid var(--border-color);
        margin-bottom: 1rem;
    }

    .lm-sidebar-avatar img {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        object-fit: cover;
    }

    .lm-sidebar-label {
        font-size: 0.75rem;
        color: var(--primary-green);
        font-weight: 700;
        text-transform: uppercase;
    }

    .lm-sidebar-sub {
        font-size: 0.8rem;
        color: var(--text-muted);
    }

    .lm-sidebar-nav {
        flex: 1;
        padding: 0 1rem;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .lm-snav-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 15px;
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
        border-radius: 12px;
        transition: all 0.2s;
    }

        .lm-snav-item i {
            width: 20px;
            font-size: 1.1rem;
        }

        .lm-snav-item:hover {
            background: #fcfaf6;
            color: var(--text-main);
        }

        .lm-snav-item.active {
            background: var(--badge-green-bg);
            color: var(--badge-green-text);
        }

    .lm-sidebar-footer {
        padding: 1.5rem;
        border-top: 1px solid var(--border-color);
    }

    .lm-btn-add-post {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: var(--primary-brown);
        color: white;
        padding: 12px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        transition: 0.2s;
    }

        .lm-btn-add-post:hover {
            background: var(--primary-brown-hover);
        }

    /* === MAIN CONTENT === */
    .lm-main {
        /* XÓA DÒNG NÀY: margin-left: var(--sidebar-width); */
        flex: 1;
        padding: 2rem 0 4rem;
        min-width: 0; /* Thêm dòng này để các phần tử bên trong không bị tràn ra ngoài */
    }

    .lm-container {
        padding: 0 3rem;
        max-width: 1200px;
        margin: 0 auto;
    }

    .lm-header-section {
        margin-bottom: 2rem;
    }

    .lm-page-title {
        font-size: 1.8rem;
        font-weight: 800;
        color: var(--text-main);
        margin-bottom: 5px;
    }

    .lm-page-subtitle {
        font-size: 0.9rem;
        color: var(--text-muted);
    }

    /* Stats */
    .lm-stats-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 30px;
    }

    .lm-stat-card {
        background: white;
        border-radius: 20px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    }

    .lm-stat-icon {
        width: 55px;
        height: 55px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }

    .lm-stat-body {
        flex: 1;
    }

    .lm-stat-label {
        font-size: 0.8rem;
        color: var(--text-muted);
        font-weight: 500;
        margin-bottom: 5px;
    }

    .lm-stat-value {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--text-main);
        line-height: 1;
    }

    .lm-stat-badge {
        display: inline-block;
        margin-top: 8px;
        padding: 4px 8px;
        font-size: 0.7rem;
        border-radius: 6px;
    }

    /* Chart & Promo */
    .lm-chart-promo-row {
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 25px;
        margin-bottom: 30px;
    }

    .lm-chart-card {
        background: white;
        border-radius: 20px;
        padding: 20px;
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    }

    .lm-chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .lm-chart-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--text-main);
    }

    .lm-chart-select {
        padding: 6px 12px;
        border-radius: 10px;
        border: 1px solid var(--border-color);
        font-size: 0.8rem;
        color: var(--text-muted);
        outline: none;
    }

    .lm-chart-wrapper {
        height: 220px;
        position: relative;
        width: 100%;
    }

    .lm-promo-card {
        background: var(--primary-green);
        border-radius: 20px;
        padding: 25px;
        color: white;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .lm-promo-icon {
        font-size: 2rem;
        color: #fde68a;
        margin-bottom: 15px;
    }

    .lm-promo-title {
        font-size: 1.1rem;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .lm-promo-desc {
        font-size: 0.85rem;
        line-height: 1.5;
        opacity: 0.9;
        margin-bottom: 20px;
    }

    .lm-btn-promo {
        background: white;
        color: var(--primary-green);
        padding: 10px 20px;
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 700;
        text-decoration: none;
        align-self: flex-start;
        transition: 0.2s;
    }

        .lm-btn-promo:hover {
            transform: translateY(-2px);
        }

    /* Section Headers */
    .lm-section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

        .lm-section-header h2 {
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--text-main);
        }

    .lm-view-all {
        font-size: 0.85rem;
        color: var(--primary-brown);
        font-weight: 600;
        text-decoration: none;
    }

    /* Tabs */
    .lm-tabs {
        display: flex;
        gap: 15px;
    }

    .lm-tab {
        background: none;
        border: none;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-muted);
        padding-bottom: 5px;
        cursor: pointer;
        border-bottom: 2px solid transparent;
    }

        .lm-tab.active {
            color: var(--primary-green);
            border-bottom-color: var(--primary-green);
        }

    /* Rental List Cards */
    .lm-cards-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .rental-owner-card {
        background: white;
        border-radius: 16px;
        padding: 15px 20px;
        display: flex;
        align-items: center;
        gap: 20px;
        border: 1px solid var(--border-color);
    }

    .lm-card-img-small {
        width: 70px;
        height: 70px;
        border-radius: 12px;
        overflow: hidden;
        flex-shrink: 0;
    }

        .lm-card-img-small img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .lm-rental-info {
        flex: 1;
    }

    .lm-item-name {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--text-main);
        margin-bottom: 4px;
    }


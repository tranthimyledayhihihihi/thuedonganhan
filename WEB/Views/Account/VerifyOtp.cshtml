@model WEB.Models.VerifyOtpViewModel

@{
    ViewData["Title"] = "Xác thực OTP";
}

<div class="auth-container">
    <div class="auth-wrapper">
        <div class="auth-branding">
            <div class="auth-branding-icon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
            </div>
            <h1>Bảo mật<br />Tài khoản</h1>
            <p>Vui lòng xác thực email sinh viên của bạn để tiếp tục sử dụng hệ thống.</p>
        </div>

        <div class="auth-card">
            <a href="/Account/Login" class="back-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
                </svg>
                Quay lại đăng nhập
            </a>

            <div class="auth-card-header">
                <h2>Xác thực OTP</h2>
                <p>Một mã gồm 6 chữ số đã được gửi đến email của bạn.</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }

            <form asp-action="VerifyOtp" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors text-danger"></div>
                
                <input type="hidden" asp-for="Email" />

                <div class="form-group">
                    <label class="form-label">EMAIL</label>
                    <input type="text" class="form-control" value="@Model.Email" disabled />
                </div>

                <div class="form-group">
                    <label asp-for="OTPCode" class="form-label">Mã OTP (6 chữ số)</label>
                    <input asp-for="OTPCode" class="form-control" placeholder="123456" maxlength="6" autocomplete="off" style="text-align: center; font-size: 1.5rem; letter-spacing: 0.5rem;" />
                    <span asp-validation-for="OTPCode" class="text-danger"></span>
                </div>

                <button type="submit" id="btnVerify" class="btn-primary" style="margin-top: 1.5rem;">
                    Đăng ký (<span id="countdown">60</span>s)
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            let timeLeft = 60;
            const countdownEl = document.getElementById('countdown');
            const btnVerify = document.getElementById('btnVerify');
            
            const timerId = setInterval(() => {
                timeLeft--;
                if (timeLeft >= 0) {
                    countdownEl.textContent = timeLeft;
                } else {
                    clearInterval(timerId);
                    countdownEl.textContent = 'Hết hạn';
                    btnVerify.disabled = true;
                    btnVerify.style.opacity = '0.5';
                    btnVerify.style.cursor = 'not-allowed';
                }
            }, 1000);
        });
    </script>
}

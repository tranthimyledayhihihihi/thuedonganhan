@model WEB.Models.VerifyOtpViewModel

@{
    ViewData["Title"] = "Xác thực OTP";
    ViewData["HideGlobalAlert"] = true;
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<div class="auth-page-body">
    <!-- Background visual blobs -->
    <div class="auth-bg-blob auth-blob-1"></div>
    <div class="auth-bg-blob auth-blob-2"></div>
    
    <div class="auth-unique-container" style="max-width: 950px;">
        <!-- Brand/Illustration Column -->
        <div class="auth-unique-sidebar">
            <div class="auth-sidebar-header">
                <div class="auth-sidebar-badge">
                    <i class="fas fa-shield-alt"></i> Bảo mật tài khoản
                </div>
                <h1 class="auth-sidebar-title">Xác thực<br /><span>thông tin</span></h1>
                <p class="auth-sidebar-desc">Vui lòng xác thực mã OTP được gửi tới email trường của bạn để kích hoạt tài khoản và tiếp tục truy cập.</p>
            </div>
            
            <div class="auth-sidebar-footer">
                <div class="auth-sidebar-illustration">
                    <img src="https://images.unsplash.com/photo-1563986768609-322da13575f3?w=600&h=400&fit=crop" alt="Security OTP Verification" />
                </div>
            </div>
        </div>
        
        <!-- Form Column -->
        <div class="auth-unique-form-section" style="padding: 3.5rem 3rem 2rem;">
            <a href="/Account/Login" class="auth-back-home">
                <i class="fas fa-arrow-left"></i> Quay lại
            </a>
            
            <div class="auth-form-header">
                <h2 class="auth-form-title"><i class="fas fa-key" style="color: var(--auth-yellow);"></i> Xác thực OTP</h2>
                <p class="auth-form-subtitle">Nhập mã xác thực gồm 6 chữ số đã được gửi tới email của bạn.</p>
            </div>
            
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="auth-alert auth-alert-info">
                    <i class="fas fa-check-circle" style="color: var(--auth-teal); margin-right: 0.5rem;"></i> @TempData["SuccessMessage"]
                </div>
            }
            
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="auth-alert auth-alert-danger">
                    <i class="fas fa-exclamation-circle" style="margin-right: 0.5rem;"></i> @TempData["ErrorMessage"]
                </div>
            }
            
            <form asp-action="VerifyOtp" method="post">
                <div asp-validation-summary="ModelOnly" class="auth-validation-summary"></div>
                
                <input type="hidden" asp-for="Email" />

                <div class="auth-input-group">
                    <label class="auth-label">Email sinh viên</label>
                    <div class="auth-input-wrapper">
                        <span class="auth-input-icon">@@</span>
                        <input type="text" class="auth-input" value="@Model.Email" readonly style="background-color: var(--auth-dark-brown-light); cursor: not-allowed; opacity: 0.85;" />
                    </div>
                </div>

                <div class="auth-input-group">
                    <label asp-for="OTPCode" class="auth-label">Mã OTP (6 chữ số)</label>
                    <div class="auth-input-wrapper">
                        <i class="fas fa-lock auth-input-icon" style="left: 1.1rem; font-size: 0.9rem;"></i>
                        <input asp-for="OTPCode" class="auth-input" placeholder="Nhập mã 6 số" maxlength="6" autocomplete="off" 
                               style="text-align: center; font-size: 1.5rem; font-weight: 800; letter-spacing: 0.5rem; padding-left: 1rem; padding-right: 1rem;" />
                    </div>
                    <span asp-validation-for="OTPCode" class="auth-field-error"></span>
                </div>

                <button type="submit" id="btnVerify" class="auth-btn-submit" style="margin-top: 1.5rem;">
                    <span>Xác thực ngay (<span id="countdown">60</span>s)</span> <i class="fas fa-paper-plane"></i>
                </button>
            </form>
            
            <div style="margin-top: 2rem; font-size: 0.82rem; text-align: center; color: var(--auth-dark-brown); opacity: 0.7; line-height: 1.5;">
                <i class="fas fa-info-circle" style="color: var(--auth-teal);"></i> Không nhận được mã? Hãy kiểm tra trong thư mục <strong>Spam (Thư rác)</strong> hoặc hòm thư phụ của bạn.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            let timeLeft = 60;
            const countdownEl = document.getElementById('countdown');
            const btnVerify = document.getElementById('btnVerify');
            
            const timerId = setInterval(() => {
                timeLeft--;
                if (timeLeft >= 0) {
                    countdownEl.textContent = timeLeft + 's';
                } else {
                    clearInterval(timerId);
                    countdownEl.textContent = 'Hết hạn';
                    btnVerify.disabled = true;
                    btnVerify.style.opacity = '0.5';
                    btnVerify.style.cursor = 'not-allowed';
                }
            }, 1000);
        });
    </script>
}

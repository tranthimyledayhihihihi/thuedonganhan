@model WEB.Models.WalletViewModel
@{
    ViewData["Title"] = "Ví ký quỹ tài khoản";
}

<div class="wallet-page-container">
    <div class="wallet-layout">
        <!-- Cột trái: Thông tin số dư và Thao tác nhanh -->
        <div class="wallet-card-container">
            <div class="glass-card main-wallet-card">
                <div class="card-brand">
                    <span class="brand-text">UTE Rent Escrow System</span>
                    <i class="fas fa-shield-alt shield-icon" title="Hệ thống giao dịch ký quỹ an toàn"></i>
                </div>
                <div class="card-chip"></div>
                <div class="balance-display">
                    <span class="balance-label">Số dư khả dụng</span>
                    <h1 class="balance-amount">@Model.Balance.ToString("N0")<span class="currency">đ</span></h1>
                </div>
                <div class="card-footer-info">
                    <div class="info-block">
                        <span class="info-label">Chủ thẻ</span>
                        <span class="info-value">@Context.Session.GetString("UserName")</span>
                    </div>
                    <div class="info-block">
                        <span class="info-label">Mã sinh viên</span>
                        <span class="info-value">@Context.Session.GetString("UserEmail")?.Split('@')[0]</span>
                    </div>
                </div>
            </div>

            <!-- Nút thao tác nhanh -->
            <div class="wallet-actions">
                <button class="btn-wallet action-deposit" onclick="openModal('depositModal')">
                    <div class="action-icon bg-success-light">
                        <i class="fas fa-arrow-down"></i>
                    </div>
                    <div class="action-text">
                        <span class="action-title">Nạp tiền vào ví</span>
                        <span class="action-desc">Nạp tiền giả lập nhanh chóng</span>
                    </div>
                </button>

                <button class="btn-wallet action-withdraw" onclick="openModal('withdrawModal')">
                    <div class="action-icon bg-warning-light">
                        <i class="fas fa-arrow-up"></i>
                    </div>
                    <div class="action-text">
                        <span class="action-title">Rút tiền về ngân hàng</span>
                        <span class="action-desc">Rút tiền mặt ra tài khoản</span>
                    </div>
                </button>
            </div>

            <!-- Cam kết an toàn -->
            <div class="escrow-badge">
                <i class="fas fa-info-circle text-amber"></i>
                <p>Tiền của bạn sẽ được giữ an toàn trên hệ thống ví ký quỹ (Escrow) của **UTE Rent** và chỉ thanh toán cho chủ sở hữu sau khi đơn thuê hoàn tất tốt đẹp.</p>
            </div>
        </div>

        <!-- Cột phải: Lịch sử giao dịch -->
        <div class="transactions-container">
            <h2 class="section-title">Lịch sử biến động số dư</h2>
            <div class="glass-card transactions-card">
                @if (Model.Transactions == null || !Model.Transactions.Any())
                {
                    <div class="empty-transactions">
                        <div class="empty-icon-container">
                            <i class="fas fa-exchange-alt"></i>
                        </div>
                        <h3>Chưa có giao dịch nào</h3>
                        <p>Mọi giao dịch nạp, rút, thanh toán ký quỹ sẽ xuất hiện tại đây.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table-modern">
                            <thead>
                                <tr>
                                    <th>Thời gian</th>
                                    <th>Mã GD</th>
                                    <th>Loại giao dịch</th>
                                    <th>Nội dung</th>
                                    <th class="text-right">Số tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tx in Model.Transactions)
                                {
                                    var isPositive = tx.Amount > 0;
                                    var badgeClass = tx.Type switch
                                    {
                                        "Deposit" => "badge-success",
                                        "Withdraw" => "badge-danger",
                                        "Payment" => "badge-info",
                                        "Refund" => "badge-warning",
                                        "Commission" => "badge-primary",
                                        _ => "badge-secondary"
                                    };
                                    var typeText = tx.Type switch
                                    {
                                        "Deposit" => "Nạp tiền",
                                        "Withdraw" => "Rút tiền",
                                        "Payment" => "Thanh toán",
                                        "Refund" => "Hoàn tiền",
                                        "Commission" => "Hoa hồng",
                                        _ => tx.Type
                                    };
                                    <tr>
                                        <td class="text-muted text-sm">@tx.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="tx-id font-mono">#GD-@tx.TransactionId</td>
                                        <td>
                                            <span class="badge @badgeClass">@typeText</span>
                                        </td>
                                        <td class="tx-desc">@tx.Description</td>
                                        <td class="text-right font-semibold @(isPositive ? "text-success" : "text-danger")">
                                            @(isPositive ? "+" : "")@tx.Amount.ToString("N0")đ
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal Nạp Tiền -->
<div id="depositModal" class="modal-backdrop">
    <div class="modal-card scale-in">
        <div class="modal-header">
            <h3 class="modal-title"><i class="fas fa-arrow-down text-success"></i> Nạp tiền vào ví</h3>
            <button class="modal-close" onclick="closeModal('depositModal')">&times;</button>
        </div>
        <form asp-controller="Wallet" asp-action="Deposit" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <div class="form-group-modern">
                    <label for="depositAmount">Số tiền cần nạp (đ)</label>
                    <input type="number" id="depositAmount" name="amount" min="10000" max="100000000" step="10000" value="50000" required />
                    <span class="form-help">Tối thiểu: 10.000đ | Tối đa: 100.000.000đ</span>
                </div>
                <div class="quick-amounts">
                    <button type="button" class="btn-quick" onclick="setAmount('depositAmount', 50000)">50k</button>
                    <button type="button" class="btn-quick" onclick="setAmount('depositAmount', 100000)">100k</button>
                    <button type="button" class="btn-quick" onclick="setAmount('depositAmount', 200000)">200k</button>
                    <button type="button" class="btn-quick" onclick="setAmount('depositAmount', 500000)">500k</button>
                    <button type="button" class="btn-quick" onclick="setAmount('depositAmount', 1000000)">1M</button>
                </div>
                <div class="form-group-modern mt-3">
                    <label for="depositDesc">Ghi chú giao dịch</label>
                    <input type="text" id="depositDesc" name="description" placeholder="Nạp tiền ví UTE Rent" value="Nạp tiền vào tài khoản" />
                </div>
                
                <div class="simulated-payment-info">
                    <i class="fas fa-info-circle text-blue"></i>
                    <p>Hệ thống đang chạy ở chế độ Demo sinh viên. Lệnh nạp tiền này sẽ được xử lý tự động và cộng tiền ảo ngay lập tức để phục vụ việc chấm bài đồ án.</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" onclick="closeModal('depositModal')">Hủy bỏ</button>
                <button type="submit" class="btn-primary bg-success border-success">Xác nhận nạp tiền</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Rút Tiền -->
<div id="withdrawModal" class="modal-backdrop">
    <div class="modal-card scale-in">
        <div class="modal-header">
            <h3 class="modal-title"><i class="fas fa-arrow-up text-warning"></i> Rút tiền về ngân hàng</h3>
            <button class="modal-close" onclick="closeModal('withdrawModal')">&times;</button>
        </div>
        <form asp-controller="Wallet" asp-action="Withdraw" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <div class="form-group-modern">
                    <label for="withdrawAmount">Số tiền cần rút (đ)</label>
                    <input type="number" id="withdrawAmount" name="amount" min="10000" max="@Model.Balance" step="10000" value="50000" required />
                    <span class="form-help">Số dư khả dụng: <strong>@Model.Balance.ToString("N0")đ</strong></span>
                </div>
                <div class="quick-amounts">
                    <button type="button" class="btn-quick" onclick="setAmount('withdrawAmount', 50000)">50k</button>
                    <button type="button" class="btn-quick" onclick="setAmount('withdrawAmount', 100000)">100k</button>
                    <button type="button" class="btn-quick" onclick="setAmount('withdrawAmount', 200000)">200k</button>
                    <button type="button" class="btn-quick" onclick="setAmount('withdrawAmount', Math.min(500000, @Model.Balance))">500k</button>
                    <button type="button" class="btn-quick" onclick="setAmount('withdrawAmount', @Model.Balance)">Rút hết</button>
                </div>
                <div class="form-group-modern mt-3">
                    <label for="withdrawBank">Tài khoản ngân hàng nhận tiền</label>
                    <select id="withdrawBank" required>
                        <option value="Vietcombank">Vietcombank - Ngân hàng Ngoại Thương</option>
                        <option value="MBBank">MB Bank - Ngân hàng Quân Đội</option>
                        <option value="Agribank">Agribank - Ngân hàng Nông Nghiệp</option>
                        <option value="TPBank">TPBank - Ngân hàng Tiên Phong</option>
                    </select>
                </div>
                <div class="form-group-modern mt-3">
                    <label for="withdrawAccountNum">Số tài khoản nhận</label>
                    <input type="text" id="withdrawAccountNum" placeholder="Ví dụ: 1023948576" required value="2311505312" />
                </div>
                <div class="form-group-modern mt-3">
                    <label for="withdrawDesc">Ghi chú giao dịch</label>
                    <input type="text" id="withdrawDesc" name="description" placeholder="Rút tiền ví UTE Rent" value="Rút tiền về tài khoản ngân hàng" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" onclick="closeModal('withdrawModal')">Hủy bỏ</button>
                <button type="submit" class="btn-primary bg-warning border-warning">Xác nhận rút tiền</button>
            </div>
        </form>
    </div>
</div>

<style>
    /* Styling cho Wallet Page cực kỳ premium theo phong cách Glassmorphism */
    .wallet-page-container {
        max-width: 1200px;
        margin: 2rem auto;
        padding: 0 1.5rem;
        font-family: 'Inter', sans-serif;
    }

    .wallet-layout {
        display: grid;
        grid-template-columns: 1fr 1.8fr;
        gap: 2.5rem;
    }

    @@media (max-width: 992px) {
        .wallet-layout {
            grid-template-columns: 1fr;
        }
    }

    /* Glassmorphism Card base */
    .glass-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 24px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        padding: 2rem;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    /* Thẻ Visa-style Card số dư */
    .main-wallet-card {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: white;
        min-height: 240px;
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: 0 20px 40px rgba(15, 23, 42, 0.3);
    }

    .main-wallet-card::before {
        content: '';
        position: absolute;
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, rgba(245, 158, 11, 0.15) 0%, rgba(245, 158, 11, 0) 70%);
        top: -150px;
        right: -150px;
        pointer-events: none;
    }

    .card-brand {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .card-brand .brand-text {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: rgba(255, 255, 255, 0.6);
        font-weight: 700;
    }

    .shield-icon {
        color: #f59e0b;
        font-size: 1.5rem;
    }

    .card-chip {
        width: 45px;
        height: 35px;
        background: linear-gradient(135deg, #e2e8f0 0%, #cbd5e1 100%);
        border-radius: 6px;
        margin-top: 1rem;
        position: relative;
    }

    .balance-display {
        margin-top: 1.5rem;
    }

    .balance-label {
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.5);
        display: block;
        margin-bottom: 0.25rem;
    }

    .balance-amount {
        font-size: 2.5rem;
        font-weight: 800;
        letter-spacing: -1px;
        margin: 0;
        display: flex;
        align-items: baseline;
    }

    .balance-amount .currency {
        font-size: 1.5rem;
        margin-left: 0.2rem;
        color: #f59e0b;
    }

    .card-footer-info {
        display: flex;
        justify-content: space-between;
        margin-top: 2rem;
    }

    .info-block {
        display: flex;
        flex-direction: column;
    }

    .info-label {
        font-size: 0.7rem;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.4);
        margin-bottom: 0.2rem;
    }

    .info-value {
        font-size: 0.95rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.9);
    }

    /* Các nút thao tác */
    .wallet-actions {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 1.5rem;
    }

    .btn-wallet {
        display: flex;
        align-items: center;
        width: 100%;
        padding: 1rem;
        background: rgba(255, 255, 255, 0.9);
        border: 1px solid rgba(0, 0, 0, 0.05);
        border-radius: 18px;
        text-align: left;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
    }

    .btn-wallet:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06);
        border-color: rgba(245, 158, 11, 0.3);
    }

    .action-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        margin-right: 1.25rem;
    }

    .bg-success-light {
        background: rgba(16, 185, 129, 0.1);
        color: #10b981;
    }

    .bg-warning-light {
        background: rgba(245, 158, 11, 0.1);
        color: #d97706;
    }

    .action-text {
        display: flex;
        flex-direction: column;
    }

    .action-title {
        font-size: 1rem;
        font-weight: 700;
        color: #1e293b;
    }

    .action-desc {
        font-size: 0.8rem;
        color: #64748b;
        margin-top: 0.1rem;
    }

    /* Ký quỹ Badge */
    .escrow-badge {
        display: flex;
        gap: 0.75rem;
        background: rgba(245, 158, 11, 0.06);
        border: 1px dashed rgba(245, 158, 11, 0.3);
        border-radius: 18px;
        padding: 1.25rem;
        margin-top: 1.5rem;
        align-items: flex-start;
    }

    .escrow-badge p {
        margin: 0;
        font-size: 0.82rem;
        line-height: 1.45;
        color: #78350f;
    }

    .text-amber {
        color: #d97706;
        font-size: 1.1rem;
        margin-top: 0.1rem;
    }

    /* Transactions list */
    .transactions-container {
        display: flex;
        flex-direction: column;
    }

    .section-title {
        font-size: 1.35rem;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .transactions-card {
        flex: 1;
        overflow: hidden;
        padding: 0;
    }

    /* Empty state */
    .empty-transactions {
        padding: 4rem 2rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .empty-icon-container {
        width: 80px;
        height: 80px;
        border-radius: 9999px;
        background: rgba(148, 163, 184, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: #94a3b8;
        margin-bottom: 1.5rem;
    }

    .empty-transactions h3 {
        font-size: 1.2rem;
        font-weight: 700;
        color: #334155;
        margin-bottom: 0.5rem;
    }

    .empty-transactions p {
        color: #64748b;
        font-size: 0.9rem;
        max-width: 320px;
    }

    /* Table styles */
    .table-responsive {
        width: 100%;
        overflow-x: auto;
    }

    .table-modern {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }

    .table-modern th {
        padding: 1.25rem 1.5rem;
        font-weight: 700;
        font-size: 0.85rem;
        text-transform: uppercase;
        color: #64748b;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        background: rgba(0, 0, 0, 0.01);
    }

    .table-modern td {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid rgba(0, 0, 0, 0.03);
        font-size: 0.9rem;
        color: #334155;
    }

    .table-modern tr:hover td {
        background: rgba(245, 158, 11, 0.02);
    }

    .tx-id {
        font-family: monospace;
        font-weight: 700;
        color: #64748b;
    }

    .tx-desc {
        max-width: 250px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        font-weight: 500;
    }

    .text-right {
        text-align: right;
    }

    .font-semibold {
        font-weight: 600;
    }

    .font-mono {
        font-family: monospace;
    }

    /* Badges */
    .badge {
        display: inline-flex;
        align-items: center;
        padding: 0.25rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .badge-success {
        background: rgba(16, 185, 129, 0.1);
        color: #065f46;
    }

    .badge-danger {
        background: rgba(239, 68, 68, 0.1);
        color: #991b1b;
    }

    .badge-info {
        background: rgba(59, 130, 246, 0.1);
        color: #1e40af;
    }

    .badge-warning {
        background: rgba(245, 158, 11, 0.1);
        color: #92400e;
    }

    .badge-primary {
        background: rgba(139, 92, 246, 0.1);
        color: #5b21b6;
    }

    .text-success {
        color: #10b981 !important;
    }

    .text-danger {
        color: #ef4444 !important;
    }

    /* Modal Backdrop */
    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(15, 23, 42, 0.4);
        backdrop-filter: blur(8px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 1.5rem;
    }

    .modal-backdrop.active {
        display: flex;
    }

    .modal-card {
        background: white;
        border-radius: 24px;
        max-width: 480px;
        width: 100%;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15);
        overflow: hidden;
        animation: scaleIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    @@keyframes scaleIn {
        from { transform: scale(0.9); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem 2rem;
        border-bottom: 1px solid #f1f5f9;
    }

    .modal-title {
        font-size: 1.2rem;
        font-weight: 800;
        color: #0f172a;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .modal-close {
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        color: #94a3b8;
        transition: color 0.2s;
    }

    .modal-close:hover {
        color: #334155;
    }

    .modal-body {
        padding: 1.5rem 2rem;
    }

    /* Form control premium */
    .form-group-modern {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .form-group-modern label {
        font-size: 0.85rem;
        font-weight: 700;
        color: #334155;
    }

    .form-group-modern input, .form-group-modern select {
        padding: 0.85rem 1rem;
        border: 1px solid #cbd5e1;
        border-radius: 12px;
        font-size: 1rem;
        color: #1e293b;
        font-weight: 600;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .form-group-modern input:focus, .form-group-modern select:focus {
        border-color: #f59e0b;
        box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.1);
    }

    .form-help {
        font-size: 0.78rem;
        color: #64748b;
    }

    /* Quick amounts */
    .quick-amounts {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 0.5rem;
        margin-top: 0.75rem;
    }

    .btn-quick {
        padding: 0.5rem 0.25rem;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        border-radius: 8px;
        cursor: pointer;
        font-size: 0.82rem;
        font-weight: 700;
        color: #475569;
        transition: all 0.2s;
        text-align: center;
    }

    .btn-quick:hover {
        background: rgba(245, 158, 11, 0.1);
        border-color: #f59e0b;
        color: #d97706;
    }

    .mt-3 {
        margin-top: 1rem;
    }

    .simulated-payment-info {
        display: flex;
        gap: 0.5rem;
        background: rgba(59, 130, 246, 0.05);
        border: 1px dashed rgba(59, 130, 246, 0.3);
        padding: 0.75rem;
        border-radius: 12px;
        margin-top: 1.25rem;
    }

    .simulated-payment-info p {
        font-size: 0.75rem;
        line-height: 1.4;
        margin: 0;

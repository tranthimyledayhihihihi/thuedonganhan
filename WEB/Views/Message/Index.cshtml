@{
    ViewData["Title"] = "Tin nhắn";
}

<div class="message-container">
    <!-- Chat Sidebar -->
    <aside class="chat-sidebar">
        <div class="chat-sidebar-header">
            <h2>Tin nhắn</h2>
            <button class="btn-new-chat" title="Tin nhắn mới">
                <i class="fas fa-edit"></i>
            </button>
        </div>

        <div class="chat-search">
            <i class="fas fa-search"></i>
            <input type="text" placeholder="Tìm kiếm cuộc trò chuyện..." class="chat-search-input" />
        </div>

        <div class="chat-tabs">
            <button class="chat-tab active">
                Tất cả
                <span class="tab-badge">12</span>
            </button>
            <button class="chat-tab">
                Chưa đọc
                <span class="tab-badge">3</span>
            </button>
        </div>

        <div class="chat-list">
            <div class="chat-item active">
                <div class="chat-avatar">
                    <img src="https://ui-avatars.com/api/?name=Minh+Anh&background=2563eb&color=fff" alt="Minh Anh" />
                    <span class="online-indicator"></span>
                </div>
                <div class="chat-info">
                    <div class="chat-name">Minh Anh</div>
                    <div class="chat-preview">Sách còn không bạn?</div>
                </div>
                <div class="chat-meta">
                    <div class="chat-time">10:30</div>
                    <span class="unread-badge">2</span>
                </div>
            </div>

            <div class="chat-item">
                <div class="chat-avatar">
                    <img src="https://ui-avatars.com/api/?name=Thuy+Trang&background=c084fc&color=fff" alt="Thúy Trang" />
                </div>
                <div class="chat-info">
                    <div class="chat-name">Thúy Trang</div>
                    <div class="chat-preview">Cảm ơn bạn nhiều nhé!</div>
                </div>
                <div class="chat-meta">
                    <div class="chat-time">Hôm qua</div>
                </div>
            </div>

            <div class="chat-item">
                <div class="chat-avatar">
                    <img src="https://ui-avatars.com/api/?name=Hoang+Nam&background=10b981&color=fff" alt="Hoàng Nam" />

                    <div class="message-bubble">
                        Chào bạn! Mình thấy bạn đăng cho thuê sách Giải tích nâng cao
                    </div>
                    <div class="message-time">10:25</div>
                </div>
            </div>

            <div class="message received">
                <div class="message-avatar">
                    <img src="https://ui-avatars.com/api/?name=Minh+Anh&background=2563eb&color=fff" alt="Minh Anh" />
                </div>
                <div class="message-content">
                    <div class="message-bubble">
                        Sách còn không bạn? Mình muốn thuê từ tuần sau
                    </div>
                    <div class="message-time">10:26</div>
                </div>
            </div>

            <div class="message sent">
                <div class="message-content">
                    <div class="message-bubble">
                        Chào bạn! Sách vẫn còn nha
                    </div>
                    <div class="message-time">10:27</div>
                </div>
            </div>

            <div class="message sent">
                <div class="message-content">
                    <div class="message-bubble">
                        Bạn muốn thuê bao lâu? Giá 5k/ngày, cọc 100k nhé
                    </div>
                    <div class="message-time">10:27</div>
                </div>
            </div>

            <div class="message received">
                <div class="message-avatar">
                    <img src="https://ui-avatars.com/api/?name=Minh+Anh&background=2563eb&color=fff" alt="Minh Anh" />
                </div>
                <div class="message-content">
                    <div class="message-bubble">
                        Mình thuê khoảng 2 tuần được không?
                    </div>
                    <div class="message-time">10:28</div>
                </div>
            </div>

            <div class="message sent">
                <div class="message-content">
                    <div class="message-bubble">
                        Được bạn! 2 tuần là 70k. Bạn lấy ở đâu?
                    </div>
                    <div class="message-time">10:29</div>
                </div>
            </div>

            <div class="message received">
                <div class="message-avatar">
                    <img src="https://ui-avatars.com/api/?name=Minh+Anh&background=2563eb&color=fff" alt="Minh Anh" />
                </div>
                <div class="message-content">
                    <div class="message-bubble">
                        Mình ở ký túc xá UTE. Bạn có thể gặp mình ở đó không?
                    </div>
                    <div class="message-time">10:30</div>
                </div>
            </div>

            <div class="typing-indicator">
                <div class="message-avatar">
                    <img src="https://ui-avatars.com/api/?name=Minh+Anh&background=2563eb&color=fff" alt="Minh Anh" />
                </div>
                <div class="typing-dots">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
        </div>

        <div class="chat-input-container">
            <button class="chat-input-btn" title="Đính kèm file">
                <i class="fas fa-paperclip"></i>
            </button>
            <button class="chat-input-btn" title="Hình ảnh">
                <i class="fas fa-image"></i>
            </button>
            <div class="chat-input-wrapper">
                <input type="text" placeholder="Nhập tin nhắn..." class="chat-input" />
                <button class="chat-input-emoji" title="Emoji">
                    <i class="far fa-smile"></i>
                </button>
            </div>
            <button class="chat-send-btn">
                <i class="fas fa-paper-plane"></i>
            </button>
        </div>
    </div>

    <!-- Chat Info Sidebar (Optional) -->
    <aside class="chat-info-sidebar">
        <div class="chat-info-header">
            <div class="chat-info-avatar">
                <img src="https://ui-avatars.com/api/?name=Minh+Anh&background=2563eb&color=fff" alt="Minh Anh" />
            </div>
            <h3>Minh Anh</h3>
            <p>@@minhanh.ute</p>
        </div>

        <div class="chat-info-section">
            <h4>Thông tin</h4>
            <div class="info-item">
                <i class="fas fa-envelope"></i>
                <span>minhanh@@sv.ute.udn.vn</span>
            </div>
            <div class="info-item">
                <i class="fas fa-phone"></i>
                <span>0123 456 789</span>
            </div>
            <div class="info-item">
                <i class="fas fa-map-marker-alt"></i>
                <span>Đà Nẵng</span>
            </div>
        </div>

        <div class="chat-info-section">
            <h4>Sản phẩm liên quan</h4>
            <div class="related-product">
                <img src="https://images.unsplash.com/photo-1523050854058-8df90110c9f1?w=100&h=100&fit=crop" alt="Product" />
                <div class="related-product-info">
                    <div class="related-product-name">Sách Giải tích nâng cao</div>
                    <div class="related-product-price">5.000đ/ngày</div>
                </div>
            </div>
        </div>

        <div class="chat-info-section">
            <h4>File đã chia sẻ</h4>
            <div class="shared-files">
                <div class="shared-file">
                    <i class="fas fa-file-pdf"></i>
                    <span>hop_dong_thue.pdf</span>
                </div>
                <div class="shared-file">
                    <i class="fas fa-file-image"></i>
                    <span>hinh_san_pham.jpg</span>
                </div>
            </div>
        </div>

        <div class="chat-info-actions">
            <button class="info-action-btn danger">
                <i class="fas fa-ban"></i>
                Chặn người dùng
            </button>
            <button class="info-action-btn danger">
                <i class="fas fa-trash"></i>
                Xóa cuộc trò chuyện
            </button>
        </div>
    </aside>
</div>

<style>
    .message-container {
        display: grid;
        grid-template-columns: 320px 1fr 300px;
        height: calc(100vh - 70px);
        background: #f8f9fa;
    }

    /* Chat Sidebar */
    .chat-sidebar {
        background: white;
        border-right: 1px solid #e2e8f0;
        display: flex;
        flex-direction: column;
    }

    .chat-sidebar-header {
        padding: 1.5rem;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .chat-sidebar-header h2 {
        font-size: 1.5rem;
        font-weight: 700;
    }

    .btn-new-chat {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--primary-blue);
        color: white;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }

    .btn-new-chat:hover {
        transform: scale(1.1);
    }

    .chat-search {
        padding: 1rem 1.5rem;
        position: relative;
    }

    .chat-search i {
        position: absolute;
        left: 2.5rem;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
    }

    .chat-search-input {
        width: 100%;
        padding: 0.75rem 1rem 0.75rem 2.5rem;
        background: #f8f9fa;
        border: 2px solid #e2e8f0;
        border-radius: 10px;
        font-size: 0.875rem;
    }

    .chat-tabs {
        display: flex;
        padding: 0 1.5rem;
        gap: 0.5rem;
        border-bottom: 1px solid #e2e8f0;
    }

    .chat-tab {
        flex: 1;
        padding: 0.75rem 1rem;
        background: none;
        border: none;
        border-bottom: 3px solid transparent;
        font-weight: 600;
        color: var(--text-secondary);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
    }

    .chat-tab.active {
        color: var(--primary-blue);
        border-bottom-color: var(--primary-blue);
    }

    .tab-badge {
        padding: 0.125rem 0.5rem;
        background: #e2e8f0;
        border-radius: 10px;
        font-size: 0.75rem;
    }

    .chat-tab.active .tab-badge {
        background: var(--primary-blue);
        color: white;
    }

    .chat-list {
        flex: 1;
        overflow-y: auto;
    }

    .chat-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.5rem;
        cursor: pointer;
        transition: all 0.3s ease;
        border-left: 3px solid transparent;
    }

    .chat-item:hover {
        background: #f8f9fa;
    }

    .chat-item.active {
        background: #eff6ff;
        border-left-color: var(--primary-blue);
    }

    .chat-avatar {
        position: relative;
        flex-shrink: 0;
    }

    .chat-avatar img {
        width: 50px;
        height: 50px;
        border-radius: 50%;
    }

    .online-indicator {
        position: absolute;
        bottom: 2px;
        right: 2px;
        width: 12px;
        height: 12px;
        background: #10b981;
        border: 2px solid white;
        border-radius: 50%;
    }

    .chat-info {
        flex: 1;
        min-width: 0;
    }

    .chat-name {
        font-weight: 600;
        margin-bottom: 0.25rem;
    }

    .chat-preview {
        font-size: 0.875rem;
        color: var(--text-secondary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .chat-meta {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.25rem;
    }

    .chat-time {
        font-size: 0.75rem;
        color: var(--text-secondary);
    }

    .unread-badge {
        min-width: 20px;
        height: 20px;
        padding: 0 0.375rem;
        background: var(--primary-blue);
        color: white;
        border-radius: 10px;
        font-size: 0.75rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Chat Main */
    .chat-main {
        display: flex;
        flex-direction: column;
        background: white;
    }

    .chat-header {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .chat-header-user {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .chat-header-info {
        display: flex;
        flex-direction: column;
    }

    .chat-header-name {
        font-weight: 700;
        font-size: 1.125rem;
    }

    .chat-header-status {
        font-size: 0.875rem;
        color: #10b981;
    }

    .chat-header-actions {
        display: flex;
        gap: 0.5rem;
    }

    .chat-action-btn {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #f8f9fa;
        border: none;
        color: var(--text-secondary);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }

    .chat-action-btn:hover {
        background: #eff6ff;
        color: var(--primary-blue);
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 1.5rem;
        background: #f8f9fa;
    }

    .message-date {
        text-align: center;
        font-size: 0.75rem;
        color: var(--text-secondary);
        margin: 1rem 0;
    }

    .message {
        display: flex;
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

    .message.sent {
        flex-direction: row-reverse;
    }

    .message-avatar img {
        width: 36px;
        height: 36px;
        border-radius: 50%;
    }

    .message-content {
        display: flex;
        flex-direction: column;
        max-width: 60%;
    }

    .message.sent .message-content {
        align-items: flex-end;
    }

    .message-bubble {
        padding: 0.75rem 1rem;
        border-radius: 16px;
        line-height: 1.5;
    }

    .message.received .message-bubble {
        background: white;
        border-bottom-left-radius: 4px;
    }

    .message.sent .message-bubble {
        background: linear-gradient(135deg, var(--primary-blue) 0%, #1d4ed8 100%);
        color: white;
        border-bottom-right-radius: 4px;
    }

    .message-time {
        font-size: 0.75rem;
        color: var(--text-secondary);
        margin-top: 0.25rem;
        padding: 0 0.5rem;
    }

    .typing-indicator {
        display: flex;
        gap: 0.75rem;
        align-items: center;
    }

    .typing-dots {
        display: flex;
        gap: 0.25rem;
        padding: 0.75rem 1rem;
        background: white;
        border-radius: 16px;
        border-bottom-left-radius: 4px;
    }

    .typing-dots span {
        width: 8px;
        height: 8px;
        background: #cbd5e1;
        border-radius: 50%;
        animation: typing 1.4s infinite;
    }

    .typing-dots span:nth-child(2) {
        animation-delay: 0.2s;
    }

    .typing-dots span:nth-child(3) {
        animation-delay: 0.4s;
    }

    @@keyframes typing {
        0%, 60%, 100% {
            transform: translateY(0);
        }
        30% {
            transform: translateY(-10px);
        }
    }

    .chat-input-container {
        padding: 1rem 1.5rem;
        border-top: 1px solid #e2e8f0;
        display: flex;
        gap: 0.75rem;
        align-items: center;
    }

    .chat-input-btn {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #f8f9fa;
        border: none;
        color: var(--text-secondary);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }

    .chat-input-btn:hover {
        background: #e2e8f0;
    }

    .chat-input-wrapper {
        flex: 1;
        position: relative;
    }

    .chat-input {
        width: 100%;
        padding: 0.75rem 3rem 0.75rem 1rem;
        background: #f8f9fa;
        border: 2px solid #e2e8f0;
        border-radius: 24px;
        font-size: 0.9375rem;
    }

    .chat-input:focus {
        outline: none;
        border-color: var(--primary-blue);
        background: white;
    }

    .chat-input-emoji {
        position: absolute;
        right: 0.75rem;
        top: 50%;
        transform: translateY(-50%);
        width: 32px;
        height: 32px;
        border: none;
        background: none;
        color: var(--text-secondary);
        cursor: pointer;
        font-size: 1.25rem;
    }

    .chat-send-btn {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--primary-blue) 0%, #1d4ed8 100%);
        color: white;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }

    .chat-send-btn:hover {
        transform: scale(1.1);
    }

    /* Chat Info Sidebar */
    .chat-info-sidebar {
        background: white;
        border-left: 1px solid #e2e8f0;
        overflow-y: auto;
    }

    .chat-info-header {
        padding: 2rem 1.5rem;
        text-align: center;
        border-bottom: 1px solid #e2e8f0;
    }

    .chat-info-avatar img {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        margin-bottom: 1rem;
    }

    .chat-info-header h3 {
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 0.25rem;
    }

    .chat-info-header p {
        font-size: 0.875rem;
        color: var(--text-secondary);
    }

    .chat-info-section {
        padding: 1.5rem;
        border-bottom: 1px solid #e2e8f0;
    }

    .chat-info-section h4 {
        font-size: 0.875rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-secondary);
        margin-bottom: 1rem;
    }

    .info-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 0;
        font-size: 0.875rem;
    }

    .info-item i {
        width: 20px;
        color: var(--text-secondary);
    }

    .related-product {
        display: flex;
        gap: 0.75rem;
        padding: 0.75rem;
        background: #f8f9fa;
        border-radius: 10px;
    }

    .related-product img {
        width: 60px;
        height: 60px;
        border-radius: 8px;
        object-fit: cover;
    }

    .related-product-info {
        flex: 1;
    }

    .related-product-name {
        font-weight: 600;
        font-size: 0.875rem;
        margin-bottom: 0.25rem;
    }

    .related-product-price {
        font-size: 0.875rem;
        color: var(--primary-blue);
        font-weight: 700;
    }

    .shared-files {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .shared-file {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem;
        background: #f8f9fa;
        border-radius: 8px;
        font-size: 0.875rem;
        cursor: pointer;
        transition: all 0.3s ease;

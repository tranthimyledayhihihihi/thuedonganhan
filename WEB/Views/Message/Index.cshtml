                </div>
                <div class="chat-info">
                    <div class="chat-name">Hoàng Nam</div>
                    <div class="chat-preview">Máy ảnh còn không bạn?</div>
                </div>
                <div class="chat-meta">
                    <div class="chat-time">2 ngày</div>
                    <span class="unread-badge">1</span>
                </div>
            </div>

            <div class="chat-item">
                <div class="chat-avatar">
                    <img src="https://ui-avatars.com/api/?name=Phuong+Linh&background=f59e0b&color=fff" alt="Phương Linh" />
                </div>
                <div class="chat-info">
                    <div class="chat-name">Phương Linh</div>
                    <div class="chat-preview">Mình muốn thuê laptop</div>
                </div>
                <div class="chat-meta">
                    <div class="chat-time">3 ngày</div>
                </div>
            </div>

            <div class="chat-item">
                <div class="chat-avatar">
                    <img src="https://ui-avatars.com/api/?name=Duc+Anh&background=ef4444&color=fff" alt="Đức Anh" />
                </div>
                <div class="chat-info">
                    <div class="chat-name">Đức Anh</div>
                    <div class="chat-preview">Ok bạn, hẹn gặp lại</div>
                </div>
                <div class="chat-meta">
                    <div class="chat-time">1 tuần</div>
                </div>
            </div>

            <div class="chat-item">
                <div class="chat-avatar">
                    <img src="https://ui-avatars.com/api/?name=Thu+Ha&background=8b5cf6&color=fff" alt="Thu Hà" />
                </div>
                <div class="chat-info">
                    <div class="chat-name">Thu Hà</div>
                    <div class="chat-preview">Bạn có thể giao hàng không?</div>
                </div>
                <div class="chat-meta">
                    <div class="chat-time">1 tuần</div>
                </div>
            </div>
        </div>
    </aside>

    <!-- Chat Main -->
    <div class="chat-main">
        <div class="chat-header">
            <div class="chat-header-user">
                <div class="chat-avatar">
                    <img src="https://ui-avatars.com/api/?name=Minh+Anh&background=2563eb&color=fff" alt="Minh Anh" />
                    <span class="online-indicator"></span>
                </div>
                <div class="chat-header-info">
                    <div class="chat-header-name">Minh Anh</div>
                    <div class="chat-header-status">Đang hoạt động</div>
                </div>
            </div>
            <div class="chat-header-actions">
                <button class="chat-action-btn" title="Gọi thoại">
                    <i class="fas fa-phone"></i>
